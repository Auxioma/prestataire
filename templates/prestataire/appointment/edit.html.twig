{% extends 'base.html.twig' %}

{% block title %}Modifier le rendez-vous
{% endblock %}

{% block body %}
	<div class="container py-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h1 class="h3 mb-1">Modifier le rendez-vous</h1>
				<p class="text-muted mb-0">
					Mettez à jour les informations de ce rendez-vous.
				</p>
			</div>

			<div class="d-flex gap-2">
				<a href="{{ path('app_prestataire_appointment_show', {id: appointment.id}) }}" class="btn btn-outline-secondary">
					Retour au détail
				</a>
				<a href="{{ path('app_prestataire_appointment_index') }}" class="btn btn-outline-secondary">
					Liste
				</a>
			</div>
		</div>

		{% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
			{% for message in messages %}
				<div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
					{{ message }}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
				</div>
			{% endfor %}
		{% endfor %}

		<div class="card shadow-sm">
			<div class="card-body">
				{{ form_start(form, {
    action: path('app_prestataire_appointment_edit', { id: appointment.id }),
    method: 'POST',
    attr: {
        'data-turbo': 'false',
        'data-controller': 'appointment-form'
    }
}) }}
				<div class="row g-3">
					<div class="col-12">
						{{ form_row(form.title) }}
					</div>

					<div class="col-12">
						{{ form_row(form.description) }}
					</div>

					<div class="col-md-6">
						{{ form_row(form.startsAt) }}
					</div>

					<div class="col-md-6">
						{{ form_row(form.endsAt) }}
					</div>

					<div class="col-md-6">
						{{ form_row(form.status) }}
					</div>

					<div class="col-md-6">
						{{ form_row(form.locationLabel) }}
					</div>

					<div class="col-12">
						{{ form_row(form.isAllDay) }}
					</div>
				</div>

				<div class="mt-4 d-flex gap-2">
					<button type="submit" class="btn btn-primary">
						Enregistrer les modifications
					</button>
					<a href="{{ path('app_prestataire_appointment_show', {id: appointment.id}) }}" class="btn btn-outline-secondary">
						Annuler
					</a>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
