{% extends 'base.html.twig' %}

{% block title %}Détail du rendez-vous{% endblock %}

{% block body %}
    <div class="tm-appointment-show-page">
        <div class="container py-4">
            <div class="tm-appointment-show-topbar">
                <div>
                    <a href="{{ path('app_prestataire_appointment_index') }}" class="tm-appointment-show-back">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Retour à la liste</span>
                    </a>
                </div>

                <div class="tm-appointment-show-topbar__actions">
                    <a href="{{ path('app_prestataire_dashboard', {'_fragment': 'calendrier-main-panel'}) }}" class="btn btn-outline-info" data-turbo="false">
                        Retour au calendrier
                    </a>
                </div>
            </div>

            <div class="tm-appointment-show-layout">
                <section class="tm-appointment-show-main">
                    <div class="tm-appointment-show-hero card shadow-sm">
                        <div class="card-body">
                            <div class="tm-appointment-show-hero__badge-wrap">
                                <span class="tm-appointment-status tm-appointment-status--{{ appointment.status.value }}">
                                    {{ appointment.status.getLabel() }}
                                </span>
                            </div>

                            <h1 class="tm-appointment-show-title">{{ appointment.title }}</h1>
                            <p class="tm-appointment-show-subtitle">
                                {{ appointment.description ?: 'Aucune note complémentaire n’a été ajoutée pour ce rendez-vous.' }}
                            </p>

                            <div class="tm-appointment-show-summary">
                                <article class="tm-appointment-show-summary__card">
                                    <span class="tm-appointment-show-summary__label">Début</span>
                                    <strong>{{ appointment.startsAt|date('d/m/Y', 'Europe/Paris') }}</strong>
                                    <span>{{ appointment.startsAt|date('H:i', 'Europe/Paris') }}</span>
                                </article>

                                <article class="tm-appointment-show-summary__card">
                                    <span class="tm-appointment-show-summary__label">Fin</span>
                                    <strong>{{ appointment.endsAt|date('d/m/Y', 'Europe/Paris') }}</strong>
                                    <span>{{ appointment.endsAt|date('H:i', 'Europe/Paris') }}</span>
                                </article>

                                <article class="tm-appointment-show-summary__card">
                                    <span class="tm-appointment-show-summary__label">Lieu</span>
                                    <strong>{{ appointment.locationLabel ?: 'Non renseigné' }}</strong>
                                </article>
                            </div>
                        </div>
                    </div>

                    <div class="tm-appointment-show-panel card shadow-sm">
                        <div class="card-body">
                            <h2>Informations détaillées</h2>

                            <div class="tm-appointment-show-details">
                                <div class="tm-appointment-show-detail">
                                    <span>Titre</span>
                                    <strong>{{ appointment.title }}</strong>
                                </div>

                                <div class="tm-appointment-show-detail">
                                    <span>Statut</span>
                                    <strong>{{ appointment.status.getLabel() }}</strong>
                                </div>

                                <div class="tm-appointment-show-detail">
                                    <span>Début</span>
                                    <strong>{{ appointment.startsAt|date('d/m/Y à H:i', 'Europe/Paris') }}</strong>
                                </div>

                                <div class="tm-appointment-show-detail">
                                    <span>Fin</span>
                                    <strong>{{ appointment.endsAt|date('d/m/Y à H:i', 'Europe/Paris') }}</strong>
                                </div>

                                <div class="tm-appointment-show-detail">
                                    <span>Lieu</span>
                                    <strong>{{ appointment.locationLabel ?: 'Non renseigné' }}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <aside class="tm-appointment-show-side">
                    <div class="tm-appointment-show-panel card shadow-sm">
                        <div class="card-body">
                            <h2>Suivi</h2>

                            <div class="tm-appointment-show-timeline">
                                <div class="tm-appointment-show-timeline__item">
                                    <span>Créé le</span>
                                    <strong>{{ appointment.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }}</strong>
                                </div>
                                <div class="tm-appointment-show-timeline__item">
                                    <span>Mis à jour le</span>
                                    <strong>{{ appointment.updatedAt|date('d/m/Y à H:i', 'Europe/Paris') }}</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tm-appointment-show-panel card shadow-sm">
                        <div class="card-body">
                            <h2>Actions rapides</h2>

                            <div class="tm-appointment-show-side__actions">
                                <a href="{{ path('app_prestataire_appointment_edit', { id: appointment.id }) }}" class="btn btn-primary">
                                    Modifier le rendez-vous
                                </a>

                                <form method="post" action="{{ path('app_prestataire_appointment_delete', { id: appointment.id }) }}" data-turbo="false" data-controller="confirm-dialog" data-action="submit->confirm-dialog#confirm" data-confirm-dialog-title-value="Supprimer ce rendez-vous ?" data-confirm-dialog-text-value="Cette suppression est définitive." data-confirm-dialog-confirm-button-text-value="Supprimer" data-confirm-dialog-cancel-button-text-value="Annuler">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_appointment_' ~ appointment.id) }}">
                                    <button type="submit" class="btn btn-danger w-100">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
{% endblock %}
