{% extends 'base.html.twig' %}

{% block title %}Détail du rendez-vous{% endblock %}

{% block body %}
    <div class="tm-appointment-show-page">
        <div class="container py-4">
            <div class="tm-appointment-show-page__header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
                <div>
                    <h1 class="h3 mb-1">{{ appointment.title }}</h1>
                    <p class="text-muted mb-0">
                        Détail du rendez-vous.
                    </p>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <a href="{{ path('app_prestataire_appointment_index') }}" class="btn btn-outline-secondary">
                        Retour à la liste
                    </a>
                    <a href="{{ path('app_prestataire_appointment_edit', { id: appointment.id }) }}" class="btn btn-primary">
                        Modifier
                    </a>
                </div>
            </div>

            <div class="tm-appointment-show-page__card card shadow-sm">
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Titre</dt>
                        <dd class="col-sm-9">{{ appointment.title }}</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">{{ appointment.description ?: '—' }}</dd>

                        <dt class="col-sm-3">Début</dt>
                        <dd class="col-sm-9">{{ appointment.startsAt|date('d/m/Y H:i') }}</dd>

                        <dt class="col-sm-3">Fin</dt>
                        <dd class="col-sm-9">{{ appointment.endsAt|date('d/m/Y H:i') }}</dd>

                        <dt class="col-sm-3">Toute la journée</dt>
                        <dd class="col-sm-9">{{ appointment.isAllDay ? 'Oui' : 'Non' }}</dd>

                        <dt class="col-sm-3">Statut</dt>
                        <dd class="col-sm-9">{{ appointment.status.getLabel() }}</dd>

                        <dt class="col-sm-3">Lieu</dt>
                        <dd class="col-sm-9">{{ appointment.locationLabel ?: '—' }}</dd>

                        <dt class="col-sm-3">Créé le</dt>
                        <dd class="col-sm-9">{{ appointment.createdAt|date('d/m/Y H:i') }}</dd>

                        <dt class="col-sm-3">Mis à jour le</dt>
                        <dd class="col-sm-9">{{ appointment.updatedAt|date('d/m/Y H:i') }}</dd>
                    </dl>
                </div>
            </div>

            <div class="tm-appointment-show-page__footer mt-4">
                <form method="post"
                      action="{{ path('app_prestataire_appointment_delete', { id: appointment.id }) }}"
                      onsubmit="return confirm('Confirmer la suppression de ce rendez-vous ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_appointment_' ~ appointment.id) }}">

                    <button type="submit" class="btn btn-danger">
                        Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}