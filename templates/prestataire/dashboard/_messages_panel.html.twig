{% set avatarClasses = ['avatar--safran', 'avatar--bleu', 'avatar--vert', 'avatar--violet', 'avatar--encre'] %}

<div class="tm-msg dash-card p-0 overflow-hidden">
    <div class="msg-layout tm-msg-layout">
        <aside class="msg-liste tm-msg-sidebar">
            <div class="msg-liste__entete tm-msg-sidebar-head">
                <div class="tm-msg-sidebar-kicker">Messagerie premium</div>
                <h4 class="tm-card-title mb-1">Toutes les conversations</h4>
                <p class="text-muted mb-0">
                    Retrouvez ici les échanges liés aux demandes de devis acceptées.
                </p>

                {% if conversations is not empty %}
                    <label class="filtres__recherche tm-msg-search" aria-label="Rechercher une conversation">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"/>
                            <path d="m21 21-4.3-4.3"/>
                        </svg>
                        <input type="search" placeholder="Rechercher une conversation…" aria-label="Rechercher une conversation">
                    </label>
                {% endif %}
            </div>

            {% if conversations is empty %}
                <div class="tm-msg-empty tm-msg-empty--sidebar">
                    <div class="tm-msg-empty-box">
                        Aucune conversation ouverte pour le moment.
                    </div>
                </div>
            {% else %}
                <div class="msg-liste__scroll tm-msg-list">
                    {% for conversation in conversations %}
                        {% set quoteRequest = conversation.quoteRequest %}
                        {% set lastMessage = conversation.messages|last %}
                        {% set isActive = activeConversation and activeConversation.id == conversation.id %}
                        {% set unreadCount = conversationUnreadCounts[conversation.id|default('')] ?? 0 %}
                        {% set clientFirstName = quoteRequest and quoteRequest.client and quoteRequest.client.account ? quoteRequest.client.account.firstName|default('') : '' %}
                        {% set clientLastName = quoteRequest and quoteRequest.client and quoteRequest.client.account ? quoteRequest.client.account.lastName|default('') : '' %}
                        {% set clientName = (clientFirstName ~ ' ' ~ clientLastName)|trim %}
                        {% set avatarSeed = clientName is not empty ? clientName : (quoteRequest ? quoteRequest.title : 'CL') %}
                        {% set avatarParts = avatarSeed|split(' ') %}
                        {% set avatarInitials = ((avatarParts[0]|default('C'))|slice(0, 1) ~ (avatarParts[1]|default('L'))|slice(0, 1))|upper %}
                        {% set avatarClass = avatarClasses[(conversation.id|default(loop.index0)) % avatarClasses|length] %}

                        <a
                            href="{{ path('app_prestataire_dashboard', { conversation: conversation.id, tab: 'messages', conversationPage: conversations.currentPageNumber is defined ? conversations.currentPageNumber : 1 }) }}"
                            class="conversation tm-msg-thread{% if isActive %} actif is-active{% endif %}{% if unreadCount > 0 %} non-lu is-unread{% endif %}"
                            data-action="click->messages-sidebar-live#markThreadRead"
                            data-conversation-id="{{ conversation.id }}"
                            data-unread-count="{{ unreadCount }}"
                        >
                            <span class="avatar {{ avatarClass }}">{{ avatarInitials ?: 'CL' }}</span>

                            <span class="conversation__corps tm-msg-thread-main">
                                <span class="conversation__haut">
                                    <b class="tm-msg-thread-client-name">{{ clientName is not empty ? clientName : 'Client non renseigné' }}</b>
                                    <span class="conversation__quand tm-msg-thread-date">
                                        {{ conversation.lastMessageAt ? conversation.lastMessageAt|date('d/m') : '—' }}
                                    </span>
                                </span>

                                <span class="conversation__sujet tm-msg-thread-title">
                                    {{ quoteRequest ? quoteRequest.title : 'Conversation sans demande liée' }}
                                </span>

                                <p class="conversation__apercu tm-msg-thread-preview">
                                    {% if lastMessage %}
                                        {% set preview = lastMessage.content ?? '' %}
                                        {% if preview is not empty %}
                                            {{ preview|length > 90 ? preview|slice(0, 90) ~ '…' : preview }}
                                        {% elseif lastMessage.attachments is defined and lastMessage.attachments is not empty %}
                                            {{ lastMessage.attachments|length }} photo{{ lastMessage.attachments|length > 1 ? 's' : '' }}
                                        {% else %}
                                            Nouveau message
                                        {% endif %}
                                    {% else %}
                                        Conversation ouverte, aucun message affichable pour le moment.
                                    {% endif %}
                                </p>
                            </span>

                            <span class="tm-msg-thread-side">
                                {% if quoteRequest %}
                                    <span class="tm-quote-badge tm-quote-badge--{{ quoteRequest.status.value|lower }}">
                                        {{ quoteRequest.status.value }}
                                    </span>
                                {% endif %}

                                {% if unreadCount > 0 %}
                                    <span
                                        class="conversation__pastille tm-msg-thread-unread"
                                        data-unread-badge
                                        aria-label="{{ unreadCount }} message{{ unreadCount > 1 ? 's' : '' }} non lu{{ unreadCount > 1 ? 's' : '' }}"
                                    >
                                        {{ unreadCount }}
                                    </span>
                                {% endif %}
                            </span>
                        </a>
                    {% endfor %}
                </div>

                {% if conversations.pageCount is defined and conversations.pageCount > 1 %}
                    <div class="p-3 border-top">
                        {{ knp_pagination_render(conversations) }}
                    </div>
                {% endif %}
            {% endif %}
        </aside>

        <div class="msg-fil tm-msg-main">
            {% if activeConversation %}
                {% set quoteRequest = activeConversation.quoteRequest %}
                {% set clientFirstName = quoteRequest and quoteRequest.client and quoteRequest.client.account ? quoteRequest.client.account.firstName|default('') : '' %}
                {% set clientLastName = quoteRequest and quoteRequest.client and quoteRequest.client.account ? quoteRequest.client.account.lastName|default('') : '' %}
                {% set clientName = (clientFirstName ~ ' ' ~ clientLastName)|trim %}
                {% set headerSeed = clientName is not empty ? clientName : (quoteRequest ? quoteRequest.title : 'CL') %}
                {% set headerParts = headerSeed|split(' ') %}
                {% set headerInitials = ((headerParts[0]|default('C'))|slice(0, 1) ~ (headerParts[1]|default('L'))|slice(0, 1))|upper %}
                {% set headerAvatarClass = avatarClasses[(activeConversation.id|default(0)) % avatarClasses|length] %}

                <div class="msg-fil__entete tm-msg-head">
                    <button class="btn-icone msg-fil__retour" type="button" aria-label="Retour aux conversations">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m15 6-6 6 6 6"/>
                        </svg>
                    </button>

                    <span class="avatar {{ headerAvatarClass }}">{{ headerInitials ?: 'CL' }}</span>

                    <div class="tm-msg-head-copy">
                        <div class="tm-msg-head-eyebrow">Conversation active</div>
                        <b>{{ clientName is not empty ? clientName : 'Client non renseigné' }}</b>
                        <span>
                            {{ quoteRequest ? quoteRequest.title : 'Conversation' }}
                            {% if quoteRequest %}
                                · <span class="en-ligne">{{ quoteRequest.status.value }}</span>
                            {% endif %}
                        </span>
                    </div>

                    <div class="msg-fil__actions tm-msg-head-actions">
                        {% if hasConversationPhotos %}
                            <a
                                href="{{ path('app_prestataire_conversation_photos', { id: activeConversation.id }) }}"
                                class="btn btn-outline-secondary tm-msg-head-btn"
                            >
                                Accès photos conversation
                            </a>
                        {% endif %}

                        {% if quoteRequest %}
                            <button
                                type="button"
                                class="btn btn-outline-primary tm-msg-head-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#quoteRequestDetailsModal"
                            >
                                Voir la demande
                            </button>

                            <a
                                href="{{ path('app_report_conversation', { id: activeConversation.id }) }}"
                                class="btn btn-outline-danger tm-msg-head-btn"
                            >
                                Signaler
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="msg-fil__scroll tm-msg-body" data-controller="image-lightbox">
                    {% if activeConversation.messages is empty %}
                        <div class="tm-msg-empty tm-msg-empty--body">
                            <div class="tm-msg-empty-box">
                                Aucun message dans cette conversation pour le moment.
                            </div>
                        </div>
                    {% else %}
                        <div class="tm-msg-stream">
                            {% set attachmentIndex = 0 %}
                            {% set currentDayKey = null %}

                            {% for message in activeConversation.messages %}
                                {% set isPrestataireAuthor = message.author and app.user and message.author.id == app.user.id %}
                                {% set isSystem = message.type and message.type.value == 'system' %}
                                {% set dayKey = message.createdAt ? message.createdAt|date('Y-m-d') : 'unknown' %}

                                {% if dayKey != currentDayKey %}
                                    <span class="msg-jour">
                                        {{ message.createdAt ? message.createdAt|date('d/m/Y') : 'Date inconnue' }}
                                    </span>
                                    {% set currentDayKey = dayKey %}
                                {% endif %}

                                <div class="tm-msg-row {% if isSystem %}is-system{% elseif isPrestataireAuthor %}is-own{% else %}is-other{% endif %}">
                                    {% if isSystem %}
                                        <div class="tm-msg-system">
                                            {{ message.content }}
                                        </div>
                                    {% else %}
                                        <div class="bulle {% if isPrestataireAuthor %}bulle--envoye{% else %}bulle--recu{% endif %} tm-msg-bubble">
                                            <div class="tm-msg-meta">
                                                {% if message.author %}
                                                    {{ message.author.prestataireProfile and message.author.prestataireProfile.companyName
                                                        ? message.author.prestataireProfile.companyName
                                                        : (message.author.firstName ~ ' ' ~ message.author.lastName) }}
                                                {% else %}
                                                    Système
                                                {% endif %}
                                            </div>

                                            {% if (message.content ?? '') is not empty %}
                                                <div class="bulle__contenu tm-msg-content">
                                                    {{ message.content|nl2br }}
                                                </div>
                                            {% endif %}

                                            {% if message.attachments is defined and message.attachments is not empty %}
                                                <div class="tm-msg-attachments">
                                                    {% for attachment in message.attachments %}
                                                        {% if attachment.fileName %}
                                                            <button
                                                                type="button"
                                                                class="tm-msg-attachment"
                                                                data-action="click->image-lightbox#open"
                                                                data-image-lightbox-target="trigger"
                                                                data-index="{{ attachmentIndex }}"
                                                                data-src="{{ asset('uploads/messages/' ~ attachment.fileName) }}"
                                                                data-alt="{{ attachment.originalName ?: 'Photo jointe' }}"
                                                                aria-label="Agrandir l’image {{ attachment.originalName ?: 'Photo jointe' }}"
                                                            >
                                                                <img
                                                                    src="{{ asset('uploads/messages/' ~ attachment.fileName) }}"
                                                                    alt="{{ attachment.originalName ?: 'Photo jointe' }}"
                                                                    loading="lazy"
                                                                >
                                                            </button>
                                                            {% set attachmentIndex = attachmentIndex + 1 %}
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            {% endif %}

                                            <span class="bulle__meta">
                                                {{ message.createdAt ? message.createdAt|date('H:i') : '—' }}
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>

                        <div class="tm-msg-lightbox" data-image-lightbox-target="modal" hidden>
                            <button
                                type="button"
                                class="tm-msg-lightbox-backdrop"
                                data-action="click->image-lightbox#close"
                                aria-label="Fermer la visionneuse"
                            ></button>

                            <div class="tm-msg-lightbox-dialog" role="dialog" aria-modal="true" aria-label="Aperçu image">
                                <button
                                    type="button"
                                    class="tm-msg-lightbox-close"
                                    data-action="click->image-lightbox#close"
                                    aria-label="Fermer"
                                >
                                    <i class="fa-solid fa-xmark"></i>
                                </button>

                                <button
                                    type="button"
                                    class="tm-msg-lightbox-nav tm-msg-lightbox-nav--prev"
                                    data-action="click->image-lightbox#previous"
                                    aria-label="Image précédente"
                                >
                                    <i class="fa-solid fa-chevron-left"></i>
                                </button>

                                <img
                                    src=""
                                    alt=""
                                    class="tm-msg-lightbox-image"
                                    data-image-lightbox-target="image"
                                >

                                <button
                                    type="button"
                                    class="tm-msg-lightbox-nav tm-msg-lightbox-nav--next"
                                    data-action="click->image-lightbox#next"
                                    aria-label="Image suivante"
                                >
                                    <i class="fa-solid fa-chevron-right"></i>
                                </button>

                                <div class="tm-msg-lightbox-counter" data-image-lightbox-target="counter"></div>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <div class="msg-composeur tm-msg-compose">
                    {% if messageForm %}
                        {{ form_start(messageForm, {
                            attr: {
                                class: 'tm-msg-form',
                                'data-controller': 'conversation-form',
                                'data-action': 'submit->conversation-form#submit'
                            }
                        }) }}

                        {% if messageForm.vars.errors|length > 0 %}
                            <div class="alert alert-danger">
                                {{ form_errors(messageForm) }}
                            </div>
                        {% endif %}

                        <div class="alert alert-danger d-none" data-conversation-form-target="error"></div>

                        <div class="tm-msg-compose-field tm-msg-compose-field--main">
                            <label class="btn-icone tm-msg-compose-attach" for="{{ messageForm.attachments.vars.id }}" aria-label="Joindre des photos">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m21 12-8.5 8.5a5 5 0 0 1-7-7L14 5a3.5 3.5 0 0 1 5 5l-8.5 8.5a2 2 0 0 1-3-3L16 7"/>
                                </svg>
                            </label>

                            {{ form_widget(messageForm.content, {
                                attr: {
                                    class: 'form-control tm-msg-textarea' ~ (messageForm.content.vars.errors|length > 0 ? ' is-invalid' : ''),
                                    rows: 1,
                                    placeholder: 'Écrivez votre message…'
                                }
                            }) }}

                            <button type="submit" class="btn-envoyer tm-msg-submit" data-conversation-form-target="submit" aria-label="Envoyer le message">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m22 2-7 20-4-9-9-4z"/>
                                    <path d="M22 2 11 13"/>
                                </svg>
                            </button>
                        </div>

                        <div class="tm-msg-compose-field tm-msg-compose-field--attachments">
                            {{ form_widget(messageForm.attachments, {
                                attr: {
                                    class: 'visually-hidden tm-msg-file-input' ~ (messageForm.attachments.vars.errors|length > 0 ? ' is-invalid' : ''),
                                    accept: 'image/jpeg,image/png,image/webp',
                                    multiple: 'multiple',
                                    'data-conversation-form-target': 'files',
                                    'data-action': 'change->conversation-form#filesChanged'
                                }
                            }) }}
                            <div class="form-text" data-conversation-form-target="summary">Jusqu’à 5 photos.</div>
                            <div class="tm-conversation-preview" data-conversation-form-target="preview" hidden></div>
                        </div>

                        {% if messageForm.content.vars.errors|length > 0 %}
                            <div class="invalid-feedback d-block tm-msg-error">
                                {{ form_errors(messageForm.content) }}
                            </div>
                        {% endif %}

                        {% if messageForm.attachments.vars.errors|length > 0 %}
                            <div class="invalid-feedback d-block tm-msg-error">
                                {{ form_errors(messageForm.attachments) }}
                            </div>
                        {% endif %}

                        {{ form_widget(messageForm._token) }}
                        {{ form_end(messageForm, { render_rest: false }) }}
                    {% elseif activeConversation and isConversationArchived is defined and isConversationArchived %}
                        <div class="alert alert-secondary mb-0" role="alert">
                            La messagerie est clôturée car cette demande a été archivée par votre interlocuteur.
                        </div>
                    {% elseif activeConversation and canUseInstantMessaging is defined and not canUseInstantMessaging %}
                        <div class="alert alert-warning mb-0" role="alert">
                            La messagerie instantanée n’est pas incluse dans votre formule actuelle. Passez à une formule d’abonnement supérieure pour envoyer de nouveaux messages. Vous pouvez toutefois consulter l’historique de cette conversation.
                        </div>
                    {% endif %}
                </div>

                {% if quoteRequest %}
                    <div class="modal fade" id="quoteRequestDetailsModal" tabindex="-1" aria-labelledby="quoteRequestDetailsModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="quoteRequestDetailsModalLabel">Détails de la demande</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                </div>

                                <div class="modal-body">
                                    <div class="mb-3">
                                        <h6 class="mb-1">{{ quoteRequest.title }}</h6>
                                        <div class="text-muted small">
                                            Reçue le
                                            {{ quoteRequest.createdAt ? quoteRequest.createdAt|date('d/m/Y à H:i') : '—' }}
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <strong>Client</strong><br>
                                            {% if quoteRequest.client and quoteRequest.client.account %}
                                                {{ quoteRequest.client.account.firstName }}
                                                {{ quoteRequest.client.account.lastName }}
                                            {% else %}
                                                Non renseigné
                                            {% endif %}
                                        </div>

                                        <div class="col-md-6">
                                            <strong>Statut</strong><br>
                                            <span class="tm-quote-badge tm-quote-badge--{{ quoteRequest.status.value|lower }}">
                                                {{ quoteRequest.status.value }}
                                            </span>
                                        </div>

                                        <div class="col-md-6">
                                            <strong>Date souhaitée</strong><br>
                                            {{ quoteRequest.desiredDate ? quoteRequest.desiredDate|date('d/m/Y') : 'Non précisée' }}
                                        </div>

                                        <div class="col-md-6">
                                            <strong>Budget</strong><br>
                                            {{ quoteRequest.budgetAmount ?: 'Non renseigné' }}
                                        </div>
                                    </div>

                                    <div>
                                        <strong>Description du besoin</strong>
                                        <div class="mt-2">
                                            {% if quoteRequest.description %}
                                                {{ quoteRequest.description|nl2br }}
                                            {% else %}
                                                Aucune description fournie.
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <a href="{{ path('app_prestataire_quote_request_show', { slug: quoteRequest.slug }) }}" class="btn btn-outline-secondary">
                                        Ouvrir la fiche demande
                                    </a>
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                                        Fermer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="tm-msg-empty tm-msg-empty--body tm-msg-empty--full">
                    <div class="tm-msg-empty-box">
                        Sélectionnez une conversation pour afficher les échanges.
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
