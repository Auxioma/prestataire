{% extends 'Website/base.html.twig' %}

{% block title %}
    {{ prestation.title ?: 'Prestation' }}
    - TrouveMoi
{% endblock %}

{% set companyName = prestation.prestataire.companyName ?: 'Prestataire' %}
{% set serviceName = prestation.service.name ?: 'Service' %}
{% set categoryName = prestation.service.category.name ?? null %}
{% set coverImage = prestation.prestataire.coverImage ?? null %}
{% set avatarLetter = companyName|slice(0, 1)|upper %}
{% set availabilities = prestation.prestataire.availabilities ?? [] %}
{% set prestationMedias = prestation.medias %}
{% set firstMedia = prestationMedias|length > 0 ? prestationMedias|first : null %}

{% block json_ld %}
    {% set prestationUrl = url('app_prestataire_service_prestation_show', {slug: prestation.slug}) %}
    {% set providerUrl = url('app_prestataire_show', {slug: prestation.prestataire.slug}) %}
    {% set providerData = {
        '@type': 'LocalBusiness',
        '@id': providerUrl ~ '#organization',
        name: companyName,
        url: providerUrl,
    } %}
    {% if prestation.prestataire.city or prestation.prestataire.postalCode %}
        {% set providerAddress = {'@type': 'PostalAddress'} %}
        {% if prestation.prestataire.city %}{% set providerAddress = providerAddress|merge({addressLocality: prestation.prestataire.city}) %}{% endif %}
        {% if prestation.prestataire.postalCode %}{% set providerAddress = providerAddress|merge({postalCode: prestation.prestataire.postalCode}) %}{% endif %}
        {% if prestation.prestataire.country %}{% set providerAddress = providerAddress|merge({addressCountry: prestation.prestataire.country}) %}{% endif %}
        {% set providerData = providerData|merge({address: providerAddress}) %}
    {% endif %}
    {% if coverImage %}
        {% set providerData = providerData|merge({image: absolute_url(asset('uploads/covers/' ~ coverImage))}) %}
    {% endif %}
    {% set openingHours = [] %}
    {% set schemaDays = {
        1: 'https://schema.org/Monday',
        2: 'https://schema.org/Tuesday',
        3: 'https://schema.org/Wednesday',
        4: 'https://schema.org/Thursday',
        5: 'https://schema.org/Friday',
        6: 'https://schema.org/Saturday',
        7: 'https://schema.org/Sunday',
    } %}
    {% if not prestation.prestataire.isOnVacation %}
        {% for availability in availabilities %}
            {% set schemaDay = schemaDays[availability.dayOfWeek]|default(null) %}
            {% if schemaDay and availability.morningEnabled and availability.morningStart and availability.morningEnd %}
                {% set openingHours = openingHours|merge([{
                    '@type': 'OpeningHoursSpecification',
                    dayOfWeek: schemaDay,
                    opens: availability.morningStart|date('H:i'),
                    closes: availability.morningEnd|date('H:i'),
                }]) %}
            {% endif %}
            {% if schemaDay and availability.afternoonEnabled and availability.afternoonStart and availability.afternoonEnd %}
                {% set openingHours = openingHours|merge([{
                    '@type': 'OpeningHoursSpecification',
                    dayOfWeek: schemaDay,
                    opens: availability.afternoonStart|date('H:i'),
                    closes: availability.afternoonEnd|date('H:i'),
                }]) %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {% if openingHours is not empty %}
        {% set providerData = providerData|merge({openingHoursSpecification: openingHours}) %}
    {% endif %}
    {% set serviceData = {
        '@type': 'Service',
        '@id': prestationUrl ~ '#service',
        name: prestation.title ?: serviceName,
        url: prestationUrl,
        serviceType: serviceName,
        provider: {'@id': providerUrl ~ '#organization'},
    } %}
    {% if prestation.shortDescription or prestation.description %}
        {% set serviceData = serviceData|merge({description: prestation.shortDescription ?: prestation.description}) %}
    {% endif %}
    {% if firstMedia and firstMedia.fileName %}
        {% set serviceData = serviceData|merge({image: absolute_url(asset('uploads/prestations/' ~ firstMedia.fileName))}) %}
    {% endif %}
    {{ include('Website/layout/_json_ld.html.twig', {data: {
        '@context': 'https://schema.org',
        '@graph': [
            serviceData,
            providerData,
            {
                '@type': 'BreadcrumbList',
                '@id': prestationUrl ~ '#breadcrumb',
                itemListElement: [
                    {'@type': 'ListItem', position: 1, name: 'Accueil', item: url('app_home')},
                    {'@type': 'ListItem', position: 2, name: 'Prestataires', item: url('app_prestataire_browse')},
                    {'@type': 'ListItem', position: 3, name: companyName, item: providerUrl},
                    {'@type': 'ListItem', position: 4, name: prestation.title ?: serviceName},
                ],
            },
        ],
    }}) }}
{% endblock %}

{% set pricingLabel = 'Tarification non renseignée' %}
{% if prestation.pricingType == 'quote' %}
    {% set pricingLabel = 'Tarif sur devis' %}
{% elseif prestation.pricingType == 'range' %}
    {% if prestation.priceFrom and prestation.priceTo %}
        {% set pricingLabel = 'De ' ~ prestation.priceFrom ~ ' € à ' ~ prestation.priceTo ~ ' €' ~ (prestation.priceUnit ? ' / ' ~ prestation.priceUnit : '') %}
    {% elseif prestation.priceFrom %}
        {% set pricingLabel = 'À partir de ' ~ prestation.priceFrom ~ ' €' ~ (prestation.priceUnit ? ' / ' ~ prestation.priceUnit : '') %}
    {% elseif prestation.priceTo %}
        {% set pricingLabel = 'Jusqu’à ' ~ prestation.priceTo ~ ' €' ~ (prestation.priceUnit ? ' / ' ~ prestation.priceUnit : '') %}
    {% endif %}
{% elseif prestation.pricingType == 'from' %}
    {% if prestation.priceFrom %}
        {% set pricingLabel = 'À partir de ' ~ prestation.priceFrom ~ ' €' ~ (prestation.priceUnit ? ' / ' ~ prestation.priceUnit : '') %}
    {% endif %}
{% elseif prestation.pricingType in ['fixed', 'hourly', 'daily'] %}
    {% if prestation.priceTo %}
        {% set pricingLabel = prestation.priceTo ~ ' €' ~ (prestation.priceUnit ? ' / ' ~ prestation.priceUnit : '') %}
    {% endif %}
{% endif %}

{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/prestataire/show_prestation.css') }}">{% endblock %}

{% block body %}
    <section class="tm-prestation-show">
        <div class="container tm-prestation-show__container">
            <div class="tm-prestation-show__back">
                <a href="{{ backUrl }}" class="tm-prestation-show__back-link">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Retour</span>
                </a>
            </div>

            <article class="tm-prestation-show__hero">
                <div class="tm-prestation-show__hero-media">
                    <img src="{{ coverImage ? asset('uploads/covers/' ~ coverImage) : asset('images/img_par_defaut.webp') }}" alt="{{ companyName }}" class="tm-prestation-show__hero-image" width="1200" height="896" loading="lazy" fetchpriority="high">
                    <div class="tm-prestation-show__hero-overlay"></div>
                </div>

                <div class="tm-prestation-show__hero-content">
                    <div class="tm-prestation-show__eyebrow-wrap">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="tm-prestation-show__eyebrow">Prestation proposée</span>

                            {% if categoryName %}
                                <span class="tm-prestation-show__chip">{{ categoryName }}</span>
                            {% endif %}
                        </div>

                        <button type="button" class="btn btn-light favorite-btn border-0 shadow-sm flex-shrink-0" data-controller="review--favorite-toggle" data-action="click->review--favorite-toggle#toggle" data-review--favorite-toggle-url-value="{{ path('app_favorite_toggle') }}" data-review--favorite-toggle-type-value="prestation" data-review--favorite-toggle-target-id-value="{{ prestation.id }}" data-review--favorite-toggle-csrf-token-value="{{ csrf_token('favorite_toggle') }}" data-review--favorite-toggle-is-favorite-value="{{ isFavoritePrestation ? 'true' : 'false' }}" data-review--favorite-toggle-login-url-value="{{ path('app_login') }}" aria-pressed="{{ isFavoritePrestation ? 'true' : 'false' }}" aria-label="{{ isFavoritePrestation ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">
                            <i data-review--favorite-toggle-target="icon" class="{{ isFavoritePrestation ? 'fa-solid text-danger' : 'fa-regular text-muted' }} fa-heart"></i>
                        </button>
                    </div>

                    <h1 class="tm-prestation-show__title">
                        {{ prestation.title ?: serviceName }}
                    </h1>

                    <p class="tm-prestation-show__subtitle">
                        {{ prestation.shortDescription ?: 'Une prestation claire, cadrée et adaptée à votre besoin.' }}
                    </p>

                    <div class="tm-prestation-show__provider">
                        <span class="tm-prestation-show__provider-avatar">{{ avatarLetter }}</span>

                        <div class="tm-prestation-show__provider-content">
                            <span class="tm-prestation-show__provider-label">Prestataire</span>
                            <a href="{{ path('app_prestataire_show', {slug: prestation.prestataire.slug}) }}" class="tm-prestation-show__provider-name">
                                {{ companyName }}
                            </a>
                        </div>
                    </div>

                    <div class="tm-prestation-show__hero-grid">
                        <div class="tm-prestation-show__hero-card">
                            <span class="tm-prestation-show__hero-card-label">Service</span>
                            <strong>{{ serviceName }}</strong>
                        </div>

                        <div class="tm-prestation-show__hero-card">
                            <span class="tm-prestation-show__hero-card-label">Tarification</span>
                            <strong>{{ pricingLabel }}</strong>
                        </div>
                    </div>
                </div>
            </article>

            <div class="tm-prestation-show__layout">
                <div class="tm-prestation-show__main">
                    <section class="tm-prestation-show__panel">
                        <div class="tm-prestation-show__panel-head">
                            <span class="tm-prestation-show__panel-kicker">Présentation</span>
                            <h2 class="tm-prestation-show__panel-title">Description de la prestation</h2>
                        </div>

                        <div class="tm-prestation-show__richtext">
                            {% if prestation.description %}
                                {{ prestation.description|nl2br }}
                            {% else %}
                                <p class="tm-prestation-show__empty">
                                    Le prestataire n’a pas encore ajouté de description détaillée.
                                </p>
                            {% endif %}
                        </div>
                    </section>

                    {% if prestationMedias|length > 0 %}
                        <section class="tm-prestation-show__panel" data-controller="core--image-lightbox">
                            <div class="tm-prestation-show__panel-head">
                                <span class="tm-prestation-show__panel-kicker">Photos</span>
                                <h2 class="tm-prestation-show__panel-title">Galerie de la prestation</h2>
                            </div>

                            <div class="tm-prestation-show__gallery">
                                {% set galleryIndex = 0 %}
                                {% for media in prestationMedias %}
                                    {% if media.fileName is defined and media.fileName %}
                                        <figure class="tm-prestation-show__gallery-item">
                                            <img src="{{ asset('uploads/prestations/' ~ media.fileName) }}" alt="{{ prestation.title ?: serviceName }}" class="tm-prestation-show__gallery-image" width="1200" height="900" loading="lazy" data-action="click->core--image-lightbox#open" data-core--image-lightbox-target="trigger" data-index="{{ galleryIndex }}" data-src="{{ asset('uploads/prestations/' ~ media.fileName) }}" data-alt="{{ prestation.title ?: serviceName }}">
                                        </figure>
                                        {% set galleryIndex = galleryIndex + 1 %}
                                    {% endif %}
                                {% endfor %}
                            </div>

                            <div class="tm-image-lightbox" data-core--image-lightbox-target="modal" hidden>
                                <button type="button" class="tm-image-lightbox__backdrop" data-action="click->core--image-lightbox#close" aria-label="Fermer"></button>

                                <div class="tm-image-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Galerie d’images">
                                    <button type="button" class="tm-image-lightbox__close" data-action="click->core--image-lightbox#close" aria-label="Fermer">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>

                                    <button type="button" class="tm-image-lightbox__nav tm-image-lightbox__nav--prev" data-action="click->core--image-lightbox#previous" aria-label="Image précédente">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </button>

                                    <img src="" alt="" class="tm-image-lightbox__image" width="1200" height="900" loading="lazy" data-core--image-lightbox-target="image">

                                    <button type="button" class="tm-image-lightbox__nav tm-image-lightbox__nav--next" data-action="click->core--image-lightbox#next" aria-label="Image suivante">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </button>

                                    <div class="tm-image-lightbox__counter" data-core--image-lightbox-target="counter"></div>
                                </div>
                            </div>
                        </section>
                    {% endif %}

                    <section class="tm-prestation-show__panel">
                        <div class="tm-prestation-show__panel-head">
                            <span class="tm-prestation-show__panel-kicker">Périmètre</span>
                            <h2 class="tm-prestation-show__panel-title">Zones d’intervention</h2>
                        </div>

                        {% set zones = prestation.prestataire.prestataireInterventionZones ?? [] %}
                        {% set mapZones = [] %}

                        {% for zone in zones %}
                            {% if zone.latitude and zone.longitude and zone.radiusKm %}
                                {% set mapZones = mapZones|merge([{
                                    latitude: zone.latitude,
                                    longitude: zone.longitude,
                                    radiusKm: zone.radiusKm,
                                }]) %}
                            {% endif %}
                        {% endfor %}

                        <div class="tm-prestation-show__zones">
                            <div class="tm-prestation-show__zones-list">
                                {% if zones|length > 0 %}
                                    {% for zone in zones %}
                                        <div class="tm-prestation-show__zone-item">
                                            <div class="tm-prestation-show__zone-icon">
                                                <i class="fa-solid fa-location-dot"></i>
                                            </div>

                                            <div class="tm-prestation-show__zone-content">
                                                <strong>{{ zone.city ? zone.city : 'Zone d’intervention' }}</strong>

                                                <span>
                                                    {% if zone.postalCode %}
                                                        {{ zone.postalCode }}
                                                    {% endif %}

                                                    {% if zone.radiusKm %}
                                                        {% if zone.postalCode %}
                                                            ·
                                                        {% endif %}
                                                        Rayon
                                                        {{ zone.radiusKm }}
                                                        km
                                                    {% endif %}

                                                    {% if not zone.postalCode and not zone.radiusKm %}
                                                        Zone configurée sur le profil
                                                    {% endif %}
                                                </span>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <p class="tm-prestation-show__empty mb-0">
                                        Aucune zone d’intervention renseignée pour le moment.
                                    </p>
                                {% endif %}
                            </div>

                            <div class="tm-prestation-show__map-card" data-controller="prestataire--zone-map" data-prestataire--zone-map-zones-value="{{ mapZones|json_encode|e('html_attr') }}">
                                <div class="tm-prestation-show__map-shell">
                                    {% if prestationMap is defined and prestationMap %}
                                        {{ ux_map(prestationMap, {
                                            style: 'height: 360px; width: 100%; border-radius: 18px;',
                                        }) }}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="tm-prestation-show__panel">
                        <div class="tm-prestation-show__panel-head">
                            <span class="tm-prestation-show__panel-kicker">Détails</span>
                            <h2 class="tm-prestation-show__panel-title">Informations complémentaires</h2>
                        </div>

                        {% if prestation.additionalInfo %}
                            <div class="tm-prestation-show__richtext tm-prestation-show__richtext--small">
                                {{ prestation.additionalInfo|nl2br }}
                            </div>
                        {% else %}
                            <p class="tm-prestation-show__empty mb-0">
                                Aucune information complémentaire renseignée.
                            </p>
                        {% endif %}
                    </section>
                </div>

                <aside class="tm-prestation-show__aside">
                    <section class="tm-prestation-show__panel tm-prestation-show__panel--sticky">
                        <div class="tm-prestation-show__price-box">
                            <span class="tm-prestation-show__price-label">Tarification</span>
                            <div class="tm-prestation-show__price-value">
                                {{ pricingLabel }}
                            </div>
                        </div>

                        <div class="tm-prestation-show__info-grid">
                            <div class="tm-prestation-show__info-item">
                                <span class="tm-prestation-show__info-label">Service</span>
                                <strong>{{ serviceName }}</strong>
                            </div>

                            <div class="tm-prestation-show__info-item">
                                <span class="tm-prestation-show__info-label">Prestataire</span>
                                <strong>{{ companyName }}</strong>
                            </div>

                            {% if prestation.priceUnit %}
                                <div class="tm-prestation-show__info-item">
                                    <span class="tm-prestation-show__info-label">Unité</span>
                                    <strong>{{ prestation.priceUnit }}</strong>
                                </div>
                            {% endif %}

                            {% if prestation.pricingType %}
                                <div class="tm-prestation-show__info-item">
                                    <span class="tm-prestation-show__info-label">Type de tarif</span>
                                    <strong>{{ prestation.pricingType }}</strong>
                                </div>
                            {% endif %}
                        </div>

                        {% if prestation.prestataire.isOnVacation or availabilities|length > 0 %}
                            <div class="tm-prestation-show__availability">
                                <div class="tm-prestation-show__availability-head">
                                    <h3 class="tm-prestation-show__availability-title">Disponibilités</h3>
                                    <span class="tm-prestation-show__availability-badge">{{ prestation.prestataire.isOnVacation ? 'Vacances' : 'Semaine' }}</span>
                                </div>

                                {% if prestation.prestataire.isOnVacation %}
                                    <div class="tm-prestation-show__availability-list">
                                        <div class="tm-prestation-show__availability-row">
                                            <div class="tm-prestation-show__availability-day">Statut</div>
                                            <div class="tm-prestation-show__availability-values">
                                                <span class="tm-prestation-show__availability-chip">
                                                    En vacances
                                                    {% if prestation.prestataire.vacationReturnDate %}
                                                        · retour le {{ prestation.prestataire.vacationReturnDate|date('d/m/Y') }}
                                                    {% endif %}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="tm-prestation-show__availability-list">
                                        {% for availability in availabilities %}
                                            {% set hasMorning = availability.morningEnabled and availability.morningStart and availability.morningEnd %}
                                            {% set hasAfternoon = availability.afternoonEnabled and availability.afternoonStart and availability.afternoonEnd %}

                                            <div class="tm-prestation-show__availability-row">
                                                <div class="tm-prestation-show__availability-day">
                                                    {{ availability.dayLabel ?? availability.dayName ?? ('Jour ' ~ loop.index) }}
                                                </div>

                                                <div class="tm-prestation-show__availability-values">
                                                    {% if hasMorning %}
                                                        <span class="tm-prestation-show__availability-chip">
                                                            {{ availability.morningStart|date('H:i') }}
                                                            -
                                                            {{ availability.morningEnd|date('H:i') }}
                                                        </span>
                                                    {% endif %}

                                                    {% if hasAfternoon %}
                                                        <span class="tm-prestation-show__availability-chip">
                                                            {{ availability.afternoonStart|date('H:i') }}
                                                            -
                                                            {{ availability.afternoonEnd|date('H:i') }}
                                                        </span>
                                                    {% endif %}

                                                    {% if not hasMorning and not hasAfternoon %}
                                                        <span class="tm-prestation-show__availability-chip tm-prestation-show__availability-chip--closed">
                                                            Fermé
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                        {% if app.user and is_granted('ROLE_CLIENT') %}
                            <a href="{{ path('app_quote_request_new', {slug: prestation.slug}) }}" class="tm-prestation-show__cta mb-3">
                                Demander un devis
                                <i class="fa-regular fa-paper-plane"></i>
                            </a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="tm-prestation-show__cta mb-3 text-center">
                                Connectez-vous pour demander un devis
                                <i class="fa-regular fa-paper-plane"></i>
                            </a>
                        {% endif %}
                        <a href="{{ path('app_prestataire_show', {slug: prestation.prestataire.slug}) }}" class="tm-prestation-show__cta">
                            Voir le profil du prestataire
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </section>
                </aside>
            </div>
        </div>
    </section>
{% endblock %}
