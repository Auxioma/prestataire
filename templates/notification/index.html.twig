{% extends 'base.html.twig' %}

{% block title %}Notifications - TrouveMoi
{% endblock %}

{% block body %}
	<div class="container py-4">
		<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
			<div>
				<h1 class="h3 mb-1">Notifications</h1>
				<p class="text-muted mb-0">
					{{ unreadCount }}
					non lue{{ unreadCount > 1 ? 's' : '' }}
				</p>
			</div>

			<div class="d-flex flex-wrap gap-2">
				{% if unreadCount > 0 %}
					<form method="post" action="{{ path('app_notification_mark_all_read') }}">
						<input type="hidden" name="_token" value="{{ csrf_token('mark-all-notifications-read') }}">
						<button type="submit" class="btn btn-primary">
							Tout marquer comme lu
						</button>
					</form>
				{% endif %}

				{% if notifications is not empty %}
					<form method="post" action="{{ path('app_notification_delete_all') }}" onsubmit="return confirm('Supprimer toutes les notifications ?');">
						<input type="hidden" name="_token" value="{{ csrf_token('delete-all-notifications') }}">
						<button type="submit" class="btn btn-outline-danger">
							Tout supprimer
						</button>
					</form>
				{% endif %}
			</div>
		</div>

		<div class="card shadow-sm border-0">
			<div class="list-group list-group-flush">
				{% for notification in notifications %}
					<div class="list-group-item py-3 {{ not notification.isRead ? 'bg-primary bg-opacity-10' : '' }}">
						<div class="d-flex justify-content-between align-items-start gap-3">
							<div class="grow">
								<div class="d-flex align-items-center gap-2 mb-1">
									<strong>{{ notification.title }}</strong>

									{% if not notification.isRead %}
										<span class="badge text-bg-primary">Nouveau</span>
									{% endif %}
								</div>

								<p class="mb-2 text-muted">{{ notification.body }}</p>

								<div class="small text-muted">
									{{ notification.createdAt|date('d/m/Y H:i') }}
								</div>
							</div>

							<div class="d-flex flex-column gap-2 align-items-end">
								{% if notification.targetUrl %}
									<a href="{{ notification.targetUrl }}" class="btn btn-sm btn-outline-secondary">
										Ouvrir
									</a>
								{% endif %}

								{% if not notification.isRead %}
									<form method="post" action="{{ path('app_notification_mark_read', {id: notification.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('mark-notification-read-' ~ notification.id) }}">
										<button type="submit" class="btn btn-sm btn-primary">
											Marquer comme lu
										</button>
									</form>
								{% endif %}

								<form method="post" action="{{ path('app_notification_delete', {id: notification.id}) }}" onsubmit="return confirm('Supprimer cette notification ?');">
									<input type="hidden" name="_token" value="{{ csrf_token('delete-notification-' ~ notification.id) }}">
									<button type="submit" class="btn btn-sm btn-outline-danger">
										Supprimer
									</button>
								</form>
							</div>
						</div>
					</div>
				{% else %}
					<div class="list-group-item py-5 text-center text-muted">
						Aucune notification pour le moment.
					</div>
				{% endfor %}

			</div>
		</div>
		{% if notifications is not empty %}
			<div class="mt-4 d-flex justify-content-center">
				{{ knp_pagination_render(notifications) }}
			</div>
		{% endif %}
	</div>
{% endblock %}
