<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr')|replace({_: '-'}) }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block meta_description %}Trouvez rapidement un prestataire ou un artisan vérifié près de chez vous avec TrouveMoi.{% endblock %}">
        {% set robotsRoute = app.request.attributes.get('_route') %}
        {% set indexableRoutes = [
            'app_home',
            'app_category_index',
            'app_category_show',
            'app_subcategory_services',
            'app_search_flow',
            'app_prestataire_show',
            'app_prestataire_service_prestation_show',
            'app_review_public_prestataire_reviews',
            'app_static_page',
            'app_bons_plans',
            'app_prestataire_browse',
        ] %}
        {% set robotsFilterKeys = app.request.query.all|keys|filter(key => key not in ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid']) %}
        {% set shouldIndex = robotsRoute in indexableRoutes and (robotsRoute not in ['app_category_index', 'app_search_flow'] or robotsFilterKeys is empty) %}
        <meta name="robots" content="{{ shouldIndex ? 'index,follow' : 'noindex,nofollow' }}">
        {% block canonical %}
            {% set canonicalRoute = app.request.attributes.get('_route') %}
            {% set canonicalRoutes = [
                'app_home',
                'app_category_index',
                'app_category_show',
                'app_subcategory_services',
                'app_search_flow',
                'app_prestataire_show',
                'app_prestataire_service_prestation_show',
                'app_review_public_prestataire_reviews',
                'app_static_page',
            ] %}
            {% set canonicalFilterKeys = app.request.query.all|keys|filter(key => key not in ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid']) %}
            {% if canonicalRoute in canonicalRoutes and (canonicalRoute not in ['app_category_index', 'app_search_flow'] or canonicalFilterKeys is empty) %}
                <link rel="canonical" href="{{ url(canonicalRoute, app.request.attributes.get('_route_params')|default({}))|e('html_attr') }}">
            {% endif %}
        {% endblock %}
        {% set organizationUrl = url('app_home') %}
        {% block json_ld %}{% endblock %}
        {% if app.request.attributes.get('_route') == 'app_static_page' %}
            {% set staticBreadcrumbNames = {
                about: 'À propos de nous',
                'aide-faq': 'Aide & FAQ',
                avantages: 'Avantages',
                cgu: "Conditions générales d'utilisation",
                'comment-ca-marche': 'Comment ça marche ?',
                'demander-un-devis': 'Demander un devis',
                help: "Besoin d'aide ?",
                'inscription-prestataire': 'Inscription prestataire',
                legal: 'Mentions légales',
                privacy: 'Politique de confidentialité',
                ressources: 'Ressources',
            } %}
            {% set staticBreadcrumbName = staticBreadcrumbNames[app.request.attributes.get('slug')]|default(null) %}
            {% if staticBreadcrumbName %}
                {{ include('Website/layout/_json_ld.html.twig', {data: {
                    '@context': 'https://schema.org',
                    '@type': 'BreadcrumbList',
                    itemListElement: [
                        {'@type': 'ListItem', position: 1, name: 'Accueil', item: organizationUrl},
                        {'@type': 'ListItem', position: 2, name: staticBreadcrumbName},
                    ],
                }}) }}
            {% endif %}
        {% endif %}
        <title>
            {% block title %}TrouveMoi - Trouver un prestataire
            {% endblock %}
        </title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
                {% if app.user %}
                    <script src="https://cdn.socket.io/4.8.3/socket.io.min.js" integrity="sha384-kzavj5fiMwLKzzD1f8S7TeoVIEi7uKHvbTA3ueZkrzYq75pNQUiUi6Dy98Q3fxb0" crossorigin="anonymous" defer></script>
                {% endif %}
        {% endblock %}
        {% block stylesheets %}{% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph" defer></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <a class="visually-hidden-focusable" href="#main-content">Aller au contenu principal</a>

        {% block nav %}
            {{ include('Website/layout/navbar.html.twig') }}
        {% endblock %}

        <main id="main-content">
            {% block body %}{% endblock %}
        </main>

        {% block footer %}
            {{ include('Website/layout/_footer.html.twig') }}
        {% endblock %}
    </body>
</html>
