{% extends 'Website/base.html.twig' %}

{% block title %}Ressources pour réussir - TrouveMoi.com{% endblock %}

{% block json_ld %}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/static/staticpage.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/static/ressources.css') }}">
{% endblock %}

{% block body %}
    <div class="bg-light py-3 border-bottom">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Accueil</a>
                    </li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Ressources</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container py-5" data-controller="website--resource-filter">
        <!-- Header principal -->
        <div class="text-center mb-5 tm-static-max-w-700 mx-auto">
            <h1 class="display-5 fw-bold tm-static-brand-title mb-2">
                <span class="text-primary">Ressources</span> pour réussir
            </h1>
            <p class="text-muted small">
                Conseils, guides et outils pour développer votre activité<br>
                et tirer le meilleur de TrouveMoi.com.
            </p>
        </div>

        <!-- Navigation par onglets -->
        <div class="d-flex justify-content-start justify-content-md-center overflow-auto pb-3 mb-5 border-bottom tm-static-text-nowrap scrolling-touch">
            <ul class="nav nav-pills gap-2 small fw-medium">
                <li class="nav-item"><button type="button" class="tm-static-resource-filter nav-link is-active rounded-3 px-3 py-2" data-website--resource-filter-target="filter" data-action="website--resource-filter#select" data-website--resource-filter-category-param="all" aria-controls="resource-grid" aria-pressed="true"><i class="fa-solid fa-table-cells-large me-2"></i>Tout</button></li>
                <li class="nav-item"><button type="button" class="tm-static-resource-filter nav-link rounded-3 px-3 py-2" data-website--resource-filter-target="filter" data-action="website--resource-filter#select" data-website--resource-filter-category-param="guides" aria-controls="resource-grid" aria-pressed="false"><i class="fa-regular fa-bookmark me-2"></i>Guides pratiques</button></li>
                <li class="nav-item"><button type="button" class="tm-static-resource-filter nav-link rounded-3 px-3 py-2" data-website--resource-filter-target="filter" data-action="website--resource-filter#select" data-website--resource-filter-category-param="activity" aria-controls="resource-grid" aria-pressed="false"><i class="fa-solid fa-chart-line me-2"></i>Développer son activité</button></li>
                <li class="nav-item"><button type="button" class="tm-static-resource-filter nav-link rounded-3 px-3 py-2" data-website--resource-filter-target="filter" data-action="website--resource-filter#select" data-website--resource-filter-category-param="tools" aria-controls="resource-grid" aria-pressed="false"><i class="fa-solid fa-screwdriver-wrench me-2"></i>Gestion et outils</button></li>
                <li class="nav-item"><button type="button" class="tm-static-resource-filter nav-link rounded-3 px-3 py-2" data-website--resource-filter-target="filter" data-action="website--resource-filter#select" data-website--resource-filter-category-param="news" aria-controls="resource-grid" aria-pressed="false"><i class="fa-regular fa-newspaper me-2"></i>Actualités</button></li>
                <li class="nav-item"><button type="button" class="tm-static-resource-filter nav-link rounded-3 px-3 py-2" data-website--resource-filter-target="filter" data-action="website--resource-filter#select" data-website--resource-filter-category-param="webinars" aria-controls="resource-grid" aria-pressed="false"><i class="fa-regular fa-circle-play me-2"></i>Webinaires</button></li>
                <li class="nav-item"><button type="button" class="tm-static-resource-filter nav-link rounded-3 px-3 py-2" data-website--resource-filter-target="filter" data-action="website--resource-filter#select" data-website--resource-filter-category-param="advice" aria-controls="resource-grid" aria-pressed="false"><i class="fa-regular fa-lightbulb me-2"></i>Conseils</button></li>
            </ul>
        </div>

        <p class="visually-hidden" aria-live="polite" data-website--resource-filter-target="status"></p>

        <!-- Grille des Ressources (4 colonnes de cartes) -->
        <div id="resource-grid" class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 mb-5">

            {# Carte 1 - Guide pratique #}
            <div class="col" data-website--resource-filter-target="item" data-resource-category="guides">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-column justify-content-between tm-static-hover-card">
                    <div>
                        <div class="tm-static-resource__icon bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center fs-4 mb-3">
                            <i class="fa-regular fa-file-lines"></i>
                        </div>
                        <span class="tm-static-resource__badge badge bg-primary-subtle text-primary fw-bold tracking-wider mb-2">Guide pratique</span>
                        <h2 class="h6 fw-bold text-dark lh-base mb-2">Bien créer son profil prestataire</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Nos conseils pour créer un profil attractif et rassurer vos futurs clients.</p>
                    </div>
                    <a href="{{ path('app_resource_show', {slug: 'creer-profil-prestataire'}) }}" class="text-decoration-none text-primary small fw-medium mt-4 d-inline-block tm-static-link-hover">
                        Lire le guide <i class="fa-solid fa-arrow-right ms-1 small"></i>
                    </a>
                </div>
            </div>

            {# Carte 2 - Développer son activité #}
            <div class="col" data-website--resource-filter-target="item" data-resource-category="activity">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-column justify-content-between tm-static-hover-card">
                    <div>
                        <div class="tm-static-resource__icon bg-success-subtle text-success rounded-3 d-flex align-items-center justify-content-center fs-4 mb-3">
                            <i class="fa-solid fa-bullseye"></i>
                        </div>
                        <span class="tm-static-resource__badge badge bg-success-subtle text-success fw-bold tracking-wider mb-2">Développer son activité</span>
                        <h2 class="h6 fw-bold text-dark lh-base mb-2">5 astuces pour recevoir plus de demandes</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Des conseils concrets pour augmenter votre visibilité et obtenir plus de clients.</p>
                    </div>
                    <a href="{{ path('app_resource_show', {slug: 'recevoir-plus-de-demandes'}) }}" class="text-decoration-none text-primary small fw-medium mt-4 d-inline-block tm-static-link-hover">
                        Lire l'article <i class="fa-solid fa-arrow-right ms-1 small"></i>
                    </a>
                </div>
            </div>

            {# Carte 3 - Gestion et outils #}
            <div class="col" data-website--resource-filter-target="item" data-resource-category="tools">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-column justify-content-between tm-static-hover-card">
                    <div>
                        <div class="tm-static-resource__icon tm-static-resource__icon--tools rounded-3 d-flex align-items-center justify-content-center fs-4 mb-3">
                            <i class="fa-regular fa-star"></i>
                        </div>
                        <span class="tm-static-resource__badge tm-static-resource__badge--tools badge fw-bold tracking-wider mb-2">Gestion et outils</span>
                        <h2 class="h6 fw-bold text-dark lh-base mb-2">Gérer vos devis comme un pro</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Modèles, bonnes pratiques et outils pour gagner du temps au quotidien.</p>
                    </div>
                    <a href="{{ path('app_resource_show', {slug: 'gerer-ses-devis'}) }}" class="text-decoration-none text-primary small fw-medium mt-4 d-inline-block tm-static-link-hover">
                        Lire le guide <i class="fa-solid fa-arrow-right ms-1 small"></i>
                    </a>
                </div>
            </div>

            {# Carte 4 - Guide pratique #}
            <div class="col" data-website--resource-filter-target="item" data-resource-category="guides">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-column justify-content-between tm-static-hover-card">
                    <div>
                        <div class="tm-static-resource__icon bg-warning-subtle text-warning rounded-3 d-flex align-items-center justify-content-center fs-4 mb-3">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <span class="tm-static-resource__badge badge bg-warning-subtle text-warning fw-bold tracking-wider mb-2">Guide pratique</span>
                        <h2 class="h6 fw-bold text-dark lh-base mb-2">Sécurité des paiements : nos engagements</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Tout savoir sur nos systèmes de paiement sécurisés et vos garanties.</p>
                    </div>
                    <a href="{{ path('app_resource_show', {slug: 'securite-des-paiements'}) }}" class="text-decoration-none text-primary small fw-medium mt-4 d-inline-block tm-static-link-hover">
                        En savoir plus <i class="fa-solid fa-arrow-right ms-1 small"></i>
                    </a>
                </div>
            </div>

            {# Carte 5 - Actualités #}
            <div class="col" data-website--resource-filter-target="item" data-resource-category="news">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-column justify-content-between tm-static-hover-card">
                    <div>
                        <div class="tm-static-resource__icon bg-danger-subtle text-danger rounded-3 d-flex align-items-center justify-content-center fs-4 mb-3">
                            <i class="fa-solid fa-bullhorn"></i>
                        </div>
                        <span class="tm-static-resource__badge badge bg-danger-subtle text-danger fw-bold tracking-wider mb-2">Actualités</span>
                        <h2 class="h6 fw-bold text-dark lh-base mb-2">Nouveautés TrouveMoi.com</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Découvrez les dernières fonctionnalités et améliorations de la plateforme.</p>
                    </div>
                    <a href="{{ path('app_resource_show', {slug: 'nouveautes-trouvemoi'}) }}" class="text-decoration-none text-primary small fw-medium mt-4 d-inline-block tm-static-link-hover">
                        Voir les nouveautés <i class="fa-solid fa-arrow-right ms-1 small"></i>
                    </a>
                </div>
            </div>

            {# Carte 6 - Webinaire #}
            <div class="col" data-website--resource-filter-target="item" data-resource-category="webinars">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-column justify-content-between tm-static-hover-card">
                    <div>
                        <div class="tm-static-resource__icon bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center fs-4 mb-3">
                            <i class="fa-regular fa-circle-play"></i>
                        </div>
                        <span class="tm-static-resource__badge badge bg-primary-subtle text-primary fw-bold tracking-wider mb-2">Webinaire</span>
                        <h2 class="h6 fw-bold text-dark lh-base mb-2">Webinaire : Développer son activité en ligne</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Replay de notre webinaire avec des experts pour booster votre activité.</p>
                    </div>
                    <a href="{{ path('app_resource_show', {slug: 'developper-activite-en-ligne'}) }}" class="text-decoration-none text-primary small fw-medium mt-4 d-inline-block tm-static-link-hover">
                        Voir le programme <i class="fa-solid fa-arrow-right ms-1 small"></i>
                    </a>
                </div>
            </div>

            {# Carte 7 - Outil #}
            <div class="col" data-website--resource-filter-target="item" data-resource-category="tools">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-column justify-content-between tm-static-hover-card">
                    <div>
                        <div class="tm-static-resource__icon bg-info-subtle text-info rounded-3 d-flex align-items-center justify-content-center fs-4 mb-3">
                            <i class="fa-solid fa-calculator"></i>
                        </div>
                        <span class="tm-static-resource__badge badge bg-info-subtle text-info fw-bold tracking-wider mb-2">Outil</span>
                        <h2 class="h6 fw-bold text-dark lh-base mb-2">Calculateur de tarifs et marges</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Un outil simple pour estimer vos tarifs et votre rentabilité.</p>
                    </div>
                    <a href="{{ path('app_resource_show', {slug: 'calculer-tarifs-et-marges'}) }}" class="text-decoration-none text-primary small fw-medium mt-4 d-inline-block tm-static-link-hover">
                        Voir la méthode <i class="fa-solid fa-arrow-right ms-1 small"></i>
                    </a>
                </div>
            </div>

            {# Carte 8 - Conseils #}
            <div class="col" data-website--resource-filter-target="item" data-resource-category="advice">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-column justify-content-between tm-static-hover-card">
                    <div>
                        <div class="tm-static-resource__icon tm-static-resource__icon--advice rounded-3 d-flex align-items-center justify-content-center fs-4 mb-3">
                            <i class="fa-regular fa-lightbulb"></i>
                        </div>
                        <span class="tm-static-resource__badge tm-static-resource__badge--advice badge fw-bold tracking-wider mb-2">Conseils</span>
                        <h2 class="h6 fw-bold text-dark lh-base mb-2">Bien communiquer avec vos clients</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Nos conseils pour instaurer une relation de confiance durable.</p>
                    </div>
                    <a href="{{ path('app_resource_show', {slug: 'communiquer-avec-ses-clients'}) }}" class="text-decoration-none text-primary small fw-medium mt-4 d-inline-block tm-static-link-hover">
                        Lire les conseils <i class="fa-solid fa-arrow-right ms-1 small"></i>
                    </a>
                </div>
            </div>

        </div>

        <!-- Bannière d'aide bas de page -->
        <div class="bg-light rounded-4 p-4 border d-flex flex-column flex-md-row align-items-center justify-content-between gap-4 mt-5">
            <div class="d-flex align-items-center gap-3">
                <div class="tm-static-resource__help-icon bg-white text-primary border rounded-circle d-flex align-items-center justify-content-center shadow-sm">
                    <i class="fa-solid fa-graduation-cap fs-5 text-primary"></i>
                </div>
                <div>
                    <h2 class="h6 fw-bold text-dark mb-1">Besoin d'aide ? Notre centre d'aide est là pour vous.</h2>
                    <p class="text-muted tm-static-text-xs mb-0">Retrouvez des réponses à vos questions et des tutoriels pas à pas.</p>
                </div>
            </div>
            <a href="{{ path('app_static_page', {slug: 'aide-faq'}) }}" class="btn btn-outline-primary tm-static-text-md-alt fw-medium px-4 bg-white text-primary tm-static-text-nowrap">Accéder à l'aide & FAQ</a>
        </div>
    </div>
{% endblock %}
