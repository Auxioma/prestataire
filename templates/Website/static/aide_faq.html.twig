{% extends 'Website/base.html.twig' %}

{% block title %}Aide & FAQ - TrouveMoi.com{% endblock %}

{% block json_ld %}
    {% set mainEntity = [] %}
    {% for category in faqCategories %}
        {% for faq in category.questions %}
            {% set mainEntity = mainEntity|merge([{
                '@type': 'Question',
                name: faq.question,
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: faq.answer,
                },
            }]) %}
        {% endfor %}
    {% endfor %}
    {{ include('Website/layout/_json_ld.html.twig', {data: {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': url('app_static_page', {slug: 'aide-faq'}) ~ '#webpage',
        mainEntity: mainEntity,
    }}) }}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/static/staticpage.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/static/aide_faq.css') }}">
{% endblock %}

{% block body %}
<div class="bg-light py-4 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Accueil</a></li>
                <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Aide & FAQ</li>
            </ol>
        </nav>
    </div>
</div>

<div
    class="container py-5"
    data-controller="website--faq"
    data-website--faq-initial-count-value="5"
    data-website--faq-increment-value="5"
>
    <div class="text-center mb-5 tm-static-max-w-700 mx-auto">
        <h1 class="display-5 fw-bold text-dark mb-2 tm-static-brand-title">Aide & FAQ</h1>
        <h2 class="h5 text-primary fw-medium mb-4">Trouvez rapidement des réponses à vos questions</h2>
        <p class="text-muted small">
            Parcourez nos questions fréquentes ou contactez-nous, notre équipe est là pour vous aider.
        </p>

        <div class="position-relative tm-static-max-w-600 mx-auto mt-4">
            <label for="faq-search" class="visually-hidden">Rechercher une question dans la FAQ</label>
            <input
                id="faq-search"
                type="search"
                class="form-control form-control-lg bg-white border shadow-sm fs-6 tm-static-input-round"
                placeholder="Rechercher une question, un sujet..."
                autocomplete="off"
                data-website--faq-target="search"
                data-action="input->website--faq#search"
            >
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <h2 class="h5 fw-bold text-dark mb-4">Questions fréquentes</h2>
            <p class="visually-hidden" aria-live="polite" data-website--faq-target="status"></p>

            <div class="accordion accordion-flush bg-white rounded-4 shadow-sm p-2 border tm-static-accordion" id="faqAccordion">
                {% for categoryKey, category in faqCategories %}
                    {% for questionIndex, faq in category.questions %}
                        {% set itemId = 'faq-' ~ categoryKey ~ '-' ~ questionIndex %}
                        <div
                            class="accordion-item border-bottom py-2 tm-static-faq-item"
                            data-website--faq-target="item"
                            data-faq-category="{{ categoryKey }}"
                            data-faq-search="{{ (faq.question ~ ' ' ~ faq.answer)|e('html_attr') }}"
                        >
                            <h3 class="accordion-header" id="{{ itemId }}-heading">
                                <button
                                    class="accordion-button collapsed fw-medium text-dark bg-white fs-6 shadow-none"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#{{ itemId }}-answer"
                                    aria-expanded="false"
                                    aria-controls="{{ itemId }}-answer"
                                >
                                    <i class="{{ category.icon }} text-primary me-3" aria-hidden="true"></i>
                                    {{ faq.question }}
                                </button>
                            </h3>
                            <div
                                id="{{ itemId }}-answer"
                                class="accordion-collapse collapse"
                                aria-labelledby="{{ itemId }}-heading"
                                data-bs-parent="#faqAccordion"
                            >
                                <div class="accordion-body text-muted small lh-lg ps-5">
                                    {{ faq.answer }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="tm-static-faq-empty" data-website--faq-target="empty" hidden>
                    Aucune question ne correspond à votre recherche.
                </div>
            </div>

            <div class="text-center mt-4 tm-static-faq-load-more" data-website--faq-target="loadMore">
                <button
                    class="btn btn-outline-primary btn-sm px-4 rounded-pill fw-medium shadow-none tm-static-text-xs"
                    type="button"
                    data-action="website--faq#showMore"
                >
                    <span data-website--faq-target="moreLabel">Voir plus de questions</span>
                    <i class="fa-solid fa-chevron-down ms-1 small" aria-hidden="true"></i>
                </button>
            </div>

            <div class="bg-light rounded-4 p-3 border mt-5 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted mb-0">
                    <i class="fa-regular fa-lightbulb text-warning me-2 fs-5" aria-hidden="true"></i>
                    <strong>Conseil :</strong> Consultez nos <strong>guides pratiques</strong> pour tirer le meilleur parti de TrouveMoi.com.
                </div>
                <a href="{{ path('app_static_page', {slug: 'ressources'}) }}" class="btn btn-white border bg-white text-dark btn-sm px-3 shadow-sm tm-static-text-nowrap tm-static-text-xs fw-medium">
                    Voir les guides
                </a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <h3 class="h6 fw-bold text-dark mb-3">Parcourir par catégorie</h3>
                <div class="small">
                    <button
                        type="button"
                        class="tm-static-faq-filter is-active d-flex justify-content-between align-items-center"
                        data-website--faq-target="filter"
                        data-action="website--faq#selectCategory"
                        data-website--faq-category-param="all"
                        aria-pressed="true"
                    >
                        <span><i class="fa-solid fa-list me-2 text-primary" aria-hidden="true"></i>Toutes les questions</span>
                        <span class="tm-static-faq-filter__count">{{ faqCategories|reduce((total, category) => total + category.questions|length, 0) }}</span>
                    </button>
                    {% for categoryKey, category in faqCategories %}
                        <button
                            type="button"
                            class="tm-static-faq-filter d-flex justify-content-between align-items-center"
                            data-website--faq-target="filter"
                            data-action="website--faq#selectCategory"
                            data-website--faq-category-param="{{ categoryKey }}"
                            aria-pressed="false"
                        >
                            <span><i class="{{ category.icon }} me-2 text-primary" aria-hidden="true"></i>{{ category.label }}</span>
                            <span class="tm-static-faq-filter__count">{{ category.questions|length }}</span>
                        </button>
                    {% endfor %}
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h3 class="h6 fw-bold text-dark mb-1">Vous ne trouvez pas votre réponse ?</h3>
                <p class="text-muted small mb-4">Notre équipe est là pour vous aider.</p>

                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="bg-light p-2 rounded-3 text-primary"><i class="fa-regular fa-comment-dots fs-5" aria-hidden="true"></i></div>
                    <div>
                        <h4 class="h6 fw-bold text-dark mb-0">Envoyez-nous un message</h4>
                        <a href="mailto:contact@trouvemoi.com" class="tm-static-text-xs text-muted d-block mb-1">contact@trouvemoi.com</a>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-4">
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
