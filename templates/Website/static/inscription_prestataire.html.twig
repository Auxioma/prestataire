{% extends 'Website/base.html.twig' %}

{% block title %}Inscription Prestataire - TrouveMoi.com{% endblock %}

{% block json_ld %}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/static/staticpage.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/static/inscription_prestataire.css') }}">
{% endblock %}

{% block body %}
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Accueil</a></li>
                <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Inscription prestataire</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-4">
            <div class="mb-5">
                <span class="text-primary fw-bold small text-uppercase tracking-wider">Rejoignez la communauté</span>
                <h1 class="fw-bold tm-static-brand-title h2 mt-2 mb-3">TrouveMoi <span class="text-primary">Prestataires</span></h1>
                <p class="text-muted small lh-base">Développez votre activité, trouvez de nouveaux clients et faites grandir votre business.</p>
            </div>

            <div class="d-flex flex-column gap-4 mb-5">
                <div class="d-flex gap-3">
                    <div class="tm-static-provider-registration__benefit-icon bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="fa-solid fa-users fs-5"></i>
                    </div>
                    <div>
                        <h2 class="h6 fw-bold text-dark mb-1">Plus de visibilité</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Présentez votre activité à des milliers de clients partout en France.</p>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="tm-static-provider-registration__benefit-icon bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="fa-regular fa-star fs-5"></i>
                    </div>
                    <div>
                        <h2 class="h6 fw-bold text-dark mb-1">Des demandes qualifiées</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Recevez des demandes de devis ciblées et augmentez vos chances de conversion.</p>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="tm-static-provider-registration__benefit-icon bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="fa-solid fa-shield-halved fs-5"></i>
                    </div>
                    <div>
                        <h2 class="h6 fw-bold text-dark mb-1">Paiements sécurisés</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Soyez payé en toute sécurité pour vos missions grâce à notre système de paiement sécurisé.</p>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="tm-static-provider-registration__benefit-icon bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="fa-solid fa-chart-simple fs-5"></i>
                    </div>
                    <div>
                        <h2 class="h6 fw-bold text-dark mb-1">Outils de gestion</h2>
                        <p class="text-muted tm-static-text-xs mb-0">Gérez vos prestations, devis, clients et avis depuis votre espace dédié.</p>
                    </div>
                </div>
            </div>

            <div class="card border border-light shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex gap-1 text-warning small mb-2">
                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
                <p class="text-muted fst-italic tm-static-text-xs mb-3">"Grâce à TrouveMoi.com, j'ai trouvé des clients réguliers et développé mon activité."</p>
                <div class="d-flex align-items-center gap-3">
                    <div class="tm-static-provider-registration__testimonial-avatar rounded-circle bg-secondary text-white fw-bold d-flex align-items-center justify-content-center"></div>
                    <div>
                        <h3 class="h6 fw-bold text-dark mb-0 tm-static-text-md-alt">Thomas D.</h3>
                        <span class="text-muted tm-static-text-xs">Plombier chauffagiste</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white border tm-static-form-disabled">

                <div class="text-center mb-5">
                    <h2 class="h4 fw-bold text-dark mb-1">Inscription prestataire</h2>
                    <p class="text-muted small">Créez votre compte professionnel en quelques étapes simples</p>
                </div>

                <div class="tm-static-provider-registration__steps position-relative mb-5 mx-auto">
                    <div class="tm-static-provider-registration__progress progress position-absolute top-50 start-0 translate-middle-y w-100">
                        <div class="tm-static-provider-registration__progress-value progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="tm-static-provider-registration__steps-list d-flex justify-content-between position-relative">
                        <div class="text-center">
                            <div class="tm-static-provider-registration__step-number rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center mx-auto mb-2 shadow-sm">1</div>
                            <span class="fw-medium text-primary tm-static-text-sm" aria-current="step">Informations</span>
                        </div>
                        <div class="text-center">
                            <div class="tm-static-provider-registration__step-number rounded-circle bg-light text-muted border fw-bold d-flex align-items-center justify-content-center mx-auto mb-2">2</div>
                            <span class="text-muted tm-static-text-sm">Activité</span>
                        </div>
                        <div class="text-center">
                            <div class="tm-static-provider-registration__step-number rounded-circle bg-light text-muted border fw-bold d-flex align-items-center justify-content-center mx-auto mb-2">3</div>
                            <span class="text-muted tm-static-text-sm">Documents</span>
                        </div>
                        <div class="text-center">
                            <div class="tm-static-provider-registration__step-number rounded-circle bg-light text-muted border fw-bold d-flex align-items-center justify-content-center mx-auto mb-2">4</div>
                            <span class="text-muted tm-static-text-sm">Validation</span>
                        </div>
                    </div>
                </div>

                <h3 class="h6 fw-bold text-dark mb-4 pb-2 border-bottom">Informations de connexion</h3>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="provider-first-name" class="form-label small fw-bold text-dark mb-1">Prénom <span class="text-danger">*</span></label>
                        <input id="provider-first-name" type="text" class="form-control form-control-sm py-2 bg-light border-0" placeholder="Votre prénom" autocomplete="given-name" disabled>
                    </div>
                    <div class="col-md-6">
                        <label for="provider-last-name" class="form-label small fw-bold text-dark mb-1">Nom <span class="text-danger">*</span></label>
                        <input id="provider-last-name" type="text" class="form-control form-control-sm py-2 bg-light border-0" placeholder="Votre nom" autocomplete="family-name" disabled>
                    </div>
                    <div class="col-md-6">
                        <label for="provider-email" class="form-label small fw-bold text-dark mb-1">E-mail <span class="text-danger">*</span></label>
                        <input id="provider-email" type="email" class="form-control form-control-sm py-2 bg-light border-0" placeholder="exemple@email.com" autocomplete="email" disabled>
                    </div>
                    <div class="col-md-6">
                        <label for="provider-phone" class="form-label small fw-bold text-dark mb-1">Téléphone <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0 text-muted" aria-hidden="true"><i class="fa-solid fa-phone me-1 small"></i> 🇫🇷</span>
                            <input id="provider-phone" type="tel" class="form-control py-2 bg-light border-0" placeholder="06 12 34 56 78" autocomplete="tel" disabled>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="provider-password" class="form-label small fw-bold text-dark mb-1">Mot de passe <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            <input id="provider-password" type="password" class="form-control form-control-sm py-2 bg-light border-0 pe-5" placeholder="Créez un mot de passe sécurisé" aria-describedby="provider-password-hint" autocomplete="new-password" disabled>
                            <i class="tm-static-provider-registration__password-icon fa-regular fa-eye position-absolute top-50 end-3 translate-middle-y text-muted" aria-hidden="true"></i>
                        </div>
                        <span id="provider-password-hint" class="tm-static-text-xs text-muted d-block mt-1">Au moins 8 caractères avec une majuscule, une minuscule et un chiffre.</span>
                    </div>
                    <div class="col-md-6">
                        <label for="provider-password-confirm" class="form-label small fw-bold text-dark mb-1">Confirmer le mot de passe <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            <input id="provider-password-confirm" type="password" class="form-control form-control-sm py-2 bg-light border-0 pe-5" placeholder="Confirmez votre mot de passe" autocomplete="new-password" disabled>
                            <i class="tm-static-provider-registration__password-icon fa-regular fa-eye position-absolute top-50 end-3 translate-middle-y text-muted" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>

                <div class="form-check mt-4">
                    <input class="form-check-input shadow-none" type="checkbox" id="termsCheck" disabled>
                    <label class="form-check-label tm-static-text-xs text-muted" for="termsCheck">
                        J'accepte les <a href="#" class="text-decoration-none text-primary">Conditions générales d'utilisation</a> et la <a href="#" class="text-decoration-none text-primary">Politique de confidentialité</a> <span class="text-danger">*</span>
                    </label>
                </div>

                <div class="bg-light rounded-3 p-3 mt-4 d-flex align-items-center gap-2 text-muted tm-static-text-xs">
                    <i class="fa-solid fa-shield-halved text-success fs-6"></i> Vos données sont sécurisées et confidentielles.
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button class="tm-static-provider-registration__submit btn btn-primary px-4 py-2 fw-medium d-flex align-items-center gap-2 rounded-3" type="button" disabled>
                        Continuer <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="text-center mt-4 border-top pt-3">
                    <span class="small text-muted">Vous avez déjà un compte prestataire ? <a href="#" class="text-decoration-none text-primary fw-medium">Connectez-vous</a></span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
