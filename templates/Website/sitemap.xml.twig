<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for url in urls %}
    <url>
        <loc>{{ url.location }}</loc>
{% if url.lastModifiedAt is defined %}
        <lastmod>{{ url.lastModifiedAt }}</lastmod>
{% endif %}
    </url>
{% endfor %}
</urlset>
