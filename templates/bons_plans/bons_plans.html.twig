  {% extends 'base.html.twig' %}

  {% block title %}Bons plans - TrouveMoi{% endblock %}

  {% block body %}
      {% set totalBonsPlans = bonsPlans.getTotalItemCount|default(bonsPlans|length) %}
      {% set activeCategoryLabel = 'Toutes les catégories' %}
      {% set activeSubCategoryLabel = 'Toutes les sous-catégories' %}

      {% if selectedCategorySlug %}
          {% for category in categories|default([]) %}
              {% if category.slug|default('') == selectedCategorySlug %}
                  {% set activeCategoryLabel = category.name|default('Toutes les catégories') %}
              {% endif %}
          {% endfor %}
      {% endif %}

      {% if selectedSubCategorySlug %}
          {% for subCategory in subCategories|default([]) %}
              {% if subCategory.slug|default('') == selectedSubCategorySlug %}
                  {% set activeSubCategoryLabel = subCategory.name|default('Toutes les sous-catégories') %}
              {% endif %}
          {% endfor %}
      {% endif %}

      <section class="hero-liste">
          <div
              class="fond"
              role="img"
              aria-label="Sélection de bons plans TrouveMoi"
              style="background-image:url('{{ asset('images/worker-menage.png')|e('html_attr') }}')"
          ></div>
          <div class="voile"></div>

          <div class="pastille-promo" aria-hidden="true">
              <svg class="etincelles" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-
  linecap="round">
                  <path d="M6 15 3 18M9 9 7 5M14 6l1-4"/>
              </svg>
              <div class="jusqua">Jusqu'à</div>
              <div class="pourcent">-{{ bonsPlans|default([]) is not empty ? (bonsPlans|first).tauxReduction|default(30)|number_format(0, ',',
  ' ') : '30' }}%</div>
              <div class="sur">sur vos prestations</div>
          </div>

          <div class="conteneur">
              <div class="hero-liste-inner">
                  <h1>Nos bons plans<br><span>au meilleur prix</span></h1>
                  <p>Profitez d'offres exclusives et de réductions sur une sélection de prestations de qualité.</p>

                  <div class="hero-atouts">
                      <div class="hero-atout">
                          <span class="rond">
                              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-
  linecap="round" stroke-linejoin="round">
                                  <path d="M20.6 13.4 11 3H4v7l9.6 10.4a2 2 0 0 0 2.8 0l4.2-4.2a2 2 0 0 0 0-2.8z"/>
                                  <circle cx="8" cy="8" r="1.2" fill="currentColor"/>
                              </svg>
                          </span>
                          Offres exclusives<br>négociées pour vous
                      </div>

                      <div class="hero-atout">
                          <span class="rond">
                              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-
  linecap="round" stroke-linejoin="round">
                                  <path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/>
                              </svg>
                          </span>
                          Prestataires vérifiés<br>et notés par nos clients
                      </div>

                      <div class="hero-atout">
                          <span class="rond">
                              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-
  linecap="round" stroke-linejoin="round">
                                  <path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/>
                                  <path d="m9 12 2 2 4-4"/>
                              </svg>
                          </span>
                          Économisez<br>en toute confiance
                      </div>
                  </div>
              </div>
          </div>
      </section>

      <section class="section resultats" style="padding-top:48px">
          <div class="conteneur">
              <div class="entete-section" style="margin-bottom:28px">
                  <div>
                      <span class="eyebrow">Bons plans du moment</span>
                      <h2 class="section-titre" style="font-size:clamp(24px,2.8vw,32px)">Des offres à durée limitée, ne les manquez pas !</h2>
                  </div>

                  <form method="get" action="{{ path('app_bons_plans') }}">
                      <label class="filtre" for="category">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-
  linecap="round">
                              <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                              <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                              <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                              <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                          </svg>

                          <select id="category" name="category" aria-label="Filtrer par catégorie" onchange="this.form.submit()">
                              <option value="">Toutes les catégories</option>
                              {% for category in categories|default([]) %}
                                  {% set categorySlug = category.slug|default('') %}
                                  <option value="{{ categorySlug }}" {{ selectedCategorySlug|default('') == categorySlug ? 'selected' : '' }}>
                                      {{ category.name|default('Catégorie') }}
                                  </option>
                              {% endfor %}
                          </select>

                          {% if selectedCategorySlug %}
                              <input type="hidden" name="subCategory" value="{{ selectedSubCategorySlug|default('') }}">
                          {% endif %}

                          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
  stroke-linecap="round" stroke-linejoin="round">
                              <path d="m6 9 6 6 6-6"/>
                          </svg>
                      </label>
                  </form>
              </div>

              <div class="bons-plans-layout">
                  <div>
                      {% if selectedCategorySlug %}
                          <form method="get" action="{{ path('app_bons_plans') }}" class="filtres-inner" style="padding:0 0 24px">
                              <label class="filtre" for="subCategory">
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-
  linecap="round">
                                      <path d="M4 7h16M4 12h16M4 17h16"/>
                                  </svg>

                                  <select
                                      id="subCategory"
                                      name="subCategory"
                                      aria-label="Filtrer par sous-catégorie"
                                      onchange="this.form.submit()"
                                      {{ subCategories|default([]) is empty ? 'disabled' : '' }}
                                  >
                                      <option value="">Toutes les sous-catégories</option>
                                      {% for subCategory in subCategories|default([]) %}
                                          {% set subCategorySlug = subCategory.slug|default('') %}
                                          <option value="{{ subCategorySlug }}" {{ selectedSubCategorySlug|default('') == subCategorySlug ?
  'selected' : '' }}>
                                              {{ subCategory.name|default('Sous-catégorie') }}
                                          </option>
                                      {% endfor %}
                                  </select>

                                  <input type="hidden" name="category" value="{{ selectedCategorySlug|default('') }}">

                                  <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-
  width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                      <path d="m6 9 6 6 6-6"/>
                                  </svg>
                              </label>

                              <a href="{{ path('app_bons_plans') }}" class="filtre" aria-label="Réinitialiser les filtres">
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-
  linecap="round" stroke-linejoin="round">
                                      <path d="M3 12a9 9 0 1 0 3-6.7"/>
                                      <path d="M3 3v6h6"/>
                                  </svg>
                                  Réinitialiser
                              </a>
                          </form>
                      {% endif %}

                      <div class="grille-deals">
                          {% for bonPlan in bonsPlans|default([]) %}
                              {% set service = bonPlan.service|default(null) %}
                              {% set prestataire = bonPlan.prestataire|default(null) %}
                              {% set account = prestataire and prestataire.account is defined ? prestataire.account : null %}
                              {% set category = service and service.category is defined ? service.category : null %}
                              {% set parentCategory = category and category.parent is defined ? category.parent : null %}

                              {% set reduction = bonPlan.tauxReduction|default(0) %}
                              {% set prixCatalogue = bonPlan.prixCatalogue|default(0) %}
                              {% set prixRemise = bonPlan.prixRemise is defined and bonPlan.prixRemise is not null
                                  ? bonPlan.prixRemise
                                  : (prixCatalogue - (prixCatalogue * reduction / 100))
                              %}

                              {% set prestationTitle = bonPlan.title is defined and bonPlan.title
                                  ? bonPlan.title
                                  : (service and service.name is defined and service.name ? service.name : 'Service non renseigné')
                              %}

                              {% set prestationSubtitle = bonPlan.shortDescription is defined and bonPlan.shortDescription
                                  ? bonPlan.shortDescription
                                  : (service and service.name is defined and service.name ? service.name : 'Prestation en promotion')
                              %}

                              {% set companyName = prestataire and prestataire.companyName is defined and prestataire.companyName
                                  ? prestataire.companyName
                                  : (
                                      account and account.firstName is defined and account.lastName is defined
                                      ? account.firstName ~ ' ' ~ account.lastName
                                      : 'Prestataire non renseigné'
                                  )
                              %}

                              {% set cityName = prestataire and prestataire.city is defined and prestataire.city
                                  ? prestataire.city
                                  : 'Ville non renseignée'
                              %}
                              {% set postalCode = prestataire and prestataire.postalCode is defined and prestataire.postalCode ?
  prestataire.postalCode : null %}
                              {% set averageRating = prestataire and prestataire.averageRating is defined and prestataire.averageRating ?
  prestataire.averageRating : null %}
                              {% set reviewsCount = prestataire and prestataire.reviewsCount is defined and prestataire.reviewsCount is not
  null ? prestataire.reviewsCount : 0 %}
                              {% set serviceIcon = service and service.icon is defined and service.icon ? service.icon : 'fa-tags' %}
                              {% set categoryLabel = category and category.name is defined and category.name ? category.name : 'Catégorie' %}
                              {% set prestataireSlug = prestataire and prestataire.slug is defined and prestataire.slug ? prestataire.slug :
  null %}
                              {% set isFavoriteBonPlan = bonPlan.id in (favoriteBonPlanIds|default([])) %}

                              {% set hasPublicPrestation = bonPlan.isActive
                                  and bonPlan.title is defined and bonPlan.title
                                  and (
                                      (bonPlan.shortDescription is defined and bonPlan.shortDescription)
                                      or (bonPlan.description is defined and bonPlan.description)
                                  )
                              %}

                              {% if hasPublicPrestation %}
                                  {% set cardUrl = path('app_prestataire_service_prestation_show', { slug: bonPlan.slug }) %}
                                  {% set cardAriaLabel = 'Voir l’offre ' ~ prestationTitle %}
                              {% elseif prestataireSlug %}
                                  {% set cardUrl = path('app_prestataire_show', { slug: prestataireSlug }) %}
                                  {% set cardAriaLabel = 'Voir le profil de ' ~ companyName %}
                              {% else %}
                                  {% set cardUrl = null %}
                                  {% set cardAriaLabel = '' %}
                              {% endif %}

                              {% if reduction >= 25 %}
                                  {% set iconColorClass = 'c-safran' %}
                              {% elseif category and category.slug is defined and category.slug matches '/informatique|cours|digit|web|dev/'
  %}
                                  {% set iconColorClass = 'c-violet' %}
                              {% elseif category and category.slug is defined and category.slug matches '/jardin|menage|nettoyage|nature/' %}
                                  {% set iconColorClass = 'c-vert' %}
                              {% else %}
                                  {% set iconColorClass = 'c-bleu' %}
                              {% endif %}

                              <article class="deal">
                                  <div class="visuel">
                                      {% if cardUrl %}
                                          <a href="{{ cardUrl }}" aria-label="{{ cardAriaLabel }}">
                                      {% endif %}

                                      {% if bonPlan.coverImage is defined and bonPlan.coverImage %}
                                          <img src="{{ asset('uploads/bons-plans/' ~ bonPlan.coverImage) }}" alt="{{ prestationTitle }}">
                                      {% elseif prestataire and prestataire.coverImage is defined and prestataire.coverImage %}
                                          <img src="{{ asset('uploads/covers/' ~ prestataire.coverImage) }}" alt="{{ prestationTitle }}">
                                      {% else %}
                                          <img src="{{ asset('images/img_par_defaut.png') }}" alt="{{ prestationTitle }}">
                                      {% endif %}

                                      {% if cardUrl %}
                                          </a>
                                      {% endif %}

                                      <span class="badge-remise">-{{ reduction|number_format(0, ',', ' ') }}%</span>

                                      <span class="timer">
                                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
  stroke-linecap="round" stroke-linejoin="round">
                                              <circle cx="12" cy="12" r="9"/>
                                              <path d="M12 7v5l3 3"/>
                                          </svg>
                                          {% if bonPlan.promotionCreatedAt is defined and bonPlan.promotionCreatedAt %}
                                              Depuis le {{ bonPlan.promotionCreatedAt|date('d/m') }}
                                          {% else %}
                                              Offre limitée
                                          {% endif %}
                                      </span>

                                      <button
                                          type="button"
                                          class="favori favorite-btn"
                                          data-controller="favorite-toggle"
                                          data-action="click->favorite-toggle#toggle"
                                          data-favorite-toggle-url-value="{{ path('app_favorite_toggle') }}"
                                          data-favorite-toggle-type-value="bon_plan"
                                          data-favorite-toggle-target-id-value="{{ bonPlan.id }}"
                                          data-favorite-toggle-csrf-token-value="{{ csrf_token('favorite_toggle') }}"
                                          data-favorite-toggle-is-favorite-value="{{ isFavoriteBonPlan ? 'true' : 'false' }}"
                                          data-favorite-toggle-login-url-value="{{ path('app_login') }}"
                                          aria-pressed="{{ isFavoriteBonPlan ? 'true' : 'false' }}"
                                          aria-label="{{ isFavoriteBonPlan ? 'Retirer ' ~ prestationTitle ~ ' des favoris' : 'Ajouter ' ~ prestationTitle ~ ' aux favoris' }}"
                                      >
                                          <i
                                              data-favorite-toggle-target="icon"
                                              class="{{ isFavoriteBonPlan ? 'fa-solid text-danger' : 'fa-regular text-muted' }} fa-heart"
                                              aria-hidden="true"
                                          ></i>
                                      </button>

                                      <span class="icone-cat {{ iconColorClass }}" aria-hidden="true">
                                          <i class="fa-solid {{ serviceIcon }}"></i>
                                      </span>
                                  </div>

                                  <div class="corps">
                                      {% if cardUrl %}
                                          <h3><a href="{{ cardUrl }}" class="text-reset">{{ companyName }}</a></h3>
                                      {% else %}
                                          <h3>{{ companyName }}</h3>
                                      {% endif %}

                                      <p class="metier">{{ prestationTitle }}</p>

                                      <p class="prix">
                                          <s>{{ prixCatalogue|number_format(2, ',', ' ') }} €</s>
                                          <strong>{{ prixRemise|number_format(2, ',', ' ') }} €</strong>
                                      </p>

                                      <p class="ligne lieu">
                                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
  stroke-linecap="round" stroke-linejoin="round">
                                              <path d="M12 21c4.5-4 7-7.6 7-11a7 7 0 1 0-14 0c0 3.4 2.5 7 7 11z"/>
                                              <circle cx="12" cy="10" r="2.6"/>
                                          </svg>
                                          {{ cityName }}{% if postalCode %} ({{ postalCode }}){% endif %}
                                      </p>

                                      {% if averageRating %}
                                          <p class="ligne note">
                                              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                                  <path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/>
                                              </svg>
                                              {{ averageRating|replace({'.': ','}) }}
                                              <span>({{ reviewsCount }} avis)</span>
                                          </p>
                                      {% else %}
                                          <p class="ligne note">
                                              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                                  <path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/>
                                              </svg>
                                              Nouveau
                                              <span>{{ categoryLabel }}</span>
                                          </p>
                                      {% endif %}
                                  </div>
                              </article>
                          {% else %}
                              <div class="tm-bonsplans-empty">
                                  <div class="tm-bonsplans-empty__icon">🏷️</div>
                                  <h3 class="tm-bonsplans-empty__title">Aucun bon plan trouvé</h3>
                                  <p class="tm-bonsplans-empty__text">
                                      Aucun bon plan ne correspond à votre sélection actuelle. Essayez une autre catégorie ou réinitialisez
  les filtres.
                                  </p>
                                  <a href="{{ path('app_bons_plans') }}" class="tm-bonsplans-empty__cta">Voir toutes les offres</a>
                              </div>
                          {% endfor %}
                      </div>

                      {% if bonsPlans|default([]) is not empty %}
                          <div class="tm-bonsplans-pagination">
                              {{ knp_pagination_render(bonsPlans) }}
                          </div>
                      {% endif %}
                  </div>

                  <aside class="encart-notif">
                      <div class="cloche" aria-hidden="true">
                          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-
  linecap="round" stroke-linejoin="round">
                              <path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                              <path d="M10.3 21a2 2 0 0 0 3.4 0"/>
                          </svg>
                      </div>

                      <h3>Ne ratez pas les prochaines offres</h3>
                      <p>Affinez votre recherche, consultez régulièrement cette page et profitez des promotions publiées par les prestataires
  actifs.</p>

                      <a href="{{ path('app_bons_plans') }}" class="btn btn-bleu">Voir tous les bons plans</a>

                      <ul>
                          <li>
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-
  linecap="round" stroke-linejoin="round">
                                  <path d="m5 12 5 5L20 7"/>
                              </svg>
                              {{ totalBonsPlans }} offre{{ totalBonsPlans > 1 ? 's' : '' }} disponible{{ totalBonsPlans > 1 ? 's' : '' }}
                          </li>
                          <li>
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-
                              </svg>
                              Catégorie : {{ activeCategoryLabel }}
                          </li>
                          <li>
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-
  linecap="round" stroke-linejoin="round">
                                  <path d="m5 12 5 5L20 7"/>
                  </aside>
              </div>
          </div>
      </section>
  {% endblock %}
