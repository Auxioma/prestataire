{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-5">
    {# Header #}
    <div class="row tm-plan-header mb-5 rounded-4">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="fw-bold">Nos bons plans au meilleur prix</h1>
            <p class="opacity-75">Profitez d'offres exclusives et de réductions sur une sélection de prestations.</p>
        </div>
    </div>

    {# Grille des offres #}
    <div class="row g-4">
        {% for plan in bons_plans %}
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card tm-plan-card h-100 shadow-sm">
                <div class="position-relative">
                    <span class="tm-plan-badge">-{{ plan.discount }}</span>
                    <img src="{{ asset('images/placeholder.jpg') }}" class="card-img-top" alt="{{ plan.title }}">
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">{{ plan.title }}</h5>
                    <p class="text-muted small mb-2">{{ plan.desc }}</p>
                    
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <span class="tm-plan-price-old">{{ plan.old_price }} €</span>
                        <span class="tm-plan-price-new">{{ plan.price }} €</span>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}