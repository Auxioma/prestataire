{% extends 'base.html.twig' %}

{% block title %}Devis
{% endblock %}

{% block body %}
	<div class="quote-show-page">
		<div class="container quote-show-container">
			<section class="quote-show-topbar">
				<div class="quote-show-topbar__main">
					<span class="quote-show-topbar__eyebrow">Aperçu client</span>
					<h1 class="quote-show-topbar__title">Devis</h1>
					<p class="quote-show-topbar__text">
						Vérifiez la clarté du document avant son envoi au client.
					</p>

					<div class="quote-show-topbar__meta">
						<div class="quote-show-meta-card">
							<span class="quote-show-meta-card__label">Numéro</span>
							<strong class="quote-show-meta-card__value">{{ proposal.proposalNumber ?: 'Brouillon de devis' }}</strong>
						</div>

						<div class="quote-show-meta-card">
							<span class="quote-show-meta-card__label">Référence interne</span>
							<strong class="quote-show-meta-card__value">{{ proposal.publicReference ?: '—' }}</strong>
						</div>

						<div class="quote-show-meta-card">
							<span class="quote-show-meta-card__label">Créé le</span>
							<strong class="quote-show-meta-card__value">{{ proposal.createdAt ? proposal.createdAt|date('d/m/Y à H:i') : '—' }}</strong>
						</div>

						<div class="quote-show-meta-card">
							<span class="quote-show-meta-card__label">Valable jusqu’au</span>
							<strong class="quote-show-meta-card__value">{{ proposal.validUntil ? proposal.validUntil|date('d/m/Y') : '—' }}</strong>
						</div>
					</div>
				</div>

				<div class="quote-show-topbar__actions">
					<a href="{{ path('app_prestataire_quote_proposal_edit', { publicReference: proposal.publicReference }) }}" class="quote-btn quote-btn--primary">
						Modifier le Devis
					</a>

					<a href="{{ path('app_prestataire_quote_request_show', { slug: proposal.quoteRequest.slug }) }}" class="quote-btn quote-btn--secondary">
						Retour à la demande
					</a>

					{% if not proposal.isFinalized %}
						<form method="post" action="{{ path('app_prestataire_quote_proposal_finalize', { publicReference: proposal.publicReference }) }}" onsubmit="return confirm('Finaliser ce devis et le rendre visible au client ?');">
							<input type="hidden" name="_token" value="{{ csrf_token('finalize-quote-proposal-' ~ proposal.id) }}">
							<button type="submit" class="quote-btn quote-btn--success">
								Finaliser
							</button>
						</form>
					{% endif %}

					<a href="{{ path('app_prestataire_quote_proposal_pdf', { publicReference: proposal.publicReference }) }}" class="quote-btn quote-btn--tertiary" target="_blank" rel="noopener">
						Voir la version PDF
					</a>

					<form method="post" action="{{ path('app_prestataire_quote_proposal_delete', { publicReference: proposal.publicReference }) }}" onsubmit="return confirm('Supprimer définitivement ce devis ? Il ne sera plus visible par le client, mais vous pourrez créer un nouveau devis pour cette demande.');">
						<input type="hidden" name="_token" value="{{ csrf_token('delete_quote_proposal_' ~ proposal.id) }}">
						<button type="submit" class="quote-btn quote-btn--danger">
							Supprimer définitivement
						</button>
					</form>
				</div>
			</section>

			{% if proposal.isFinalized %}
				<div class="quote-show-alert quote-show-alert--success">
					<span class="quote-show-alert__dot"></span>
					<div>
						<strong>Devis publié.</strong>
						Le client peut désormais le consulter.
					</div>
				</div>
			{% else %}
				<div class="quote-show-alert quote-show-alert--info">
					<span class="quote-show-alert__dot"></span>
					<div>
						<strong>Brouillon prêt à relire.</strong>
						Vérifiez la clarté de la proposition avant de la finaliser.
					</div>
				</div>
			{% endif %}

			<div class="quote-show-layout">
				<div class="quote-show-main">
					<div class="quote-panel quote-panel--document">
						<div class="quote-document-header">
							<div>
								<span class="quote-panel__eyebrow">Document commercial</span>
								<h2 class="quote-document-header__title">{{ proposal.title ?: 'Sans titre' }}</h2>
								<p class="quote-document-header__status">Statut :
									{{ proposal.status.label }}</p>
							</div>

							<div class="quote-document-badge">
								<span class="quote-document-badge__label">Référence devis</span>
								<strong class="quote-document-badge__value">{{ proposal.proposalNumber ?: '—' }}</strong>
							</div>
						</div>

						{% if proposal.introMessage %}
							<div class="quote-rich-block quote-rich-block--intro">{{ proposal.introMessage|nl2br }}</div>
						{% endif %}

						<div class="quote-lines-table-wrap">
							<table class="quote-lines-table">
								<thead>
									<tr>
										<th>Prestations</th>
										<th class="text-end">Qté</th>
										<th class="text-end">PU HT</th>
										<th class="text-end">TVA</th>
										<th class="text-end">Total HT</th>
									</tr>
								</thead>
								<tbody>
									{% for item in proposal.items %}
										<tr>
											<td>
												<div class="quote-line-title">{{ item.label }}</div>
												{% if item.description %}
													<div class="quote-line-description">{{ item.description }}</div>
												{% endif %}
											</td>
											<td class="text-end">{{ item.quantity }}</td>
											<td class="text-end">{{ item.unitPriceHt|number_format(2, ',', ' ') }}
												€</td>
											<td class="text-end">{{ item.vatRate|number_format(2, ',', ' ') }}
												%</td>
											<td class="text-end quote-line-total">{{ item.totalHt|number_format(2, ',', ' ') }}
												€</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="5">
												<div class="quote-empty-state quote-empty-state--compact">
													<div class="quote-empty-state__icon">+</div>
													<h4 class="quote-empty-state__title">Aucune ligne ajoutée</h4>
													<p class="quote-empty-state__text">Ajoutez des prestations depuis la page d’édition pour visualiser ici le rendu final.</p>
												</div>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>

						{% if proposal.terms %}
							<section class="quote-rich-section">
								<h3 class="quote-rich-section__title">Conditions</h3>
								<div class="quote-rich-block">{{ proposal.terms|nl2br }}</div>
							</section>
						{% endif %}

						{% if proposal.notes %}
							<section class="quote-rich-section">
								<h3 class="quote-rich-section__title">Notes</h3>
								<div class="quote-rich-block">{{ proposal.notes|nl2br }}</div>
							</section>
						{% endif %}
					</div>
				</div>

				<aside class="quote-show-sidebar">
					<div class="quote-panel quote-panel--side">
						<div class="quote-panel__header">
							<span class="quote-panel__eyebrow">Synthèse</span>
							<h2 class="quote-panel__title">Totaux</h2>
						</div>

						<div class="quote-totals">
							<div class="quote-total-row">
								<span>HT</span>
								<strong>{{ proposal.subtotalHt|number_format(2, ',', ' ') }}
									€</strong>
							</div>

							<div class="quote-total-row">
								<span>TVA</span>
								<strong>{{ proposal.taxAmount|number_format(2, ',', ' ') }}
									€</strong>
							</div>

							<div class="quote-total-row quote-total-row--highlight">
								<span>Total TTC</span>
								<strong>{{ proposal.totalTtc|number_format(2, ',', ' ') }}
									€</strong>
							</div>
						</div>
					</div>

					<div class="quote-panel quote-panel--side">
						<div class="quote-panel__header">
							<span class="quote-panel__eyebrow">Prestataire</span>
							<h2 class="quote-panel__title">Émetteur du devis</h2>
						</div>

						<div class="quote-contact-card">
							<strong class="quote-contact-card__name">
								{{ proposal.prestataireCompanyName ?: proposal.prestataireLegalName ?: '—' }}
							</strong>

							{% if proposal.prestataireLegalName and proposal.prestataireLegalName != proposal.prestataireCompanyName %}
								<div class="quote-contact-card__line">{{ proposal.prestataireLegalName }}</div>
							{% endif %}

							{% if proposal.prestataireAddress %}
								<div class="quote-contact-card__line">{{ proposal.prestataireAddress }}</div>
							{% endif %}

							{% if proposal.prestataireAddressComplement %}
								<div class="quote-contact-card__line">{{ proposal.prestataireAddressComplement }}</div>
							{% endif %}

							{% if proposal.prestatairePostalCode or proposal.prestataireCity %}
								<div class="quote-contact-card__line">
									{{ proposal.prestatairePostalCode ?: '—' }}
									{{ proposal.prestataireCity ?: '' }}
								</div>
							{% endif %}

							{% if proposal.prestataireCountry %}
								<div class="quote-contact-card__line">{{ proposal.prestataireCountry }}</div>
							{% endif %}

							{% if proposal.prestatairePhone %}
								<div class="quote-contact-card__line">{{ proposal.prestatairePhone }}</div>
							{% endif %}

							{% if proposal.prestataireEmail %}
								<div class="quote-contact-card__line">{{ proposal.prestataireEmail }}</div>
							{% endif %}

							{% if not proposal.prestataireLegalName
        and not proposal.prestataireAddress
        and not proposal.prestataireAddressComplement
        and not proposal.prestatairePostalCode
        and not proposal.prestataireCity
        and not proposal.prestataireCountry
        and not proposal.prestatairePhone
        and not proposal.prestataireEmail %}
								<div class="quote-contact-card__line">—</div>
							{% endif %}
						</div>
					</div>

					<div class="quote-panel quote-panel--side">
						<div class="quote-panel__header">
							<span class="quote-panel__eyebrow">Client</span>
							<h2 class="quote-panel__title">Destinataire</h2>
						</div>

						<div class="quote-contact-card">
							<strong class="quote-contact-card__name">{{ proposal.clientFullName ?: proposal.clientCompanyName ?: '—' }}</strong>
							<div class="quote-contact-card__line">{{ proposal.clientCompanyName ?: '—' }}</div>
							<div class="quote-contact-card__line">{{ proposal.clientBillingAddress ?: proposal.clientInterventionAddress ?: '—' }}</div>
							<div class="quote-contact-card__line">{{ proposal.clientBillingPostalCode ?: proposal.clientInterventionPostalCode ?: '—' }}
								{{ proposal.clientBillingCity ?: proposal.clientInterventionCity ?: '' }}</div>
							<div class="quote-contact-card__line">{{ proposal.clientEmail ?: '—' }}</div>
						</div>
					</div>
				</aside>
			</div>
		</div>
	</div>
{% endblock %}
