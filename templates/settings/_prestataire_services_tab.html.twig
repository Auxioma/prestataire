{# settings/_prestataire_services_tab.html.twig #}

<div class="card tm-card tm-services-card p-4">
    <div class="tm-services-header mb-4">
        <div>
            <h5 class="tm-services-title">Vos services</h5>
            <p class="tm-services-subtitle">Gérez vos tarifs et prestations.</p>
        </div>

        <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addServiceModal"
        >
            <i class="fa-solid fa-plus me-2"></i>
            Ajouter un service
        </button>
    </div>

    <div class="table-responsive tm-services-table-wrap">
        <table class="table align-middle tm-services-table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Catégorie</th>
                    <th>Prix</th>
                    <th>Réduction</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for ps in user.prestataireProfile.prestataireServices %}
                    <tr>
                        <td class="tm-service-name">{{ ps.service.name }}</td>
                        <td class="tm-service-category">{{ ps.service.category.name }}</td>
                        <td class="tm-service-price">{{ ps.prixCatalogue|number_format(2, ',', ' ') }} €</td>
                        <td class="{{ ps.tauxReduction ? 'tm-service-discount' : 'tm-service-discount--empty' }}">
                            {{ ps.tauxReduction ? ps.tauxReduction ~ '%' : '-' }}
                        </td>
                        <td class="text-end">
                            <div class="tm-services-actions">
                                <a
                                    href="{{ path('app_prestataire_service_edit', {'id': ps.id}) }}"
                                    class="btn btn-sm btn-outline-primary tm-icon-btn"
                                    title="Modifier"
                                    data-turbo="false"
                                >
                                    <i class="fa-solid fa-pencil"></i>
                                </a>

                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-danger tm-icon-btn js-delete-service"
                                    data-delete-url="{{ path('app_prestataire_service_delete', {'id': ps.id}) }}"
                                    data-delete-token="{{ csrf_token('delete' ~ ps.id) }}"
                                    title="Supprimer"
                                >
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="tm-services-empty text-center">
                            <i class="fa-solid fa-tools fa-2x mb-3 d-block"></i>
                            <p>Aucun service ajouté pour le moment.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# MODAL D'AJOUT DE SERVICE #}
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ajouter un service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" data-controller="chained-selects">
                <form
                    action="{{ path('app_prestataire_add_service') }}"
                    method="POST"
                    data-turbo="false"
                >
                    <select
                        data-chained-selects-target="category"
                        data-action="change->chained-selects#loadSubCategories"
                        class="form-select mb-3"
                        required
                    >
                        <option value="">Choisir une catégorie principale</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>

                    <select
                        data-chained-selects-target="subcategory"
                        data-action="change->chained-selects#loadServices"
                        class="form-select mb-3"
                        disabled
                        required
                    >
                        <option value="">Choisir une sous-catégorie...</option>
                    </select>

                    <select
                        data-chained-selects-target="service"
                        name="service_id"
                        class="form-select mb-3"
                        disabled
                        required
                    >
                        <option value="">Choisir un service...</option>
                    </select>

                    <div class="modal-footer px-0 pb-0">
                        <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal"
                        >
                            Annuler
                        </button>
                        <button type="submit" class="btn btn-primary">
                            Ajouter ce service
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>