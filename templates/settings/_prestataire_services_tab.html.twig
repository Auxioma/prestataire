<div class="tm-settings-container">
	<div class="tm-main-layout">
		<div class="tm-settings-content">
			<h1 class="fw-bold mb-4">Paramètres</h1>

			{# 1. Messages Flash (Positionnés tout en haut pour être vus) #}
			{% for label in ['success', 'warning', 'danger'] %}
				{% for message in app.flashes(label) %}
					<div class="alert alert-{{ label }} alert-dismissible fade show mb-4" role="alert">
						{{ message }}
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				{% endfor %}
			{% endfor %}

			{# 2. Navigation des onglets #}
			<ul class="nav nav-tabs border-bottom gap-2 mb-4" id="settingsTabs" role="tablist">
				<li class="nav-item">
					<button class="nav-link active" data-bs-toggle="tab" data-bs-target="#services-panel" role="tab">🛠️ Services</button>
				</li>
			</ul>

			<div class="tab-content">
				<div
					class="tab-pane fade show active" id="services-panel" role="tabpanel">

					{# 3. Bloc Principal Services #}
					<div class="card border-0 shadow-sm p-4">
						<div class="d-flex justify-content-between align-items-center mb-4">
							<div>
								<h5 class="fw-bold mb-1">Vos services</h5>
								<p class="text-muted small mb-0">Gérez vos tarifs et prestations.</p>
							</div>
							<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">
								<i class="fa-solid fa-plus me-2"></i>
								Ajouter un service
							</button>
						</div>

						{# 4. Tableau des services #}
						<table class="table align-middle">
							<thead class="table-light">
								<tr>
									<th>Service</th>
									<th>Catégorie</th>
									<th>Prix</th>
									<th>Réduction</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for ps in user.prestataireProfile.prestataireServices %}
									<tr>
										<td class="fw-bold">{{ ps.service.name }}</td>
										<td class="text-muted">{{ ps.service.category.name }}</td>
										<td>{{ ps.prixCatalogue|number_format(2, ',', ' ') }}
											€</td>
										<td>{{ ps.tauxReduction ? ps.tauxReduction ~ '%' : '-' }}</td>
										<td class="text-end">
											<a href="{{ path('app_prestataire_service_edit', {'id': ps.id}) }}" class="btn btn-sm btn-outline-primary">
												<i class="fa-solid fa-pencil"></i>
											</a>
											<form method="post" action="{{ path('app_prestataire_service_delete', {'id': ps.id}) }}" style="display: inline-block;">
												<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ps.id) }}">
												<button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteService('{{ path('app_prestataire_service_delete', {'id': ps.id}) }}', '{{ csrf_token('delete' ~ ps.id) }}')">
													<i class="fa-solid fa-trash"></i>
												</button>
											</form>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="5" class="text-center py-5 text-muted">
											<i class="fa-solid fa-tools fa-2x mb-3"></i>
											<p>Aucun service ajouté pour le moment.</p>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{# MODAL D'AJOUT DE SERVICE #}
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Ajouter un service</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			{# Ton contrôleur Stimulus est ici, dans le contenu du modal #}
			<div class="modal-body" data-controller="chained-selects">
				<form
					action="{{ path('app_prestataire_add_service') }}" method="POST">

					{# 1. Menu Catégories #}
					<select data-chained-selects-target="category" data-action="change->chained-selects#loadSubCategories" class="form-select mb-3" required>
						<option value="">Choisir une catégorie principale</option>
						{% for category in categories %}
							<option value="{{ category.id }}">{{ category.name }}</option>
						{% endfor %}
					</select>

					{# 2. Menu Sous-Catégories #}
					<select data-chained-selects-target="subcategory" data-action="change->chained-selects#loadServices" class="form-select mb-3" disabled required>
						<option value="">Choisir une sous-catégorie...</option>
					</select>

					{# 3. Menu Services #}
					<select data-chained-selects-target="service" name="service_id" class="form-select mb-3" disabled required>
						<option value="">Choisir un service...</option>
					</select>

					<div class="modal-footer px-0 pb-0">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
						<button type="submit" class="btn btn-primary">Ajouter ce service</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<script>
function deleteService(url, token) {
    if (confirm('Confirmer la suppression ?')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = url;
        
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = '_token';
        input.value = token;
        
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
