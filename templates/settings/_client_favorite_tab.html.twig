										{% else %}
											Prestation enregistrée dans vos favoris.
										{% endif %}
									</p>

									<div class="mt-auto">
										<a href="{{ path('app_prestataire_service_prestation_show', { slug: prestation.slug }) }}" class="btn tm-cp-favorite-btn w-100">
											Voir la prestation
											<i class="fa-solid fa-arrow-right"></i>
										</a>
									</div>
								</div>
							</article>
						</div>
					{% endfor %}
				</div>

				{% if favoritePrestations|length > 6 %}
					<div class="collapse mt-3" id="favoritePrestationsMore">
						<div class="row g-3">
							{% for prestation in favoritePrestations|slice(6) %}
								<div class="col-md-6 col-xl-4">
									<article class="card border-0 shadow-sm rounded-4 h-100 tm-cp-favorite-card tm-cp-favorite-card--service">
										<div class="tm-cp-favorite-card-body p-3 d-flex flex-column h-100">
											<div class="tm-cp-favorite-card-top d-flex align-items-start justify-content-between gap-3 mb-3">
												<span class="tm-cp-favorite-pill">
													<i class="fa-solid fa-wrench"></i>
													Prestation
												</span>

												<span class="tm-cp-favorite-heart" aria-hidden="true">
													<i class="fa-solid fa-heart"></i>
												</span>
											</div>

											<h5 class="tm-cp-favorite-name tm-cp-favorite-name--service mb-2">
												{{ prestation.title ?: prestation.service.name }}
											</h5>

											<p class="tm-cp-favorite-meta mb-2">
												<i class="fa-solid fa-building"></i>
												<span>{{ prestation.prestataire.companyName ?: 'Prestataire' }}</span>
											</p>

											<p class="tm-cp-favorite-description mb-3">
												{% if prestation.shortDescription %}
													{{ prestation.shortDescription|slice(0, 110) }}
													{% if prestation.shortDescription|length > 110 %}...
													{% endif %}
												{% else %}
													Prestation enregistrée dans vos favoris.
												{% endif %}
											</p>

											<div class="mt-auto">
												<a href="{{ path('app_prestataire_service_prestation_show', { slug: prestation.slug }) }}" class="btn tm-cp-favorite-btn w-100">
													Voir la prestation
													<i class="fa-solid fa-arrow-right"></i>
												</a>
											</div>
										</div>
									</article>
								</div>
							{% endfor %}
						</div>
					</div>

					<div class="mt-3 text-center">
						<button class="btn tm-cp-favorites-more-btn" type="button" data-bs-toggle="collapse" data-bs-target="#favoritePrestationsMore" aria-expanded="false" aria-controls="favoritePrestationsMore">
							Voir/Cacher
						</button>
					</div>
				{% endif %}
			{% else %}
				<div class="row g-3">
					<div class="col-12">
						<div class="tm-cp-favorite-empty border rounded-4 p-4 text-center">
							<div class="tm-cp-favorite-empty-icon">
								<i class="fa-solid fa-screwdriver-wrench"></i>
							</div>
							<p class="tm-cp-favorite-empty-title mb-2">Aucune prestation favorite pour le moment.</p>
							<p class="tm-cp-favorite-empty-text mb-0">
								Enregistrez des prestations depuis les cartes publiques.
							</p>
						</div>
					</div>
				</div>
			{% endif %}
		</div>
	</div>

	{# Bons plans favoris #}
	<div class="col-12">
		<div class="card tm-cp-card tm-cp-favorites-section p-4">
			<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 tm-cp-favorites-section-head">
				<div class="tm-cp-favorites-section-copy">
					<span class="tm-cp-favorites-kicker">Offres enregistrées</span>
					<h4 class="tm-cp-card-title tm-cp-favorites-title mb-1">Mes bons plans favoris</h4>
					<p class="tm-cp-favorites-subtitle mb-0">
						Retrouvez les offres promotionnelles enregistrées.
					</p>
				</div>

				<span class="badge rounded-pill tm-cp-favorites-count">
