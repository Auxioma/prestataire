									<p class="tm-cp-favorite-meta mb-2">
										<i class="fa-solid fa-building"></i>
										<span>{{ prestation.prestataire.companyName ?: 'Prestataire' }}</span>
									</p>

									<p class="tm-cp-favorite-description mb-3">
										{% if prestation.shortDescription %}
