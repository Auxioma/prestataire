{% extends 'base.html.twig' %}

{% block title %}Mes avis reçus{% endblock %}

{% block body %}
    <section class="tm-dashboard-page" {{ stimulus_controller('prestataire-dashboard-tabs') }}>
        <div class="tm-settings-container tm-dashboard-page__shell">
            <div class="tm-main-layout tm-dashboard-page__layout">
                <aside class="tm-settings-sidebar tm-dashboard-page__sidebar" {{ stimulus_target('prestataire-dashboard-tabs', 'sidebar') }}>
                    {{ include('profile/_prestataire_dashboard_sidebar.html.twig', {
                        user: app.user,
                        activeTab: 'avis',
                        asLinks: true,
                    }) }}
                </aside>

                <div class="tm-settings-sidebar-backdrop tm-dashboard-page__backdrop" {{ stimulus_target('prestataire-dashboard-tabs', 'backdrop') }} {{ stimulus_action('prestataire-dashboard-tabs', 'closeSidebar', 'click') }}></div>

                <main class="tm-settings-content tm-dashboard-page__content tm-dashboard-reviews">
                    <button type="button" class="tm-sidebar-toggle d-lg-none tm-dashboard-page__toggle" aria-label="Ouvrir la navigation du dashboard" {{ stimulus_target('prestataire-dashboard-tabs', 'toggle') }} {{ stimulus_action('prestataire-dashboard-tabs', 'toggleSidebar', 'click') }}>
                        ☰
                    </button>

                    {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4 tm-dashboard-page__alert" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% set avatarClasses = ['avatar--safran', 'avatar--bleu', 'avatar--vert', 'avatar--violet', 'avatar--encre'] %}

                    <div class="row g-4">
                        <div class="col-12">
                            <section class="dash-card tm-prestataire-reviews-hero">
                                <div class="tm-prestataire-reviews-hero__copy">
                                    <p class="tm-prestataire-reviews-eyebrow">Réputation client</p>
                                    <h1 class="tm-prestataire-reviews-hero__title">Mes avis reçus</h1>
                                    <p class="tm-prestataire-reviews-hero__text">
                                        Consultez la satisfaction client pour {{ prestataire.companyName|default('votre activité') }}.
                                    </p>
                                </div>

                                <div class="avis-resume tm-prestataire-reviews-summary">
                                    <div class="avis-resume__note">
                                        <b>{{ prestataire.averageRating|default('0.00')|number_format(1, ',', ' ') }}<small>/5</small></b>
                                        <span class="etoiles">
                                            {{ include('review/_stars.html.twig', { rating: prestataire.averageRating|default(0)|round(0, 'common') }) }}
                                        </span>
                                        <p>Note moyenne actuelle</p>
                                    </div>

                                    <div class="perf-stats tm-prestataire-reviews-stats">
                                        <div>
                                            <h3>Avis publiés</h3>
                                            <b>{{ prestataire.reviewsCount|default(0) }}</b>
                                            <small>Clients vérifiés</small>
                                        </div>
                                        <div>
                                            <h3>Note moyenne</h3>
                                            <b>{{ prestataire.averageRating|default('0.00')|number_format(1, ',', ' ') }}</b>
                                            <small>Sur 5</small>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <div class="col-12">
                            <section class="dash-card tm-prestataire-reviews-listcard">
                                <div class="dash-card__header tm-prestataire-reviews-listhead">
                                    <div>
                                        <p class="tm-prestataire-reviews-eyebrow">Détail</p>
                                        <h2>Tous les avis publiés</h2>
                                        <p class="tm-prestataire-reviews-listtext">Chaque avis est rattaché à une demande réellement acceptée.</p>
                                    </div>
                                    <span class="tm-prestataire-reviews-count">{{ reviews|length }}</span>
                                </div>

                                {% if reviews is not empty %}
                                    <div class="d-grid gap-3 tm-prestataire-reviews-grid">
                                        {% for review in reviews %}
                                            {% set account = review.clientProfile.account %}
                                            {% set reviewerName = account ? ((account.firstName|default('') ~ ' ' ~ account.lastName|default(''))|trim ?: account.email|default('Client')) : 'Client' %}
                                            {% set reviewerParts = reviewerName|split(' ') %}
                                            {% set reviewerInitials = ((reviewerParts[0]|default('C'))|slice(0, 1) ~ (reviewerParts[1]|default('L'))|slice(0, 1))|upper %}
                                            {% set avatarClass = avatarClasses[loop.index0 % avatarClasses|length] %}
                                            <article id="review-{{ review.id }}" class="carte-avis-page tm-prestataire-review-card">
                                                <div class="carte-avis-page__haut">
                                                    <span class="avatar {{ avatarClass }}">{{ reviewerInitials ?: 'CL' }}</span>
                                                    <div class="carte-avis-page__id">
                                                        <b>{{ reviewerName }}</b>
                                                        <span>{{ review.quoteRequest.title|default('Demande associée') }} · Avis vérifié</span>
                                                    </div>
                                                    <div class="carte-avis-page__droite">
                                                        <span class="etoiles">{{ include('review/_stars.html.twig', { rating: review.rating }) }}</span>
                                                        <p>{{ review.createdAt|date('d/m/Y à H:i') }}</p>
                                                    </div>
                                                </div>

                                                <p class="carte-avis-page__texte">{{ review.comment|default('Aucun commentaire ajouté.') }}</p>

                                                <div class="tm-prestataire-review-card__actions">
                                                    <a href="{{ path('app_report_review', { id: review.id }) }}" class="btn btn-outline-danger btn-sm">
                                                        Signaler cet avis
                                                    </a>
                                                </div>
                                            </article>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="tm-prestataire-reviews-empty">
                                        <i class="fa-regular fa-star" aria-hidden="true"></i>
                                        <p class="mb-0">Aucun avis reçu pour le moment.</p>
                                    </div>
                                {% endif %}
                            </section>
                        </div>

                        <div class="col-12">
                            <div class="conseil tm-prestataire-reviews-tip">
                                <p class="conseil__titre mb-0">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.9.7 1.5 1.3 1.5 2.1h4c0-.8.6-1.4 1.5-2.1A6 6 0 0 0 12 3z"/></svg>
                                    Impact réputation
                                </p>
                                <p>Des avis récents et réguliers renforcent la confiance et améliorent votre visibilité dans le parcours client.</p>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </section>
{% endblock %}
