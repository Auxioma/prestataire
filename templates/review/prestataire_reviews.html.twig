{% extends 'base.html.twig' %}

{% block title %}Mes avis reçus{% endblock %}

{% block body %}
    <section class="tm-dashboard-page" {{ stimulus_controller('prestataire-dashboard-tabs') }}>
        <div class="tm-settings-container tm-dashboard-page__shell">
            <div class="tm-main-layout tm-dashboard-page__layout">
                <aside class="tm-settings-sidebar tm-dashboard-page__sidebar" {{ stimulus_target('prestataire-dashboard-tabs', 'sidebar') }}>
                    {{ include('profile/_prestataire_dashboard_sidebar.html.twig', {
                        user: app.user,
                        activeTab: 'avis',
                        asLinks: true,
                    }) }}
                </aside>

                <div class="tm-settings-sidebar-backdrop tm-dashboard-page__backdrop" {{ stimulus_target('prestataire-dashboard-tabs', 'backdrop') }} {{ stimulus_action('prestataire-dashboard-tabs', 'closeSidebar', 'click') }}></div>

                <main class="tm-settings-content tm-dashboard-page__content">
                    <button type="button" class="tm-sidebar-toggle d-lg-none tm-dashboard-page__toggle" aria-label="Ouvrir la navigation du dashboard" {{ stimulus_target('prestataire-dashboard-tabs', 'toggle') }} {{ stimulus_action('prestataire-dashboard-tabs', 'toggleSidebar', 'click') }}>
                        ☰
                    </button>

                    {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    <div class="row g-4">
                        <div class="col-12">
                            <section class="card shadow-sm border-0">
                                <div class="card-body p-4 p-lg-5">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
                                        <div>
                                            <span class="text-uppercase small text-muted">Réputation</span>
                                            <h1 class="h2 mb-2">Mes avis reçus</h1>
                                            <p class="mb-0 text-muted">
                                                Consultez la satisfaction client pour {{ prestataire.companyName|default('votre activité') }}.
                                            </p>
                                        </div>

                                        <div class="d-flex flex-wrap gap-3">
                                            <div class="border rounded-4 px-4 py-3 bg-light">
                                                <div class="small text-muted mb-1">Note moyenne</div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <strong class="fs-3">{{ prestataire.averageRating|default('0.00')|number_format(1, ',', ' ') }}</strong>
                                                    {{ include('review/_stars.html.twig', { rating: prestataire.averageRating|default(0)|round(0, 'common') }) }}
                                                </div>
                                            </div>

                                            <div class="border rounded-4 px-4 py-3 bg-light">
                                                <div class="small text-muted mb-1">Nombre d’avis</div>
                                                <strong class="fs-3">{{ prestataire.reviewsCount|default(0) }}</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <div class="col-12">
                            <section class="card shadow-sm border-0">
                                <div class="card-body p-4 p-lg-5">
                                    <div class="mb-4">
                                        <span class="text-uppercase small text-muted">Détail</span>
                                        <h2 class="h4 mb-1">Tous les avis publiés</h2>
                                        <p class="mb-0 text-muted">Chaque avis est rattaché à une demande réellement acceptée.</p>
                                    </div>

                                    {% if reviews is not empty %}
                                        <div class="d-grid gap-3">
                                            {% for review in reviews %}
                                                <article id="review-{{ review.id }}" class="border rounded-4 p-4">
                                                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
                                                        <div>
                                                            {% set account = review.clientProfile.account %}
                                                            <h3 class="h5 mb-1">
                                                                {{ account ? ((account.firstName|default('') ~ ' ' ~ account.lastName|default(''))|trim ?: account.email|default('Client')) : 'Client' }}
                                                            </h3>
                                                            <p class="text-muted mb-2">{{ review.quoteRequest.title|default('Demande associée') }}</p>
                                                            {{ include('review/_stars.html.twig', { rating: review.rating }) }}
                                                        </div>

                                                        <span class="text-muted small">{{ review.createdAt|date('d/m/Y à H:i') }}</span>
                                                    </div>

                                                    <p class="mb-0">{{ review.comment|default('Aucun commentaire ajouté.') }}</p>

                                                    <div class="mt-3">
                                                        <a href="{{ path('app_report_review', { id: review.id }) }}" class="btn btn-outline-danger btn-sm">
                                                            Signaler cet avis
                                                        </a>
                                                    </div>
                                                </article>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <div class="text-center py-5 text-muted">
                                            <i class="fa-regular fa-star fs-1 d-block mb-3" aria-hidden="true"></i>
                                            <p class="mb-0">Aucun avis reçu pour le moment.</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </section>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </section>
{% endblock %}
