<div style="margin:0;padding:32px 16px;background-color:#f4f1ea;font-family:Arial,sans-serif;color:#1f2937;">
    <div style="max-width:640px;margin:0 auto;background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 18px 45px rgba(15,23,42,0.08);">
        <div style="padding:28px 32px;background:linear-gradient(135deg,#0f766e 0%,#155e75 100%);color:#ffffff;">
            <div style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.85;">TrouveMoi</div>
            <h1 style="margin:12px 0 0;font-size:28px;line-height:1.2;">Votre facture est disponible</h1>
        </div>

        <div style="padding:32px;">
            <p style="margin:0 0 16px;font-size:16px;line-height:1.6;">
                {% if clientFirstName %}
                    Bonjour {{ clientFirstName }},
                {% else %}
                    Bonjour,
                {% endif %}
            </p>

            <p style="margin:0 0 16px;font-size:16px;line-height:1.6;">
                Votre facture{% if invoiceNumber %} <strong>n° {{ invoiceNumber }}</strong>{% endif %}
                {% if quoteRequestTitle %} liée à votre demande <strong>{{ quoteRequestTitle }}</strong>{% endif %}
                est maintenant disponible.
            </p>

            <div style="margin:24px 0;padding:20px;border-radius:16px;background:#f8fafc;border:1px solid #e2e8f0;">
                <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">
                    Si vous n’avez pas encore laissé d’avis sur <strong>{{ prestataireName }}</strong>,
                    vous pouvez partager votre retour en quelques clics.
                </p>

                <a
                    href="{{ reviewUrl }}"
                    style="display:inline-block;padding:12px 18px;border-radius:12px;background:#0f766e;color:#ffffff;text-decoration:none;font-weight:700;"
                >
                    Laisser un avis
                </a>
            </div>

            <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">
                Vous pouvez également consulter votre facture en ligne :
            </p>

            <p style="margin:0 0 24px;">
                <a
                    href="{{ invoiceUrl }}"
                    style="display:inline-block;padding:12px 18px;border-radius:12px;background:#ffffff;color:#0f172a;text-decoration:none;font-weight:700;border:1px solid #cbd5e1;"
                >
                    Voir la facture
                </a>
            </p>

            <p style="margin:0;font-size:14px;line-height:1.6;color:#64748b;">
                Merci pour votre confiance.
            </p>
        </div>
    </div>
</div>
