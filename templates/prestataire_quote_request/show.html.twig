{% extends 'base.html.twig' %}

{% block title %}Demande reçue
{% endblock %}

{% block body %}
	<div class="container py-4 tm-quote-detail">
        {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

		<div class="tm-quote-page__hero tm-quote-page__hero--detail">
			<div>
				<h1 class="tm-quote-page__title mb-2">{{ quoteRequest.title }}</h1>
				<p class="tm-quote-page__subtitle mb-0">
					Demande reçue le
					{{ quoteRequest.createdAt ? quoteRequest.createdAt|date('d/m/Y à H:i') : '—' }}
				</p>
			</div>

			<div class="d-flex flex-column align-items-end gap-2">
				<span class="tm-quote-badge tm-quote-badge--{{ quoteRequest.status.value|lower }}">
					{{ quoteRequest.status.value }}
				</span>

				{% if isArchivedView %}
					<span class="badge bg-secondary">Archivée</span>
				{% endif %}
			</div>
		</div>

		{% if isArchivedView %}
			<div class="alert alert-secondary mb-4">
				Cette demande est archivée. Elle reste consultable, mais elle n’est plus modifiable depuis cet espace.
			</div>
		{% endif %}

		<div class="row g-4">
			<div class="col-lg-8">
				<div class="card tm-card tm-quote-detail-card p-4">
					<h2 class="tm-card-title mb-3">Description du besoin</h2>

					<div class="tm-quote-detail__content">
						{% if quoteRequest.description %}
							{{ quoteRequest.description|nl2br }}
						{% else %}
							Aucune description fournie.
						{% endif %}
					</div>
				</div>
			</div>

			<div class="col-lg-4">
				<div class="card tm-card tm-quote-detail-card p-4 mb-4">
					<h3 class="tm-card-title mb-3">Informations</h3>

					<dl class="tm-quote-info-list mb-0">
						<div>
							<dt>Client</dt>
							<dd>
								{% if quoteRequest.client and quoteRequest.client.account %}
									{{ quoteRequest.client.account.firstName }}
									{{ quoteRequest.client.account.lastName }}
									{% if quoteRequest.client.companyName %}
										<br>
										<span class="text-muted">{{ quoteRequest.client.companyName }}</span>
									{% endif %}
								{% else %}
									Non renseigné
								{% endif %}
							</dd>
						</div>

						<div>
							<dt>Date souhaitée</dt>
							<dd>
								{{ quoteRequest.desiredDate ? quoteRequest.desiredDate|date('d/m/Y') : 'Non précisée' }}
							</dd>
						</div>

						<div>
							<dt>Budget</dt>
							<dd>{{ quoteRequest.budgetAmount ?: 'Non renseigné' }}</dd>
						</div>

						<div>
							<dt>Prestation liée</dt>
							<dd>
								{% if quoteRequest.prestation %}
									{{ quoteRequest.prestation.title is defined and quoteRequest.prestation.title
                                        ? quoteRequest.prestation.title
                                        : (quoteRequest.prestation.service and quoteRequest.prestation.service.name
                                            ? quoteRequest.prestation.service.name
                                            : 'Prestation liée')
                                    }}
								{% else %}
									Aucune
								{% endif %}
							</dd>
						</div>
					</dl>
				</div>

				<div class="card tm-card tm-quote-detail-card p-4">
					<h3 class="tm-card-title mb-3">Action</h3>
					<p class="text-muted mb-3">
						Cette demande est disponible en lecture dans votre espace professionnel.
					</p>

					{% if not isArchivedView %}

						{% if quoteRequest.status == constant('App\\Enum\\QuoteRequestStatusEnum::SUBMITTED') %}
							<div class="card tm-card p-4 mb-4">
								<h2 class="h5 mb-3">Traitement de la demande</h2>

								<div class="alert alert-info mb-3">
									En acceptant d’étudier cette demande, vous vous engagez uniquement à apporter une réponse au client
																																				                dans les meilleurs délais. Cela ne vaut pas acceptation ferme et définitive de la prestation telle quelle.
								</div>

								<div class="d-flex flex-column flex-md-row gap-2">
									<form method="post" action="{{ path('app_prestataire_quote_request_accept_study', { slug: quoteRequest.slug }) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('accept-study-' ~ quoteRequest.id) }}">
										<button type="submit" class="btn btn-primary">
											Accepter d’étudier la demande
										</button>
									</form>

									<form method="post" action="{{ path('app_prestataire_quote_request_deny', { slug: quoteRequest.slug }) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('deny-quote-request-' ~ quoteRequest.id) }}">
										<button type="submit" class="btn btn-outline-danger" onclick="return confirm('Confirmez-vous le refus de cette demande ?');">
											Refuser la demande
										</button>
									</form>
								</div>
							</div>
						{% endif %}

						{% if quoteRequest.status == constant('App\\Enum\\QuoteRequestStatusEnum::ACCEPTED')
    or quoteRequest.status == constant('App\\Enum\\QuoteRequestStatusEnum::ANSWERED')
    or quoteRequest.status == constant('App\\Enum\\QuoteRequestStatusEnum::CLOSED') %}

							{% if linkedProposal %}
								<a href="{{ path('app_prestataire_quote_proposal_show', { publicReference: linkedProposal.publicReference }) }}" class="btn btn-success w-100 mt-3">
									{% if linkedProposal.acceptedAt %}
										Consulter le devis accepté par le client
									{% else %}
										Voir le devis
									{% endif %}
								</a>

								{% if linkedProposal.acceptedAt %}
									<a href="{{ path('app_prestataire_invoice_manage', { publicReference: linkedProposal.publicReference }) }}" class="btn btn-outline-success w-100 mt-3">
										{{ linkedProposal.invoice ? (linkedProposal.invoice.isIssued ? 'Voir la facture' : 'Créer / modifier la facture') : 'Créer la facture' }}
									</a>
								{% endif %}
							{% else %}
								<a href="{{ path('app_prestataire_quote_proposal_new', { id: quoteRequest.id, origin: 'quote_request' }) }}" class="btn btn-success w-100 mt-3">
									Créer / ouvrir le devis
								</a>
							{% endif %}
						{% endif %}
					{% endif %}

					{% if quoteRequest.conversation %}
						{% if isArchivedView %}
							<button type="button" class="btn btn-primary w-100 mt-3" disabled>
								Discussion indisponible pour une demande archivée
							</button>
						{% else %}
							<a href="{{ path('app_prestataire_dashboard', { tab: 'messages', conversation: quoteRequest.conversation.id }) ~ '#messages-main-panel' }}" class="btn btn-primary w-100 mt-3">
								Ouvrir la discussion
							</a>

							{% if hasConversationPhotos %}
								<a href="{{ path('app_prestataire_conversation_photos', { id: quoteRequest.conversation.id }) }}" class="btn btn-outline-secondary w-100 mt-3">
									Accès photos conversation
								</a>
							{% endif %}
						{% endif %}
					{% endif %}

					<a href="{{ path('app_prestataire_dashboard', { tab: isArchivedView ? 'archives' : 'demandes' }) ~ (isArchivedView ? '#archives-main-panel' : '#demandes-main-panel') }}" class="btn btn-outline-primary w-100 mt-3">
						{{ isArchivedView ? 'Retour aux archives' : 'Retour aux demandes' }}
					</a>

					{% if isArchivedView and linkedProposal %}
						<a href="{{ path('app_prestataire_quote_proposal_archived_show', { publicReference: linkedProposal.publicReference }) }}" class="btn btn-outline-secondary w-100 mt-3">
							Consulter le devis lié
						</a>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
