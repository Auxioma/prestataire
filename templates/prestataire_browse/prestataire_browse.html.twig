{% extends 'base.html.twig' %}

{% block title %}
    {{ page_title }} - TrouveMoi
{% endblock %}

{% block body %}
    {% set profiles = profiles|default([]) %}
    {% set totalResults = totalResults|default(0) %}
    {% set currentPage = currentPage|default(1) %}
    {% set totalPages = totalPages|default(1) %}
    <div class="container my-5 tm-browse-page">
        <section class="tm-browse-hero mb-5">
            <div class="tm-browse-hero__content">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb small mb-0">
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Accueil</a>
                        </li>
                        <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">
                            Prestataires
                        </li>
                    </ol>
                </nav>

                <span class="tm-browse-hero__eyebrow">Professionnels de confiance</span>
                <h1 class="tm-browse-hero__title">{{ page_title }}</h1>
                <p class="tm-browse-hero__subtitle">
                    Découvrez les professionnels inscrits sur notre plateforme et trouvez le partenaire adapté à votre besoin.
                </p>
            </div>

            <div class="tm-browse-hero__actions">
                <div class="tm-browse-hero__stats">
                    <strong>{{ totalResults }}</strong>
                    <span>prestataire{{ totalResults > 1 ? 's' : '' }}</span>
                </div>
            </div>
        </section>

        <section class="tm-browse-filters mb-4" aria-labelledby="tm-browse-filters-title">
            <div class="tm-browse-filters__head">
                <div>
                    <span class="tm-browse-hero__eyebrow">Recherche avancée</span>
                    <h2 class="tm-browse-filters__title" id="tm-browse-filters-title">Affinez les prestataires</h2>
                </div>
            </div>

            {{ form_start(browseForm, {
                method: 'GET',
                attr: {
                    class: 'tm-browse-filters__form',
                    novalidate: 'novalidate',
                    'data-controller': 'chained-selects'
                }
            }) }}
                <div class="tm-browse-filters__grid">
                    <div class="tm-browse-filter-field tm-browse-filter-field--query">
                        {{ form_label(browseForm.query, null, {
                            label_attr: { class: 'tm-browse-filter-field__label' }
                        }) }}
                        {{ form_widget(browseForm.query, {
                            attr: {
                                class: 'form-control tm-browse-filter-field__control',
                                autocomplete: 'off'
                            }
                        }) }}
                    </div>

                    <div class="tm-browse-filter-field">
                        {{ form_label(browseForm.category, null, {
                            label_attr: { class: 'tm-browse-filter-field__label' }
                        }) }}
                        {{ form_widget(browseForm.category, {
                            attr: {
                                class: 'form-select tm-browse-filter-field__control',
                                'data-chained-selects-target': 'category',
                                'data-action': 'change->chained-selects#loadSubCategories'
                            }
                        }) }}
                    </div>

                    <div class="tm-browse-filter-field">
                        {{ form_label(browseForm.subCategory, null, {
                            label_attr: { class: 'tm-browse-filter-field__label' }
                        }) }}
                        {{ form_widget(browseForm.subCategory, {
                            attr: {
                                class: 'form-select tm-browse-filter-field__control',
                                'data-chained-selects-target': 'subcategory'
                            }
                        }) }}
                    </div>

                    <div class="tm-browse-filter-field">
                        {{ form_label(browseForm.sort, null, {
                            label_attr: { class: 'tm-browse-filter-field__label' }
                        }) }}
                        {{ form_widget(browseForm.sort, {
                            attr: {
                                class: 'form-select tm-browse-filter-field__control'
                            }
                        }) }}
                    </div>
                </div>

                <div class="tm-browse-filters__actions">
                    <button type="submit" class="tm-browse-filters__submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>Rechercher</span>
                    </button>
                    <a href="{{ path('app_prestataire_browse') }}" class="tm-browse-filters__reset">Réinitialiser</a>
                </div>
            {{ form_end(browseForm) }}

            {% if query is not empty or selectedCategory is not null or selectedSubCategory is not null %}
                <div class="tm-browse-filters__chips" aria-label="Filtres actifs">
                    {% if query is not empty %}
                        <span class="tm-browse-filter-chip">{{ query }}</span>
                    {% endif %}
                    {% if selectedCategory is not null %}
                        <span class="tm-browse-filter-chip">{{ selectedCategory.name }}</span>
                    {% endif %}
                    {% if selectedSubCategory is not null %}
                        <span class="tm-browse-filter-chip">{{ selectedSubCategory.name }}</span>
                    {% endif %}
                </div>
            {% endif %}
        </section>

        <div class="row g-4">
            {% if profiles|length > 0 %}
                {% for profile in profiles %}
                    <div class="col-12 col-md-6 col-xl-4">
                        {% set canShowProfile = profile.slug is not empty and profile.slug matches '/^(?!abonnements$)[a-z0-9-]+$/' %}
                        <article
                            class="tm-browse-card h-100"
                            data-controller="card-hover"
                            data-card-hover-hovered-class="tm-browse-card--hovered"
                            data-action="mouseenter->card-hover#mouseEnter mouseleave->card-hover#mouseLeave"
                        >
                            <div class="tm-browse-card__cover">
                                {% if profile.coverImage %}
                                    <img src="{{ asset('uploads/covers/' ~ profile.coverImage) }}" alt="{{ profile.companyName|default('Prestataire') }}">
                                {% else %}
                                    <img src="{{ asset('images/img_par_defaut.png') }}" alt="{{ profile.companyName|default('Prestataire') }}">
                                {% endif %}
                                <div class="tm-browse-card__cover-overlay"></div>

                                {% if profile.verificationStatus or profile.isFeatured %}
                                    <div class="tm-browse-card__badges">
                                        {% if profile.verificationStatus %}
                                            <span class="tm-browse-card__badge tm-browse-card__badge--verified">
                                                <i class="fa-solid fa-circle-check"></i>
                                                Vérifié
                                            </span>
                                        {% endif %}
                                        {% if profile.isFeatured %}
                                            <span class="tm-browse-card__badge tm-browse-card__badge--featured">
                                                <i class="fa-solid fa-gem"></i>
                                                À la une
                                            </span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="tm-browse-card__body">
                                <div class="tm-browse-card__identity">
                                    <div class="tm-browse-card__logo">
                                        {% if profile.logo %}
                                            <img src="{{ asset('uploads/logos/' ~ profile.logo) }}" alt="{{ profile.companyName }}">
                                        {% else %}
                                            <i class="fa-solid fa-building"></i>
                                        {% endif %}
                                    </div>

                                    <div class="tm-browse-card__identity-text">
                                        <h2 class="tm-browse-card__title">
                                            {{ profile.companyName|default(profile.account.userIdentifier) }}
                                        </h2>

                                        <div class="tm-browse-card__meta">
                                            {% if profile.metier %}
                                                <span>
                                                    <i class="fa-solid fa-briefcase"></i>
                                                    {{ profile.metier }}
                                                </span>
                                            {% endif %}

                                            <span>
                                                <i class="fa-solid fa-location-dot"></i>
                                                {{ profile.city|default('Ville non renseignée') }}
                                                {% if profile.postalCode %}({{ profile.postalCode }}){% endif %}
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <p class="tm-browse-card__description">
                                    {% if profile.shortDescription is not null and profile.shortDescription is not empty %}
                                        {{ profile.shortDescription }}
                                    {% else %}
                                        <span class="text-muted fst-italic">
                                            Ce prestataire n’a pas encore rédigé de description courte, mais son savoir-faire reste entièrement à votre disposition.
                                        </span>
                                    {% endif %}
                                </p>

                                <div class="tm-browse-card__footer">
                                    <div class="tm-browse-card__stats">
                                        <span class="tm-browse-card__rating">
                                            <i class="fa-solid fa-star"></i>
                                            <strong>{{ profile.averageRating|default('0.0') }}</strong>
                                            <small>/5</small>
                                        </span>

                                        {% if profile.reviewsCount %}
                                            <span class="tm-browse-card__reviews">
                                                {{ profile.reviewsCount }} avis
                                            </span>
                                        {% endif %}
                                    </div>

                                    {% if canShowProfile %}
                                        <a href="{{ path('app_prestataire_show', {slug: profile.slug}) }}" class="tm-browse-card__link">
                                            Voir le profil
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    {% else %}
                                        <span class="tm-browse-card__link text-muted" aria-disabled="true">
                                            Profil indisponible
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12">
                    <div class="tm-browse-empty">
                        <div class="tm-browse-empty__icon">
                            <i class="fa-solid fa-user-slash"></i>
                        </div>
                        <h3 class="tm-browse-empty__title">Aucun prestataire ne correspond à ce critère</h3>
                        <p class="tm-browse-empty__text">
                            Aucun professionnel n’est disponible pour le moment avec ces filtres. Essayez une autre recherche ou élargissez votre sélection.
                        </p>
                    </div>
                </div>
            {% endif %}
        </div>

        {% if totalPages > 1 %}
            {% set startPage = currentPage - 2 > 1 ? currentPage - 2 : 1 %}
            {% set endPage = currentPage + 2 < totalPages ? currentPage + 2 : totalPages %}
            <nav class="tm-browse-pagination mt-5" aria-label="Pagination des prestataires">
                {% if currentPage > 1 %}
                    <a href="{{ path('app_prestataire_browse', app.request.query.all|merge({ page: currentPage - 1 })) }}" class="tm-browse-pagination__control">
                        <i class="fa-solid fa-chevron-left"></i>
                        <span>Précédent</span>
                    </a>
                {% else %}
                    <span class="tm-browse-pagination__control is-disabled">
                        <i class="fa-solid fa-chevron-left"></i>
                        <span>Précédent</span>
                    </span>
                {% endif %}

                <div class="tm-browse-pagination__pages">
                    {% for pageNumber in startPage..endPage %}
                        {% if pageNumber == currentPage %}
                            <span class="tm-browse-pagination__page is-active">{{ pageNumber }}</span>
                        {% else %}
                            <a href="{{ path('app_prestataire_browse', app.request.query.all|merge({ page: pageNumber })) }}" class="tm-browse-pagination__page">
                                {{ pageNumber }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>

                {% if currentPage < totalPages %}
                    <a href="{{ path('app_prestataire_browse', app.request.query.all|merge({ page: currentPage + 1 })) }}" class="tm-browse-pagination__control">
                        <span>Suivant</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                {% else %}
                    <span class="tm-browse-pagination__control is-disabled">
                        <span>Suivant</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                {% endif %}
            </nav>
        {% endif %}
    </div>
{% endblock %}
