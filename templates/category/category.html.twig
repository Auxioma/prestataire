{% extends 'base.html.twig' %}

{% block title %}TrouveMoi - Toutes les catégories
{% endblock %}

{% block body %}
	<div
		class="container py-4 text-start">

		{# 1. BREADCRUMB #}
		<nav aria-label="breadcrumb" class="mb-4">
			<ol class="breadcrumb small">
				<li class="breadcrumb-item">
					<a href="{{ path('app_home') }}" class="text-decoration-none text-muted">
						<i class="fa-solid fa-house me-1"></i>
						Accueil</a>
				</li>
				<li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Catégories</li>
			</ol>
		</nav>

		{# 2. EN-TÊTE & BADGES #}
		<div class="row align-items-center mb-5 gy-4">
			<div class="col-lg-6">
				<h1 class="fw-extrabold h2 text-dark mb-2">Toutes les catégories</h1>
				<p class="text-muted mb-0">Trouvez facilement le prestataire qu'il vous faut parmi toutes nos catégories.</p>
			</div>
			<div class="col-lg-6">
				<div class="row g-2 justify-content-lg-end">
					<div class="col-6 col-sm-3">
						<div class="p-2 border rounded-3 bg-white text-center h-100 d-flex flex-column align-items-center justify-content-center shadow-xs">
							<i class="fa-solid fa-circle-plus text-tm-accent mb-1 fs-5"></i>
							<span class="fw-bold small text-dark lh-sm">+ 120 000<br><span class="text-muted fw-normal fs-11">prestataires</span>
							</span>
						</div>
					</div>
					<div class="col-6 col-sm-3">
						<div class="p-2 border rounded-3 bg-white text-center h-100 d-flex flex-column align-items-center justify-content-center shadow-xs">
							<i class="fa-solid fa-circle-check text-success mb-1 fs-5"></i>
							<span class="fw-bold small text-dark lh-sm">Prestataires<br><span class="text-muted fw-normal fs-11">vérifiés</span>
							</span>
						</div>
					</div>
					<div class="col-6 col-sm-3">
						<div class="p-2 border rounded-3 bg-white text-center h-100 d-flex flex-column align-items-center justify-content-center shadow-xs">
							<i class="fa-solid fa-star text-warning mb-1 fs-5"></i>
							<span class="fw-bold small text-dark lh-sm">Avis clients<br><span class="text-muted fw-normal fs-11">contrôlés</span>
							</span>
						</div>
					</div>
					<div class="col-6 col-sm-3">
						<div class="p-2 border rounded-3 bg-white text-center h-100 d-flex flex-column align-items-center justify-content-center shadow-xs">
							<i class="fa-solid fa-headset text-tm-service mb-1 fs-5"></i>
							<span class="fw-bold small text-dark lh-sm">Support 7j/7<br><span class="text-muted fw-normal fs-11">à votre écoute</span>
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		{# 3. GRILLE DES CATÉGORIES 100% RESPONSIVE #}
		<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
			{% for category in categories %}
				<div class="col">
					<a
						href="{{ path('app_category_show', {'slug': category.slug}) }}" class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden text-decoration-none tm-cat-grid-card position-relative p-3">

						{# ZONE DE L'ICÔNE CENTRALISÉE ET ÉPURÉE #}
						<div class="d-flex align-items-center justify-content-center rounded-3 mb-3 mx-auto category-icon-box">
							<i class="fa-solid {{ category.icon|default('fa-folder') }} fs-2"></i>
						</div>

						{# CONTENU DE LA CARD #}
						<div class="card-body p-0 text-center">
							<h3 class="fw-extrabold h6 text-dark mb-1">{{ category.name }}</h3>
							<span class="text-muted fs-12 fw-medium">
								{{ category.subCategories|length }}
								{{ category.subCategories|length > 1 ? 'métiers' : 'métier' }}
							</span>
						</div>

					</a>
				</div>
			{% else %}
				<div class="col-12 text-center">
					<div class="alert alert-info border-0 shadow-sm">Aucune catégorie n'est disponible pour le moment.</div>
				</div>
			{% endfor %}
		</div>

		{# 4. BANDEAU DE CONVERSION PARFAITEMENT FIDÈLE AU MODÈLE #}
		<div class="tm-cat-banner">
			<div
				class="tm-cat-banner-left">
				{# Utilisation d'un conteneur pour l'icône crantée/étoile #}
				<div class="tm-cat-banner-icon-wrapper">
					<i class="fa-solid fa-award"></i>
				</div>
				<div class="tm-cat-banner-info">
					<h4 class="h5 mb-1">Vous êtes prestataire ?</h4>
					<p class="tm-cat-banner-desc mb-3">Rejoignez des milliers de professionnels et développez votre activité</p>

					<ul class="tm-cat-banner-features">
						<li>
							<i class="fa-solid fa-circle-check me-2"></i>
							Visibilité accrue</li>
						<li>
							<i class="fa-solid fa-circle-check me-2"></i>
							Clients qualifiés</li>
						<li>
							<i class="fa-solid fa-circle-check me-2"></i>
							Outils de gestion</li>
					</ul>
				</div>
			</div>
			<div class="tm-cat-banner-actions flex-sm-row flex-column mt-3 mt-lg-0">
				<a href="#" class="btn tm-cat-btn-outline">En savoir plus</a>
				<a href="#" class="btn tm-cat-btn-primary">Devenir prestataire</a>
			</div>
		</div>

	</div>
{% endblock %}
