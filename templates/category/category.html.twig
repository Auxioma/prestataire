{% extends 'base.html.twig' %}

{% block title %}TrouveMoi - Toutes les catégories{% endblock %}

{% block body %}
    <div class="tmc-page">

        <section class="tmc-hero">
            <div class="tmc-hero__media" aria-hidden="true">
                <img
                    src="{{ asset('images/img_presta_homepage04.png') }}"
                    alt=""
                    class="tmc-hero__bg-image"
                >
            </div>

            <div class="tmc-hero__overlay"></div>

            <div class="tmc-shell">
                <div class="tmc-hero__inner">
                    <div class="tmc-hero__content">
                        <span class="tmc-eyebrow">Explorer les services</span>

                        <h1 class="tmc-hero__title">
                            Toutes les catégories
                            <span>pour tous vos besoins</span>
                        </h1>

                        <p class="tmc-hero__text">
                            Trouvez facilement le professionnel qu'il vous faut, près de chez vous.
                        </p>

                        <div class="tmc-hero__badges">
                            <span><i class="fa-solid fa-shield-halved"></i> Prestataires vérifiés</span>
                            <span><i class="fa-solid fa-star"></i> Avis authentiques</span>
                            <span><i class="fa-solid fa-file-signature"></i> Devis sans engagement</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="tmc-shell">
            <nav aria-label="breadcrumb" class="tmc-breadcrumb">
                <ol class="breadcrumb tmc-breadcrumb__list">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_home') }}" class="tmc-breadcrumb__link">
                            <i class="fa-solid fa-house"></i>
                            <span>Accueil</span>
                        </a>
                    </li>
                    <li class="breadcrumb-item active tmc-breadcrumb__current" aria-current="page">
                        Catégories
                    </li>
                </ol>
            </nav>

            <section class="tmc-categories" id="categories-grid">
                <div class="tmc-section-head">
                    <div class="tmc-section-copy">
                        <span class="tmc-eyebrow">Navigation par univers</span>
                        <h2 class="tmc-section-title">Choisissez une catégorie</h2>
                        <p class="tmc-section-text">
                            Parcourez l’ensemble des catégories disponibles et trouvez rapidement le métier qui correspond à votre besoin.
                        </p>
                    </div>
                </div>

                <div class="tmc-grid">
                    {% for category in categories %}
                        {% set colorVariant = cycle(['blue', 'orange', 'green', 'violet'], loop.index0) %}

                        <a
                            href="{{ path('app_category_show', {slug: category.slug}) }}"
                            class="tmc-card"
                        >
                            <div class="tmc-card__media">
                                <div class="tmc-card__cover tmc-card__cover--{{ colorVariant }}"></div>

                                <span class="tmc-card__icon tmc-card__icon--{{ colorVariant }}">
                                    <i class="fa-solid {{ category.icon|default('fa-folder') }}"></i>
                                </span>
                            </div>

                            <div class="tmc-card__body">
                                <h3 class="tmc-card__title">{{ category.name }}</h3>

                                <p class="tmc-card__desc">
                                    Découvrez les services disponibles, les spécialités associées et les professionnels
                                    liés à cet univers.
                                </p>

                                <span class="tmc-card__count">
                                    <span>
                                        {{ category.subCategories|length }}
                                        {{ category.subCategories|length > 1 ? 'métiers' : 'métier' }}
                                    </span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </span>
                            </div>
                        </a>
                    {% else %}
                        <div class="tmc-empty">
                            <div class="tmc-empty__icon">
                                <i class="fa-solid fa-layer-group"></i>
                            </div>

                            <div class="tmc-empty__content">
                                <h3 class="tmc-empty__title">Aucune catégorie disponible</h3>
                                <p class="tmc-empty__text">
                                    Les catégories apparaîtront ici dès qu’elles seront publiées.
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="tmc-reassurance">
                <div class="tmc-reassurance__grid">
                    <article class="tmc-reassurance__item">
                        <span class="tmc-reassurance__icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </span>
                        <div>
                            <h3>Prestataires vérifiés</h3>
                            <p>Des professionnels de confiance pour chaque besoin.</p>
                        </div>
                    </article>

                    <article class="tmc-reassurance__item">
                        <span class="tmc-reassurance__icon">
                            <i class="fa-solid fa-star"></i>
                        </span>
                        <div>
                            <h3>Avis clients authentiques</h3>
                            <p>Des retours d’expérience fiables pour faire le bon choix.</p>
                        </div>
                    </article>

                    <article class="tmc-reassurance__item">
                        <span class="tmc-reassurance__icon">
                            <i class="fa-solid fa-file-signature"></i>
                        </span>
                        <div>
                            <h3>Devis gratuits</h3>
                            <p>Comparez les offres et avancez sans engagement.</p>
                        </div>
                    </article>

                    <article class="tmc-reassurance__item">
                        <span class="tmc-reassurance__icon">
                            <i class="fa-solid fa-headset"></i>
                        </span>
                        <div>
                            <h3>Support 7j/7</h3>
                            <p>Une équipe disponible pour vous accompagner.</p>
                        </div>
                    </article>
                </div>
            </section>

            <section class="tmc-pro-cta">
                <div class="tmc-pro-cta__content">
                    <span class="tmc-pro-cta__eyebrow">Espace professionnel</span>

                    <h2 class="tmc-pro-cta__title">Vous êtes prestataire ?</h2>

                    <p class="tmc-pro-cta__text">
                        Rejoignez TrouveMoi, gagnez en visibilité et recevez des demandes qualifiées dans votre zone d’intervention.
                    </p>

                    <div class="tmc-pro-cta__points">
                        <span><i class="fa-solid fa-circle-check"></i> Visibilité accrue</span>
                        <span><i class="fa-solid fa-circle-check"></i> Clients qualifiés</span>
                        <span><i class="fa-solid fa-circle-check"></i> Outils de gestion</span>
                    </div>
                </div>

                <div class="tmc-pro-cta__actions">
                    <a href="#" class="tmc-btn tmc-btn--light-outline">En savoir plus</a>
                    <a href="#" class="tmc-btn tmc-btn--light">Devenir prestataire</a>
                </div>
            </section>
        </div>
    </div>
{% endblock %}