{% extends 'base.html.twig' %}

{% block title %}TrouveMoi - Toutes les catégories{% endblock %}

{% block body %}
    <div class="container py-4 tm-cat-page">

        {# 1. BREADCRUMB #}
        <nav aria-label="breadcrumb" class="tm-cat-breadcrumb mb-4">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item">
                    <a href="{{ path('app_home') }}" class="text-decoration-none text-muted">
                        <i class="fa-solid fa-house me-1"></i>
                        Accueil
                    </a>
                </li>
                <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Catégories</li>
            </ol>
        </nav>

        {# 2. HERO #}
        <section class="tm-cat-hero mb-5">
            <div class="tm-cat-hero__content">
                <span class="tm-cat-hero__eyebrow">
                    Explorer les services
                </span>

                <h1 class="tm-cat-hero__title">
                    Toutes les catégories
                </h1>

                <p class="tm-cat-hero__subtitle">
                    Trouvez facilement le prestataire qu'il vous faut parmi toutes nos catégories, avec une recherche plus claire, plus rapide et plus rassurante.
                </p>
            </div>

            <div class="tm-cat-hero__stats">
                <div class="tm-cat-stat-card">
                    <div class="tm-cat-stat-card__icon tm-cat-stat-card__icon--accent">
                        <i class="fa-solid fa-circle-plus"></i>
                    </div>
                    <div class="tm-cat-stat-card__content">
                        <strong>+ 120 000</strong>
                        <span>prestataires</span>
                    </div>
                </div>

                <div class="tm-cat-stat-card">
                    <div class="tm-cat-stat-card__icon tm-cat-stat-card__icon--success">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="tm-cat-stat-card__content">
                        <strong>Prestataires</strong>
                        <span>vérifiés</span>
                    </div>
                </div>

                <div class="tm-cat-stat-card">
                    <div class="tm-cat-stat-card__icon tm-cat-stat-card__icon--warning">
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <div class="tm-cat-stat-card__content">
                        <strong>Avis clients</strong>
                        <span>contrôlés</span>
                    </div>
                </div>

                <div class="tm-cat-stat-card">
                    <div class="tm-cat-stat-card__icon tm-cat-stat-card__icon--service">
                        <i class="fa-solid fa-headset"></i>
                    </div>
                    <div class="tm-cat-stat-card__content">
                        <strong>Support 7j/7</strong>
                        <span>à votre écoute</span>
                    </div>
                </div>
            </div>
        </section>

        {# 3. GRILLE DES CATÉGORIES #}
        <section class="tm-cat-section mb-5">
            <div class="tm-cat-section__head">
                <div>
                    <h2 class="tm-cat-section__title">Choisissez une catégorie</h2>
                    <p class="tm-cat-section__subtitle">
                        Parcourez tous les univers de services disponibles sur TrouveMoi.
                    </p>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
                {% for category in categories %}
                    <div class="col">
                        <a href="{{ path('app_category_show', {slug: category.slug}) }}"
                           class="tm-cat-card text-decoration-none">
                            <div class="tm-cat-card__inner">
                                <div class="tm-cat-card__top">
                                    <div class="tm-cat-card__icon-box">
                                        <i class="fa-solid {{ category.icon|default('fa-folder') }}"></i>
                                    </div>

                                    <div class="tm-cat-card__arrow">
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </div>
                                </div>

                                <div class="tm-cat-card__body">
                                    <h3 class="tm-cat-card__title">{{ category.name }}</h3>
                                    <p class="tm-cat-card__meta">
                                        {{ category.subCategories|length }}
                                        {{ category.subCategories|length > 1 ? 'métiers disponibles' : 'métier disponible' }}
                                    </p>
                                </div>

                                <div class="tm-cat-card__footer">
                                    <span class="tm-cat-card__link">
                                        Découvrir
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="tm-cat-empty">
                            <div class="tm-cat-empty__icon">📁</div>
                            <h3 class="tm-cat-empty__title">Aucune catégorie disponible</h3>
                            <p class="tm-cat-empty__text">
                                Les catégories apparaîtront ici dès qu’elles seront publiées.
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# 4. BANDEAU PRESTATAIRE #}
        <section class="tm-cat-banner">
            <div class="tm-cat-banner__glow"></div>

            <div class="tm-cat-banner__left">
                <div class="tm-cat-banner__icon">
                    <i class="fa-solid fa-award"></i>
                </div>

                <div class="tm-cat-banner__content">
                    <span class="tm-cat-banner__eyebrow">Espace professionnel</span>
                    <h3 class="tm-cat-banner__title">Vous êtes prestataire ?</h3>
                    <p class="tm-cat-banner__desc">
                        Rejoignez des milliers de professionnels, gagnez en visibilité et recevez des demandes qualifiées dans votre zone d’intervention.
                    </p>

                    <ul class="tm-cat-banner__features">
                        <li><i class="fa-solid fa-circle-check"></i> Visibilité accrue</li>
                        <li><i class="fa-solid fa-circle-check"></i> Clients qualifiés</li>
                        <li><i class="fa-solid fa-circle-check"></i> Outils de gestion</li>
                    </ul>
                </div>
            </div>

            <div class="tm-cat-banner__actions">
                <a href="#" class="btn tm-cat-btn-outline">En savoir plus</a>
                <a href="#" class="btn tm-cat-btn-primary">Devenir prestataire</a>
            </div>
        </section>

    </div>
{% endblock %}
