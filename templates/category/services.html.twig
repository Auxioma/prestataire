{% extends 'base.html.twig' %}

{% block title %}TrouveMoi -
	{{ subCategory.name }}
	-
	{{ category.name }}
{% endblock %}

{% block body %}
	<div class="tm-servx-page">
		<div class="container py-4 tm-servx-container">

			<nav aria-label="breadcrumb" class="tm-servx-breadcrumb">
				<ol class="breadcrumb small mb-0">
					<li class="breadcrumb-item">
						<a href="{{ path('app_home') }}" class="tm-servx-breadcrumb__link">
							<i class="fa-solid fa-house"></i>
							<span>Accueil</span>
						</a>
					</li>
					<li class="breadcrumb-item">
						<a href="{{ path('app_category_index') }}" class="tm-servx-breadcrumb__link">
							Catégories
						</a>
					</li>
					<li class="breadcrumb-item">
						<a href="{{ path('app_category_show', { slug: category.slug }) }}" class="tm-servx-breadcrumb__link">
							{{ category.name }}
						</a>
					</li>
					<li class="breadcrumb-item">
						<a href="{{ path('app_subcategory_services', { categorySlug: category.slug, subCategorySlug: subCategory.slug }) }}" class="tm-servx-breadcrumb__link">
							{{ subCategory.name }}
						</a>
					</li>
					<li class="breadcrumb-item active tm-servx-breadcrumb__current" aria-current="page">
						Services
					</li>
				</ol>
			</nav>

			<section class="tm-servx-hero">
				<div class="tm-servx-hero__content">
					<span class="tm-servx-hero__eyebrow">Prestations disponibles</span>

					<h1 class="tm-servx-hero__title">
						Services en
						{{ subCategory.name }}
					</h1>

					<p class="tm-servx-hero__subtitle">
						Sélectionnez la prestation précise dont vous avez besoin pour trouver rapidement le bon professionnel
						                        dans la catégorie
						{{ category.name|lower }}.
					</p>
				</div>

				<div class="tm-servx-hero__stats">
					<div class="tm-servx-stat-card">
						<div class="tm-servx-stat-card__icon tm-servx-stat-card__icon--gold">
							<i class="fa-solid fa-circle-plus"></i>
						</div>
						<div class="tm-servx-stat-card__content">
							<strong>+ 120 000</strong>
							<span>prestataires</span>
						</div>
					</div>

					<div class="tm-servx-stat-card">
						<div class="tm-servx-stat-card__icon tm-servx-stat-card__icon--blue-soft">
							<i class="fa-solid fa-circle-check"></i>
						</div>
						<div class="tm-servx-stat-card__content">
							<strong>Profils</strong>
							<span>vérifiés</span>
						</div>
					</div>

					<div class="tm-servx-stat-card">
						<div class="tm-servx-stat-card__icon tm-servx-stat-card__icon--gold-soft">
							<i class="fa-solid fa-star"></i>
						</div>
						<div class="tm-servx-stat-card__content">
							<strong>Avis</strong>
							<span>contrôlés</span>
						</div>
					</div>

					<div class="tm-servx-stat-card">
						<div class="tm-servx-stat-card__icon tm-servx-stat-card__icon--blue">
							<i class="fa-solid fa-headset"></i>
						</div>
						<div class="tm-servx-stat-card__content">
							<strong>Support</strong>
							<span>7j/7</span>
						</div>
					</div>
				</div>
			</section>

			<section class="tm-servx-section">
				<div class="tm-servx-section__head">
					<div class="tm-servx-section__intro">
						<span class="tm-servx-section__eyebrow">Choix précis</span>
						<h2 class="tm-servx-section__title">Choisissez une prestation</h2>
						<p class="tm-servx-section__subtitle">
							Ici, vous n’êtes plus au niveau de la spécialité générale :
							                            vous choisissez maintenant le service exact à rechercher.
						</p>
					</div>
				</div>

				{% set activeServices = subCategory.services|filter(service => service.isActive) %}

				{% if activeServices is not empty %}
					<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
						{% for service in activeServices|sort((a, b) => a.position <=> b.position) %}
							<div class="col">
								<article class="tm-servx-service-card">
									<div class="tm-servx-service-card__top">
										<span class="tm-servx-service-card__kicker">Prestation</span>

										<div class="tm-servx-service-card__icon-box">
											<i class="fa-solid {{ service.icon|default('fa-gears') }}"></i>
										</div>
									</div>

									<div class="tm-servx-service-card__body">
										<h3 class="tm-servx-service-card__title">{{ service.name }}</h3>

										{% if service.description %}
											<p class="tm-servx-service-card__desc">
												{{ service.description|length > 140
                                                    ? service.description|slice(0, 140) ~ '...'
                                                    : service.description }}
											</p>
										{% else %}
											<p class="tm-servx-service-card__desc tm-servx-service-card__desc--muted">
												Trouvez rapidement un professionnel qualifié pour cette prestation précise.
											</p>
										{% endif %}
									</div>

									<div class="tm-servx-service-card__price-box">
										{% if service.averagePriceMin and service.averagePriceMax %}
											<span class="tm-servx-service-card__price-label">Tarif indicatif constaté</span>
											<strong class="tm-servx-service-card__price-value">
												{{ service.averagePriceMin|number_format(0, ',', ' ') }}€ —
												{{ service.averagePriceMax|number_format(0, ',', ' ') }}€
											</strong>
										{% else %}
											<span class="tm-servx-service-card__price-label">Tarification</span>
											<strong class="tm-servx-service-card__price-value">Sur devis</strong>
										{% endif %}
									</div>

									<div class="tm-servx-service-card__meta">
										<span class="tm-servx-service-card__meta-pill">Besoin ciblé</span>
										<span class="tm-servx-service-card__meta-pill">Recherche rapide</span>
									</div>

									<div class="tm-servx-service-card__footer">
										<a href="{{ path('app_search_flow', {type: 'service', slug: service.slug}) }}" class="tm-servx-service-card__cta">
											<span>Trouver un pro</span>
											<i class="fa-solid fa-arrow-right"></i>
										</a>
									</div>
								</article>
							</div>
						{% endfor %}
					</div>
				{% else %}
					<div class="tm-servx-empty">
						<div class="tm-servx-empty__badge">Services</div>
						<div class="tm-servx-empty__icon">
							<i class="fa-solid fa-screwdriver-wrench"></i>
						</div>
						<h3 class="tm-servx-empty__title">Aucune prestation disponible</h3>
						<p class="tm-servx-empty__text">
							Cette spécialité ne propose pas encore de services actifs pour le moment.
						</p>
					</div>
				{% endif %}
			</section>

			<section class="tm-servx-banner">
				<div class="tm-servx-banner__glow"></div>

				<div class="tm-servx-banner__left">
					<div class="tm-servx-banner__icon">
						<i class="fa-solid fa-award"></i>
					</div>

					<div class="tm-servx-banner__content">
						<span class="tm-servx-banner__eyebrow">Espace professionnel</span>
						<h3 class="tm-servx-banner__title">Vous êtes prestataire ?</h3>
						<p class="tm-servx-banner__desc">
							Rejoignez TrouveMoi, gagnez en visibilité et recevez des demandes ciblées dans votre spécialité.
						</p>

						<ul class="tm-servx-banner__features">
							<li>
								<i class="fa-solid fa-circle-check"></i>
								Visibilité accrue</li>
							<li>
								<i class="fa-solid fa-circle-check"></i>
								Clients qualifiés</li>
							<li>
								<i class="fa-solid fa-circle-check"></i>
								Outils de gestion</li>
						</ul>
					</div>
				</div>

				<div class="tm-servx-banner__actions">
					<a href="#" class="tm-servx-btn tm-servx-btn--ghost-light">En savoir plus</a>
					<a href="#" class="tm-servx-btn tm-servx-btn--primary-light">Devenir prestataire</a>
				</div>
			</section>
		</div>
	</div>
{% endblock %}
