{% extends 'base.html.twig' %}

{% block title %}TrouveMoi - {{ subCategory.name }} - {{ category.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/service-list.css') }}">
{% endblock %}

{% block body %}
    <div class="container py-4 tm-serv-page">

        {# 1. BREADCRUMB #}
        <nav aria-label="breadcrumb" class="tm-serv-breadcrumb mb-4">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item">
                    <a href="{{ path('app_home') }}" class="text-decoration-none text-muted">
                        <i class="fa-solid fa-house me-1"></i>
                        Accueil
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{ path('app_category_index') }}" class="text-decoration-none text-muted">
                        Catégories
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{ path('app_category_show', {'slug': category.slug}) }}" class="text-decoration-none text-muted">
                        {{ category.name }}
                    </a>
                </li>
                <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">
                    {{ subCategory.name }}
                </li>
            </ol>
        </nav>

        {# 2. HERO #}
        <section class="tm-serv-hero mb-5">
            <div class="tm-serv-hero__content">
                <span class="tm-serv-hero__eyebrow">Prestations disponibles</span>

                <h1 class="tm-serv-hero__title">
                    Services en {{ subCategory.name }}
                </h1>

                <p class="tm-serv-hero__subtitle">
                    Sélectionnez la prestation précise dont vous avez besoin pour trouver rapidement le bon professionnel dans la catégorie {{ category.name|lower }}.
                </p>
            </div>

            <div class="tm-serv-hero__stats">
                <div class="tm-serv-stat-card">
                    <div class="tm-serv-stat-card__icon tm-serv-stat-card__icon--accent">
                        <i class="fa-solid fa-circle-plus"></i>
                    </div>
                    <div class="tm-serv-stat-card__content">
                        <strong>+ 120 000</strong>
                        <span>prestataires</span>
                    </div>
                </div>

                <div class="tm-serv-stat-card">
                    <div class="tm-serv-stat-card__icon tm-serv-stat-card__icon--success">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="tm-serv-stat-card__content">
                        <strong>Profils</strong>
                        <span>vérifiés</span>
                    </div>
                </div>

                <div class="tm-serv-stat-card">
                    <div class="tm-serv-stat-card__icon tm-serv-stat-card__icon--warning">
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <div class="tm-serv-stat-card__content">
                        <strong>Avis</strong>
                        <span>contrôlés</span>
                    </div>
                </div>

                <div class="tm-serv-stat-card">
                    <div class="tm-serv-stat-card__icon tm-serv-stat-card__icon--service">
                        <i class="fa-solid fa-headset"></i>
                    </div>
                    <div class="tm-serv-stat-card__content">
                        <strong>Support</strong>
                        <span>7j/7</span>
                    </div>
                </div>
            </div>
        </section>

        {# 3. SECTION SERVICES #}
        <section class="tm-serv-section mb-5">
            <div class="tm-serv-section__head">
                <div>
                    <h2 class="tm-serv-section__title">Choisissez une prestation</h2>
                    <p class="tm-serv-section__subtitle">
                        Comparez les besoins les plus fréquents et lancez votre recherche en un clic.
                    </p>
                </div>
            </div>

            {% set activeServices = subCategory.services|filter(service => service.isActive) %}

            {% if activeServices is not empty %}
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    {% for service in activeServices|sort((a, b) => a.position <=> b.position) %}
                        <div class="col">
                            <article class="tm-serv-card">
                                <div class="tm-serv-card__inner">

                                    <div class="tm-serv-card__icon-row">
                                        <div class="tm-serv-card__icon-box">
                                            <i class="fa-solid {{ service.icon|default('fa-gears') }}"></i>
                                        </div>
                                    </div>

                                    <div class="tm-serv-card__body">
                                        <h3 class="tm-serv-card__title">{{ service.name }}</h3>

                                        {% if service.description %}
                                            <p class="tm-serv-card__desc">
                                                {{ service.description|length > 135
                                                    ? service.description|slice(0, 135) ~ '...'
                                                    : service.description }}
                                            </p>
                                        {% else %}
                                            <p class="tm-serv-card__desc tm-serv-card__desc--muted">
                                                Trouvez rapidement un professionnel qualifié pour cette prestation.
                                            </p>
                                        {% endif %}

                                        {% if service.averagePriceMin and service.averagePriceMax %}
                                            <div class="tm-serv-card__price-box">
                                                <span class="tm-serv-card__price-label">Tarif moyen constaté</span>
                                                <strong class="tm-serv-card__price-value">
                                                    {{ service.averagePriceMin|number_format(0, ',', ' ') }}€ - {{ service.averagePriceMax|number_format(0, ',', ' ') }}€
                                                </strong>
                                            </div>
                                        {% else %}
                                            <div class="tm-serv-card__price-box tm-serv-card__price-box--empty">
                                                <span class="tm-serv-card__price-label">Tarification</span>
                                                <strong class="tm-serv-card__price-value">Sur devis</strong>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <div class="tm-serv-card__footer">
                                        <a href="{{ path('app_search_flow', {'type': 'service', 'slug': service.slug}) }}"
                                           class="tm-serv-card__cta">
                                            Trouver un pro
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="tm-serv-empty">
                    <div class="tm-serv-empty__icon">🛠️</div>
                    <h3 class="tm-serv-empty__title">Aucune prestation disponible</h3>
                    <p class="tm-serv-empty__text">
                        Cette spécialité ne propose pas encore de services actifs pour le moment.
                    </p>
                </div>
            {% endif %}
        </section>

        {# 4. BANDEAU PRESTATAIRE #}
        <section class="tm-serv-banner">
            <div class="tm-serv-banner__glow"></div>

            <div class="tm-serv-banner__left">
                <div class="tm-serv-banner__icon">
                    <i class="fa-solid fa-award"></i>
                </div>

                <div class="tm-serv-banner__content">
                    <span class="tm-serv-banner__eyebrow">Espace professionnel</span>
                    <h3 class="tm-serv-banner__title">Vous êtes prestataire ?</h3>
                    <p class="tm-serv-banner__desc">
                        Rejoignez TrouveMoi, gagnez en visibilité et recevez des demandes ciblées dans votre spécialité.
                    </p>

                    <ul class="tm-serv-banner__features">
                        <li><i class="fa-solid fa-circle-check"></i> Visibilité accrue</li>
                        <li><i class="fa-solid fa-circle-check"></i> Clients qualifiés</li>
                        <li><i class="fa-solid fa-circle-check"></i> Outils de gestion</li>
                    </ul>
                </div>
            </div>

            <div class="tm-serv-banner__actions">
                <a href="#" class="btn tm-serv-btn-outline">En savoir plus</a>
                <a href="#" class="btn tm-serv-btn-primary">Devenir prestataire</a>
            </div>
        </section>

    </div>
{% endblock %}