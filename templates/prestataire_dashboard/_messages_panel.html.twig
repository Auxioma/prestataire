<div class="card tm-card p-0 overflow-hidden">
	<div class="row g-0">
		<div class="col-lg-4 border-end">
			<div class="p-4 border-bottom">
				<h4 class="tm-card-title mb-1">Toutes les conversations</h4>
				<p class="text-muted mb-0">
					Retrouvez ici les échanges liés aux demandes de devis acceptées.
				</p>
			</div>

			{% if conversations is empty %}
				<div class="p-4">
					<div class="alert alert-light mb-0">
						Aucune conversation ouverte pour le moment.
					</div>
				</div>
			{% else %}
				<div class="list-group list-group-flush">
					{% for conversation in conversations %}
						{% set quoteRequest = conversation.quoteRequest %}
						{% set lastMessage = conversation.messages|last %}
						<a href="{{ path('app_prestataire_dashboard', {conversation: conversation.id}) ~ '#messages-main-panel' }}" class="list-group-item list-group-item-action p-3 {% if activeConversation and activeConversation.id == conversation.id %}active{% endif %}">
							<div class="d-flex justify-content-between align-items-start gap-3">
								<div class="flex-grow-1">
									<div class="fw-semibold mb-1">
										{{ quoteRequest ? quoteRequest.title : 'Conversation sans demande liée' }}
									</div>

									<div class="small {% if activeConversation and activeConversation.id == conversation.id %}text-white-50{% else %}text-muted{% endif %}">
										{% if quoteRequest and quoteRequest.client and quoteRequest.client.account %}
											{{ quoteRequest.client.account.firstName }}
											{{ quoteRequest.client.account.lastName }}
										{% else %}
											Client non renseigné
										{% endif %}
									</div>

									<div class="small mt-2 {% if activeConversation and activeConversation.id == conversation.id %}text-white-50{% else %}text-muted{% endif %}">
										{% if lastMessage %}
											{% set preview = lastMessage.content ?? '' %}
											{{ preview|length > 90 ? preview|slice(0, 90) ~ '...' : preview }}
										{% else %}
											Conversation ouverte, aucun message affichable pour le moment.
										{% endif %}
									</div>
								</div>

								<div class="text-end">
									{% if quoteRequest %}
										<span class="tm-quote-badge tm-quote-badge--{{ quoteRequest.status.value|lower }}">
											{{ quoteRequest.status.value }}
										</span>
									{% endif %}

									<div class="small mt-2 {% if activeConversation and activeConversation.id == conversation.id %}text-white-50{% else %}text-muted{% endif %}">
										{{ conversation.lastMessageAt ? conversation.lastMessageAt|date('d/m/Y') : '—' }}
									</div>
								</div>
							</div>
						</a>
					{% endfor %}
				</div>
			{% endif %}
		</div>

		<div class="col-lg-8">
			{% if activeConversation %}
				{% set quoteRequest = activeConversation.quoteRequest %}

				<div class="p-4 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
					<div>
						<h4 class="tm-card-title mb-1">
							{{ quoteRequest ? quoteRequest.title : 'Conversation' }}
						</h4>
						<p class="text-muted mb-0">
							{% if quoteRequest and quoteRequest.client and quoteRequest.client.account %}
								Échange avec
								{{ quoteRequest.client.account.firstName }}
								{{ quoteRequest.client.account.lastName }}
							{% else %}
								Conversation liée à une demande de devis.
							{% endif %}
						</p>
					</div>

					{% if quoteRequest %}
						<button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#quoteRequestDetailsModal">
							Voir la demande
						</button>
					{% endif %}
				</div>

				<div class="p-4" style="min-height: 420px; max-height: 620px; overflow-y: auto;">
					{% if activeConversation.messages is empty %}
						<div class="alert alert-light mb-0">
							Aucun message dans cette conversation pour le moment.
						</div>
					{% else %}
						<div class="d-flex flex-column gap-3">
							{% for message in activeConversation.messages %}
								{% set isPrestataireAuthor = message.author and app.user and message.author.id == app.user.id %}
								{% set isSystem = message.type and message.type.value == 'system' %}

								<div class="d-flex {% if isSystem %}justify-content-center{% elseif isPrestataireAuthor %}justify-content-end{% else %}justify-content-start{% endif %}">
									{% if isSystem %}
										<div class="badge text-bg-light px-3 py-2">
											{{ message.content }}
										</div>
									{% else %}
										<div class="p-3 rounded-4 {% if isPrestataireAuthor %}bg-primary text-white{% else %}bg-light border{% endif %}" style="max-width: 75%;">
											<div class="small {% if isPrestataireAuthor %}text-white-50{% else %}text-muted{% endif %} mb-1">
												{% if message.author %}
													{{ message.author.firstName }}
													{{ message.author.lastName }}
												{% else %}
													Système
												{% endif %}
												·
												{{ message.createdAt ? message.createdAt|date('d/m/Y à H:i') : '—' }}
											</div>
											<div>{{ message.content|nl2br }}</div>
										</div>
									{% endif %}
								</div>
							{% endfor %}
						</div>
					{% endif %}
				</div>

				<div class="border-top p-4 bg-light">
					<div class="border-top p-4 bg-light">
						{% if messageForm %}
							{{ form_start(messageForm) }}
							<div class="mb-3">
								{{ form_widget(messageForm.content, {
                    attr: {
                        class: 'form-control',
                        rows: 4,
                        placeholder: 'Écrivez votre message...'
                    }
                }) }}
								{{ form_errors(messageForm.content) }}
							</div>

							<div class="d-flex justify-content-end">
								<button type="submit" class="btn btn-primary">
									Envoyer
								</button>
							</div>
							{{ form_end(messageForm) }}
						{% endif %}
					</div>
				</div>

				{% if quoteRequest %}
					<div class="modal fade" id="quoteRequestDetailsModal" tabindex="-1" aria-labelledby="quoteRequestDetailsModalLabel" aria-hidden="true">
						<div class="modal-dialog modal-lg modal-dialog-scrollable">
							<div class="modal-content">
								<div class="modal-header">
									<h5 class="modal-title" id="quoteRequestDetailsModalLabel">
										Détails de la demande
									</h5>
									<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
								</div>

								<div class="modal-body">
									<div class="mb-3">
										<h6 class="mb-1">{{ quoteRequest.title }}</h6>
										<div class="text-muted small">
											Reçue le
											{{ quoteRequest.createdAt ? quoteRequest.createdAt|date('d/m/Y à H:i') : '—' }}
										</div>
									</div>

									<div class="row g-3 mb-3">
										<div class="col-md-6">
											<strong>Client</strong><br>
											{% if quoteRequest.client and quoteRequest.client.account %}
												{{ quoteRequest.client.account.firstName }}
												{{ quoteRequest.client.account.lastName }}
											{% else %}
												Non renseigné
											{% endif %}
										</div>

										<div class="col-md-6">
											<strong>Statut</strong><br>
											<span class="tm-quote-badge tm-quote-badge--{{ quoteRequest.status.value|lower }}">
												{{ quoteRequest.status.value }}
											</span>
										</div>

										<div class="col-md-6">
											<strong>Date souhaitée</strong><br>
											{{ quoteRequest.desiredDate ? quoteRequest.desiredDate|date('d/m/Y') : 'Non précisée' }}
										</div>

										<div class="col-md-6">
											<strong>Budget</strong><br>
											{{ quoteRequest.budgetAmount ?: 'Non renseigné' }}
										</div>
									</div>

									<div>
										<strong>Description du besoin</strong>
										<div class="mt-2">
											{% if quoteRequest.description %}
												{{ quoteRequest.description|nl2br }}
											{% else %}
												Aucune description fournie.
											{% endif %}
										</div>
									</div>
								</div>

								<div class="modal-footer">
									<a href="{{ path('app_prestataire_quote_request_show', {id: quoteRequest.id}) }}" class="btn btn-outline-secondary">
										Ouvrir la fiche demande
									</a>
									<button type="button" class="btn btn-primary" data-bs-dismiss="modal">
										Fermer
									</button>
								</div>
							</div>
						</div>
					</div>
				{% endif %}
			{% else %}
				<div class="p-5">
					<div class="alert alert-light mb-0">
						Sélectionnez une conversation pour afficher les échanges.
					</div>
				</div>
			{% endif %}
		</div>
	</div>
</div>
