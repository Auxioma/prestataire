{% set radius = 32 %}
{% set circumference = 2 * 3.141592653589793 * radius %}
{% set progressOffset = circumference - (completionReport.score / 100) * circumference %}
{% set quoteStatusClasses = {
    submitted: 'is-neutral',
    accepted: 'is-info',
    answered: 'is-warning',
    closed: 'is-success'
} %}

{% if priorityAlerts is not empty %}
    <section class="tm-dashboard-priority-band" aria-label="Priorités du moment">
        {% for alert in priorityAlerts %}
            <article class="tm-dashboard-priority-band__item is-{{ alert.tone }}">
                <div class="tm-dashboard-priority-band__content">
                    <span class="tm-dashboard-priority-band__eyebrow">Priorité</span>
                    <h3>{{ alert.title }}</h3>
                    <p>{{ alert.text }}</p>
                </div>
                <a href="{{ alert.href }}" class="tm-dashboard-priority-band__link">{{ alert.label }}</a>
            </article>
        {% endfor %}
    </section>
{% endif %}

<div class="row g-3 tm-dashboard-widgets-grid">
    <div class="col-12 col-md-6 col-xl-4">
        <article class="card tm-card p-3 tm-dashboard-widget tm-dashboard-widget--profile h-100">
            <div class="tm-dashboard-widget__topline">
                <span class="tm-dashboard-widget__eyebrow">Profil</span>
                <span class="tm-dashboard-widget__meta">{{ completionReport.completedSections }}/{{ completionReport.totalSections }} sections</span>
            </div>

            <div class="tm-dashboard-widget__completion">
                <div class="tm-dashboard-widget__ring" aria-label="Profil complété à {{ completionReport.score }}%">
                    <svg viewBox="0 0 84 84" width="84" height="84" aria-hidden="true">
                        <circle cx="42" cy="42" r="{{ radius }}" fill="none" stroke="#e5ebf5" stroke-width="8"></circle>
                        <circle
                            cx="42"
                            cy="42"
                            r="{{ radius }}"
                            fill="none"
                            stroke="#0b2c78"
                            stroke-width="8"
                            stroke-linecap="round"
                            transform="rotate(-90 42 42)"
                            stroke-dasharray="{{ circumference }}"
                            stroke-dashoffset="{{ progressOffset }}"
                            style="transition: stroke-dashoffset .35s ease;"
                        ></circle>
                    </svg>
                    <div class="tm-dashboard-widget__ring-center">
                        <strong>{{ completionReport.score }}%</strong>
                    </div>
                </div>

                <div class="tm-dashboard-widget__completion-copy">
                    <h4 class="tm-card-title mb-1">Complétion du profil</h4>
                    <p class="text-muted small mb-2">Un site web ou un seul réseau social suffit pour la présence publique.</p>
                    <div class="tm-dashboard-widget__chips">
                        <span>{{ completionReport.completedChecks }}/{{ completionReport.totalChecks }} critères</span>
                    </div>
                </div>
            </div>

            <div class="tm-dashboard-widget__list">
                {% if completionReport.nextSections is not empty %}
                    {% for section in completionReport.nextSections|slice(0, 3) %}
                        <div class="tm-dashboard-widget__item">
                            <div class="tm-dashboard-widget__item-main">
                                <i class="fa-solid {{ section.icon }}" aria-hidden="true"></i>
                                <span>{{ section.label }}</span>
                            </div>
                            <small>{{ section.completed }}/{{ section.total }}</small>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="tm-dashboard-widget__empty">Profil entièrement complété.</div>
                {% endif %}
            </div>

            <div class="tm-dashboard-widget__footer">
                <a href="{{ path('app_prestataire_settings', { tab: 'profile' }) }}">Ouvrir les paramètres</a>
            </div>
        </article>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <article class="card tm-card p-3 tm-dashboard-widget tm-dashboard-widget--quotes h-100">
            <div class="tm-dashboard-widget__topline">
                <span class="tm-dashboard-widget__eyebrow">Devis</span>
                <span class="tm-dashboard-widget__meta">{{ recentQuoteRequests|length }} / 5</span>
            </div>

            <h4 class="tm-card-title mb-2">Demandes récentes</h4>
            <div class="tm-dashboard-widget__list">
                {% if recentQuoteRequests is empty %}
                    <div class="tm-dashboard-widget__empty">Aucune demande reçue récemment.</div>
                {% else %}
                    {% for quoteRequest in recentQuoteRequests %}
                        <div class="tm-dashboard-widget__item tm-dashboard-widget__item--stack">
                            <div class="tm-dashboard-widget__item-main">
                                <strong>{{ quoteRequest.title }}</strong>
                                <small>
                                    {{ quoteRequest.client and quoteRequest.client.account
                                        ? quoteRequest.client.account.firstName ~ ' ' ~ quoteRequest.client.account.lastName
                                        : 'Client non renseigné' }}
                                </small>
                            </div>
                            <div class="tm-dashboard-widget__item-side">
                                <span class="tm-dashboard-widget__status {{ attribute(quoteStatusClasses, quoteRequest.status.value)|default('is-neutral') }}">{{ quoteRequest.status.label }}</span>
                                <small>{{ quoteRequest.createdAt ? quoteRequest.createdAt|date('d/m H:i') : '—' }}</small>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="tm-dashboard-widget__footer">
                <a href="{{ path('app_prestataire_dashboard', { tab: 'demandes' }) ~ '#demandes-main-panel' }}">Voir toutes les demandes</a>
            </div>
        </article>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <article class="card tm-card p-3 tm-dashboard-widget tm-dashboard-widget--calendar h-100">
            <div class="tm-dashboard-widget__topline">
                <span class="tm-dashboard-widget__eyebrow">Agenda</span>
                <span class="tm-dashboard-widget__meta">{{ "now"|date('F Y')|capitalize }}</span>
            </div>

            <h4 class="tm-card-title mb-2">Agenda</h4>
            <div
                class="tm-dashboard-widget__calendar"
                data-controller="calendar-panel"
                data-calendar-panel-events-url-value="{{ path('app_prestataire_appointment_events') }}"
                data-calendar-panel-update-url-value="{{ path('app_prestataire_appointment_move') }}"
                data-calendar-panel-csrf-token-value="{{ csrf_token('move_appointment') }}"
                data-calendar-panel-script-url-value="{{ asset('vendor/fullcalendar/index.global.min.js') }}"
                data-calendar-panel-compact-value="true"
                data-calendar-panel-height-value="290"
            ></div>

            <div class="tm-dashboard-widget__subsection">
                <div class="tm-dashboard-widget__subsection-title">Prochains rendez-vous</div>
                <div class="tm-dashboard-widget__list">
                    {% if upcomingAppointments is empty %}
                        <div class="tm-dashboard-widget__empty">Aucun rendez-vous programmé prochainement.</div>
                    {% else %}
                        {% for appointment in upcomingAppointments %}
                            <div class="tm-dashboard-widget__item tm-dashboard-widget__item--stack">
                                <div class="tm-dashboard-widget__item-main">
                                    <strong>{{ appointment.title }}</strong>
                                    <span class="tm-dashboard-widget__status tm-dashboard-widget__status--appointment is-{{ appointment.status.value }}">
                                        {{ appointment.status.label }}
                                    </span>
                                </div>
                                <div class="tm-dashboard-widget__message-preview">
                                    {{ appointment.startsAt ? appointment.startsAt|date('d/m/Y \\à H:i') : '—' }}
                                    {% if appointment.locationLabel %}
                                        · {{ appointment.locationLabel }}
                                    {% endif %}
                                </div>
                                <small>
                                    {% if appointment.client and appointment.client.account %}
                                        {{ appointment.client.account.firstName }} {{ appointment.client.account.lastName }}
                                    {% elseif appointment.prestation and appointment.prestation.service %}
                                        {{ appointment.prestation.service.name }}
                                    {% else %}
                                        Rendez-vous planifié
                                    {% endif %}
                                </small>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            <div class="tm-dashboard-widget__footer">
                <a href="{{ path('app_prestataire_dashboard', { tab: 'calendrier' }) ~ '#calendrier-main-panel' }}">Ouvrir le calendrier complet</a>
            </div>
        </article>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <article class="card tm-card p-3 tm-dashboard-widget tm-dashboard-widget--subscription h-100">
            <div class="tm-dashboard-widget__topline">
                <span class="tm-dashboard-widget__eyebrow">Abonnement</span>
                <span class="tm-dashboard-widget__meta">{{ remainingCredits }} crédit{{ remainingCredits > 1 ? 's' : '' }}</span>
            </div>

            <h4 class="tm-card-title mb-2">Crédits et formule</h4>

            <div class="tm-dashboard-widget__subscription">
                <div class="tm-dashboard-widget__subscription-number">{{ remainingCredits }}</div>
                <div class="tm-dashboard-widget__subscription-copy">
                    <strong>
                        {{ currentSubscription and currentSubscription.plan ? currentSubscription.plan.name : 'Aucun abonnement actif' }}
                    </strong>
                    <small>
                        {% if currentSubscription %}
                            {{ currentSubscription.billingPeriod.label }}
                            {% if currentSubscription.currentPeriodEnd %}
                                · jusqu’au {{ currentSubscription.currentPeriodEnd|date('d/m/Y') }}
                            {% endif %}
                        {% else %}
                            Souscrivez une formule pour répondre aux demandes et activer la messagerie.
                        {% endif %}
                    </small>
                </div>
            </div>

            <div class="tm-dashboard-widget__chips">
                {% if currentSubscription %}
                    <span>{{ currentSubscription.creditsConsumedCurrentPeriod }} consommé{{ currentSubscription.creditsConsumedCurrentPeriod > 1 ? 's' : '' }}</span>
                    <span>{{ currentSubscription.creditsGrantedCurrentPeriod }} accordé{{ currentSubscription.creditsGrantedCurrentPeriod > 1 ? 's' : '' }}</span>
                {% else %}
                    <span>0 crédit disponible</span>
                {% endif %}
            </div>

            <div class="tm-dashboard-widget__footer">
                <a href="{{ path('app_subscription_index') }}">Gérer l’abonnement</a>
            </div>
        </article>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <article class="card tm-card p-3 tm-dashboard-widget tm-dashboard-widget--messages h-100">
            <div class="tm-dashboard-widget__topline">
                <span class="tm-dashboard-widget__eyebrow">Messagerie</span>
                <span class="tm-dashboard-widget__meta">{{ recentMessages|length }} / 5</span>
            </div>

            <h4 class="tm-card-title mb-2">Messages récents</h4>
            <div class="tm-dashboard-widget__list">
                {% if recentMessages is empty %}
                    <div class="tm-dashboard-widget__empty">Aucun message récent.</div>
                {% else %}
                    {% for message in recentMessages %}
                        {% set conversation = message.conversation %}
                        {% set quoteRequest = conversation ? conversation.quoteRequest : null %}
                        <div class="tm-dashboard-widget__item tm-dashboard-widget__item--stack">
                            <div class="tm-dashboard-widget__item-main">
                                <strong>{{ quoteRequest ? quoteRequest.title : 'Conversation' }}</strong>
                                <small>
                                    {% if message.author %}
                                        {{ message.author.firstName }} {{ message.author.lastName }}
                                    {% else %}
                                        Système
                                    {% endif %}
                                </small>
                            </div>
                            <div class="tm-dashboard-widget__message-preview">
                                {% if message.content %}
                                    {{ message.content|length > 72 ? message.content|slice(0, 72) ~ '…' : message.content }}
                                {% else %}
                                    Message sans texte.
                                {% endif %}
                            </div>
                            <div class="tm-dashboard-widget__item-side tm-dashboard-widget__item-side--inline">
                                <span class="tm-dashboard-widget__status {{ message.readAt ? 'is-success' : 'is-gold' }}">
                                    {{ message.readAt ? 'Lu' : 'Non lu' }}
                                </span>
                                <small>{{ message.createdAt ? message.createdAt|date('d/m H:i') : '—' }}</small>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="tm-dashboard-widget__footer">
                <a href="{{ path('app_prestataire_dashboard', { tab: 'messages' }) ~ '#messages-main-panel' }}">Ouvrir la messagerie</a>
            </div>
        </article>
    </div>

    <div class="col-12 col-md-6 col-xl-4">
        <article class="card tm-card p-3 tm-dashboard-widget tm-dashboard-widget--reviews h-100">
            <div class="tm-dashboard-widget__topline">
                <span class="tm-dashboard-widget__eyebrow">Avis</span>
                <span class="tm-dashboard-widget__meta">{{ prestataireProfile.reviewsCount|default(0) }} avis</span>
            </div>

            <div class="tm-dashboard-widget__reviews-head">
                <div>
                    <h4 class="tm-card-title mb-1">Avis clients</h4>
                    <p class="text-muted small mb-0">Note globale {{ prestataireProfile.averageRating|default('0')|number_format(1, ',', ' ') }}/5</p>
                </div>
                <div class="tm-dashboard-widget__rating-badge">
                    {{ prestataireProfile.averageRating|default('0')|number_format(1, ',', ' ') }}
                </div>
            </div>

            <div class="tm-dashboard-widget__list">
                {% if recentReviews is empty %}
                    <div class="tm-dashboard-widget__empty">Aucun avis reçu pour le moment.</div>
                {% else %}
                    {% for review in recentReviews %}
                        <div class="tm-dashboard-widget__item tm-dashboard-widget__item--stack">
                            <div class="tm-dashboard-widget__item-main">
                                <strong>
                                    {{ review.clientProfile and review.clientProfile.account
                                        ? review.clientProfile.account.firstName ~ ' ' ~ review.clientProfile.account.lastName
                                        : 'Client' }}
                                </strong>
                                <small>{{ review.createdAt ? review.createdAt|date('d/m/Y') : '—' }}</small>
                            </div>
                            <div class="tm-dashboard-widget__review-line">
                                <span class="tm-dashboard-widget__stars">
                                    {% for i in 1..5 %}{{ i <= review.rating ? '★' : '☆' }}{% endfor %}
                                </span>
                                <span>{{ review.rating }}/5</span>
                            </div>
                            <div class="tm-dashboard-widget__message-preview">
                                {{ review.comment ? (review.comment|length > 88 ? review.comment|slice(0, 88) ~ '…' : review.comment) : 'Aucun commentaire rédigé.' }}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="tm-dashboard-widget__footer">
                <a href="{{ path('app_review_prestataire_reviews') }}">Voir tous les avis</a>
            </div>
        </article>
    </div>
</div>

<script src="{{ asset('vendor/fullcalendar/index.global.min.js') }}"></script>
