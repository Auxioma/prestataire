<div class="card tm-card tm-calendar-panel p-4">
	<div class="tm-calendar-header mb-4">
		<h4 class="tm-card-title tm-calendar-title mb-1">Calendrier</h4>
		<p class="tm-calendar-subtitle">Gérez vos rendez-vous, interventions et disponibilités depuis une seule vue.</p>
	</div>

	<div class="tm-calendar-wrap">
		<div id="prestataire-calendar" data-calendar-events='[
			                {"title":"Intervention Bordeaux","start":"2026-06-18T09:00:00","end":"2026-06-18T10:30:00"},
			                {"title":"Devis Mérignac","start":"2026-06-19T14:00:00","end":"2026-06-19T15:00:00"},
			                {"title":"Visite client Pessac","start":"2026-06-23T11:00:00","end":"2026-06-23T12:00:00"},
			                {"title":"Chantier Talence","start":"2026-06-25T08:30:00","end":"2026-06-25T12:30:00"}
			            ]'></div>
	</div>
</div>

<script src="{{ asset('vendor/fullcalendar/index.global.min.js') }}"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('prestataire-calendar');

    if (!calendarEl || typeof FullCalendar === 'undefined') {
        return;
    }

    const rawEvents = calendarEl.dataset.calendarEvents || '[]';
    let events = [];

    try {
        events = JSON.parse(rawEvents);
    } catch (error) {
        console.error('Impossible de parser les événements du calendrier.', error);
    }

    const calendar = new FullCalendar.Calendar(calendarEl, {
        locale: 'fr',
        initialView: 'dayGridMonth',
        firstDay: 1,
        height: 650,
        nowIndicator: true,
        selectable: true,
        editable: false,
        dayMaxEvents: true,
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        buttonText: {
            today: 'Aujourd’hui',
            month: 'Mois',
            week: 'Semaine',
            day: 'Jour',
            list: 'Liste'
        },
        events: events,
        eventTimeFormat: {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
        }
    });

    calendar.render();
});
</script>