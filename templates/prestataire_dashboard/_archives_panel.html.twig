<div class="tm-dashboard-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 mb-1">Archives</h2>
            <p class="text-muted mb-0">Retrouvez ici les demandes archivées.</p>
        </div>
    </div>

    {% if archivedQuoteRequests|length > 0 %}
        <div class="card shadow-sm border-0">
            <div class="card-body">
                {% for quoteRequest in archivedQuoteRequests %}
                    <div class="border-bottom py-3 d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="fw-semibold">{{ quoteRequest.title }}</div>

                            <div class="text-muted small mb-1">
                                Budget : {{ quoteRequest.budgetAmount ?: 'Non renseigné' }}
                            </div>

                            {% if quoteRequest.createdAt %}
                                <div class="text-muted small">
                                    Reçue le {{ quoteRequest.createdAt|date('d/m/Y à H:i') }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="flex-shrink-0">
                            <a href="{{ path('app_prestataire_quote_request_show', { slug: quoteRequest.slug }) }}"
                               class="btn btn-outline-secondary btn-sm">
                                Lire la demande
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="mt-3">
            {{ knp_pagination_render(archivedQuoteRequests) }}
        </div>
    {% else %}
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <p class="mb-0 text-muted">Aucune demande archivée pour le moment.</p>
            </div>
        </div>
    {% endif %}
</div>