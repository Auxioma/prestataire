<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Nouvelle demande de contact</title>
        {{ include('contact/emails/_styles.html.twig') }}
    </head>
    <body>
        <table role="presentation" class="tm-contact-email-page" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td align="center">
                    <table role="presentation" class="tm-contact-email-shell" width="640" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                            <td class="tm-contact-email-header">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td class="tm-contact-email-brand">TrouveMoi</td>
                                    </tr>
                                    <tr>
                                        <td class="tm-contact-email-title">Nouvelle demande de contact</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td class="tm-contact-email-content">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td class="tm-contact-email-label">Expéditeur</td>
                                        <td class="tm-contact-email-value"><a href="mailto:{{ senderEmail }}">{{ senderEmail }}</a></td>
                                    </tr>
                                    <tr>
                                        <td class="tm-contact-email-label">Catégorie</td>
                                        <td class="tm-contact-email-value">{{ categoryLabel }}</td>
                                    </tr>
                                    <tr>
                                        <td class="tm-contact-email-label">Reçue le</td>
                                        <td class="tm-contact-email-value">{{ submittedAt|date('d/m/Y à H:i') }}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" class="tm-contact-email-message">{{ message }}</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td class="tm-contact-email-footer">
                                Répondez directement à cet e-mail pour contacter l’expéditeur.
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
