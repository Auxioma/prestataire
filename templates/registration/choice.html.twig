{% extends 'base.html.twig' %}

{% block title %}Type de compte - TrouveMoi Prestataires
{% endblock %}

{% block body %}
    <main class="tm-login-section py-4">
        <div class="container-fluid px-4 px-xxl-5">

            <section class="card tm-login-card">
                <div
                    class="row g-0">

                    {# PANNEAU VISUEL GAUCHE #}
                    <div class="col-12 col-xl-5 col-xxl-4">
                        <div class="tm-login-visual h-100 d-flex align-items-stretch">
                            <div
                                class="tm-login-visual-content px-4 px-md-5 py-5 d-flex flex-column w-100">

                                {# Logo d'entête #}
                                <a class="tm-logo d-flex align-items-center gap-2 text-decoration-none py-0 mb-4" href="{{ path('app_home') }}">
                                    <img src="{{ asset('images/logo_trouvemoipresta.png') }}" alt="Logo TrouveMoi" class="brand-logo">
                                    <div class="d-flex flex-column lh-1">
                                        <span class="brand-title mb-0">TrouveMoi</span>
                                        <span class="brand-subtitle">PRESTATAIRES</span>
                                    </div>
                                </a>

                                {# Textes d'introduction - On vire complètement le my-auto / mt-5 d'ici #}
                                <div class="py-2 mb-4">
                                    <h1 class="tm-login-title mb-4">
                                        Bienvenue sur<br>
                                        <span>TrouveMoi Prestataires</span>
                                    </h1>
                                    <p class="tm-login-intro mb-4">
                                        Connectez-vous pour accéder à votre espace et profiter de tous nos services.
                                    </p>

                                    {# Liste des avantages (Panneau Gauche) #}
                                    <div class="d-flex flex-column gap-4">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="tm-benefit-icon-outline d-flex align-items-center justify-content-center">
                                                <img src="{{ asset('images/categories/icons/shield-halved-solid.png') }}" alt="shield-icon">
                                            </div>
                                            <div>
                                                <h2 class="fs-6 fw-bold text-white mb-1">Sécurisé</h2>
                                                <p class="text-white-50 mb-0 small">Vos données sont protégées et vos transactions sécurisées.</p>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-start gap-3">
                                            <div class="tm-benefit-icon-outline d-flex align-items-center justify-content-center">
                                                <img src="{{ asset('images/categories/icons/star-regular.png') }}" alt="star-icon">
                                            </div>
                                            <div>
                                                <h2 class="fs-6 fw-bold text-white mb-1">Fiable</h2>
                                                <p class="text-white-50 mb-0 small">Des professionnels vérifiés et des avis clients authentiques.</p>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-start gap-3">
                                            <div class="tm-benefit-icon-outline d-flex align-items-center justify-content-center">
                                                <img src="{{ asset('images/categories/icons/headset-solid-full.svg') }}" alt="headset-icon">
                                            </div>
                                            <div>
                                                <h2 class="fs-6 fw-bold text-white mb-1">À votre écoute</h2>
                                                <p class="text-white-50 mb-0 small">Une équipe dédiée pour vous accompagner à chaque étape.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {# Zone Image avec effet estompé #}
                                <div class="tm-visual-img-container">
                                    <img src="{{ asset('images/categories/img/fourgon.jpg') }}" alt="fourgon" class="tm-visual-img">
                                </div>
                            </div>
                        </div>
                    </div>

                    {# PANNEAU DE CHOIX DE PROFIL DROITE #}
                    <div class="col-12 col-xl-7 col-xxl-8">
                        <div class="tm-choice-area d-flex align-items-center justify-content-center px-4 px-md-5 py-5">
                            <div
                                class="tm-choice-container">

                                {# En-tête de sélection #}
                                <div class="mb-5 text-center">
                                    <h2 class="tm-choice-title mb-3">Comment souhaitez-vous vous connecter ?</h2>
                                    <p class="tm-choice-subtitle mb-0">Choisissez votre profil pour accéder à votre espace personnalisé</p>
                                </div>

                                <div
                                    class="row g-4 justify-content-center">
                                    {# CARTE INTERFACE CLIENT #}
                                    <div class="col-12 col-md-6">
                                        <div
                                            class="tm-profile-card d-flex flex-column h-100">

                                            <!-- Conteneur flex pour pousser le bouton en bas -->
                                            <div class="grow">
                                                <div class="tm-profile-img-wrapper">
                                                    <img src="{{ asset('images/categories/img/client_img_choice.jpg') }}" alt="Client Privé" class="tm-profile-img">
                                                </div>

                                                <div class="d-flex align-items-center gap-3 mb-3">
                                                    <div class="tm-avatar-icon-bg d-flex align-items-center justify-content-center">
                                                        <img src="{{ asset('images/categories/icons/user-regular-full.svg') }}" alt="user-icon">
                                                    </div>
                                                    <div>
                                                        <h3 class="fs-5 fw-bold mb-0 text-dark" style="font-weight:700 !important;">Je suis client</h3>
                                                        <p class="text-muted small mb-0">Trouvez le prestataire idéal pour tous vos projets</p>
                                                    </div>
                                                </div>

                                                <ul class="tm-bullet-list">
                                                    <li>
                                                        <i class="bi bi-check-lg"></i>
                                                        Recherchez des professionnels</li>
                                                    <li>
                                                        <i class="bi bi-check-lg"></i>
                                                        Comparez les avis et tarifs</li>
                                                    <li>
                                                        <i class="bi bi-check-lg"></i>
                                                        Demandez des devis gratuits</li>
                                                    <li>
                                                        <i class="bi bi-check-lg"></i>
                                                        Gérez vos projets en toute simplicité</li>
                                                </ul>
                                            </div>

                                            {# ACTIONS - BOUTON CLIENT #}
                                            <form action="{{ path('app_register') }}" method="GET" class="mt-3">
                                                <input type="hidden" name="role" value="client">
                                                <button type="submit" class="tm-btn-continue">Continuer en tant que client</button>
                                            </form>
                                        </div>
                                    </div>

                                    {# CARTE INTERFACE PRESTATAIRE #}
                                    <div class="col-12 col-md-6">
                                        <div
                                            class="tm-profile-card d-flex flex-column h-100">

                                            <!-- Conteneur flex pour pousser le bouton en bas -->
                                            <div class="grow">
                                                <div class="tm-profile-img-wrapper">
                                                    <img src="{{ asset('images/categories/img/prestataire_img_choice.jpg') }}" alt="Artisan Professionnel" class="tm-profile-img">
                                                    <div class="tm-stars-badge d-flex align-items-center gap-1">
                                                        ⭐ 4,8/5
                                                    </div>
                                                </div>

                                                <div class="d-flex align-items-center gap-3 mb-3">
                                                    <div class="tm-avatar-icon-bg d-flex align-items-center justify-content-center">
                                                        <img src="{{ asset('images/categories/icons/screwdriver-wrench-solid-full.svg') }}" alt="screwdriver-icon">
                                                    </div>
                                                    <div>
                                                        <h3 class="fs-5 fw-bold mb-0 text-dark" style="font-weight:700 !important;">Je suis prestataire</h3>
                                                        <p class="text-muted small mb-0">Développez votre activité et trouvez de nouveaux clients</p>
                                                    </div>
                                                </div>

                                                <ul class="tm-bullet-list">
                                                    <li>
                                                        <i class="bi bi-check-lg"></i>
                                                        Recevez des demandes de devis</li>
                                                    <li>
                                                        <i class="bi bi-check-lg"></i>
                                                        Gérez votre activité facilement</li>
                                                    <li>
                                                        <i class="bi bi-check-lg"></i>
                                                        Développez votre visibilité</li>
                                                    <li>
                                                        <i class="bi bi-check-lg"></i>
                                                        Suivez vos performances</li>
                                                </ul>
                                            </div>

                                            {# ACTIONS - BOUTON PRESTATAIRE #}
                                            <form action="{{ path('app_register') }}" method="GET" class="mt-3">
                                                <input type="hidden" name="role" value="prestataire">
                                                <button type="submit" class="tm-btn-continue">Continuer en tant que prestataire</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                {# Ligne de réassurance inférieure #}
                                <div class="tm-separator mt-5">
                                    <span>
                                        <img src="{{ asset('images/categories/icons/lock-solid.png') }}" alt="lock-icon">Vos données sont sécurisées et confidentielles</span>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </section>

        </div>
    </main>
{% endblock %}
