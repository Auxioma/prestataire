{% extends 'base.html.twig' %}

{% block title %}Inscription - TrouveMoi Prestataires
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/register/register.css') }}">
{% endblock %}

{% block body %}

	<div class="tm-register-page">

		<div class="container-fluid px-4 px-xl-5">

			<div
				class="tm-register-card">

				{# ================= LEFT ================= #}

				<div class="tm-left">

					<div class="tm-overlay"></div>

					<div class="tm-left-content">

						<h1>
							Bienvenue sur<br>
							TrouveMoi
							<span>Prestataires</span>
						</h1>

						<p class="tm-description">
							Connectez-vous pour accéder à des milliers de
																												                        prestataires de confiance et profiter des meilleurs
																												                        services partout en France.
						</p>

						<div class="tm-benefits">

							<div class="tm-benefit">
								<div class="tm-benefit-icon">
									<i class="bi bi-shield-check"></i>
								</div>

								<div>
									<strong>Des prestataires vérifiés</strong>
									<span>
										Chaque professionnel est vérifié et noté
									</span>
								</div>
							</div>

							<div class="tm-benefit">
								<div class="tm-benefit-icon">
									<i class="bi bi-star"></i>
								</div>

								<div>
									<strong>Des avis authentiques</strong>
									<span>
										Consultez les avis de vrais clients.
									</span>
								</div>
							</div>

							<div class="tm-benefit">
								<div class="tm-benefit-icon">
									<i class="bi bi-tag"></i>
								</div>

								<div>
									<strong>Des offres exclusives</strong>
									<span>
										Profitez des bons plans près de chez vous.
									</span>
								</div>
							</div>

							<div class="tm-benefit">
								<div class="tm-benefit-icon">
									<i class="bi bi-lock"></i>
								</div>

								<div>
									<strong>Paiement sécurisé</strong>
									<span>
										Transactions protégées.
									</span>
								</div>
							</div>

						</div>

						<div class="tm-review-card">

							<p>
								Grâce à TrouveMoi, j'ai trouvé un plombier fiable
															en moins de 2 heures. Service au top !
							</p>

							<div class="tm-stars">
								★★★★★
							</div>

							<strong>Sophie D.</strong>

							<span>Cliente satisfaite</span>

						</div>

					</div>

				</div>

				{# ================= RIGHT ================= #}

				<div class="tm-form-container">

					<div class="tm-role">
						<span>
							{{
                app.request.query.get('role','client') == 'prestataire'
                ? 'Professionnel 🛠️'
                : 'Particulier 👤'
            }}
						</span>

						<a href="{{ path('app_register_choice') }}">
							Changer
						</a>
					</div>

					<h2>Créer un compte</h2>

					<p class="tm-subtitle">
						Remplissez les informations ci-dessous.
					</p>

					{{ form_start(registrationForm) }}

					<div class="tm-field">
						<i class="bi bi-envelope-fill"></i>

						{{
            form_widget(registrationForm.email,{
                attr:{
                    placeholder:'Adresse e-mail',
                    class:'tm-input'
                }
            })
        }}
					</div>

					<div class="tm-password-wrapper" data-controller="password">

						<div class="tm-field tm-password-field">

							<span class="tm-field-icon">
								<i class="bi bi-lock-fill"></i>
							</span>

							{{
                form_widget(registrationForm.plainPassword,{
                    attr:{
                        placeholder:'Mot de passe',
                        class:'tm-input',
                        'data-password-target':'input',
                        'data-action':'input->password#checkPassword'
                    }
                })
            }}

							<button type="button" class="tm-password-toggle" data-password-target="toggle" data-action="click->password#toggleVisibility"></button>

						</div>

						<div class="tm-password-rules">

							<div class="invalid" data-password-target="length">
								❌ Au moins 8 caractères
							</div>

							<div class="invalid" data-password-target="uppercase">
								❌ Au moins une majuscule
							</div>

							<div class="invalid" data-password-target="number">
								❌ Au moins un chiffre
							</div>

							<div class="invalid" data-password-target="special">
								❌ Au moins un caractère spécial
							</div>

						</div>

					</div>

					<div class="tm-checkbox">

						{{ form_widget(registrationForm.agreeTerms) }}

						{{ form_label(registrationForm.agreeTerms) }}

					</div>

					<button type="submit" class="tm-submit">
						S'enregistrer
					</button>

					<div class="tm-divider">
						<span>ou</span>
					</div>

					<a href="{{ path('connect_google_start', { role: app.request.query.get('role','client') }) }}" class="tm-social-btn">
						<i class="bi bi-google"></i>
						<span>S'inscrire avec Google</span>
					</a>

					<button type="button" class="tm-social-btn">
						<i class="bi bi-apple"></i>
						<span>S'inscrire avec Apple</span>
					</button>

					<p class="tm-login-link">

						Vous avez déjà un compte ?

						<a href="{{ path('app_login') }}">
							Se connecter
						</a>

					</p>

					{{ form_end(registrationForm) }}

				</div>

			</div>

			<div class="tm-footer-features">

				<div class="item">
					<i class="bi bi-calendar-check"></i>

					<div>
						<strong>Demande de devis gratuite</strong>
						<span>Réponse rapide des prestataires</span>
					</div>
				</div>

				<div class="item">
					<i class="bi bi-shield-check"></i>

					<div>
						<strong>Aucun engagement</strong>
						<span>Comparez librement</span>
					</div>
				</div>

				<div class="item">
					<i class="bi bi-lock"></i>

					<div>
						<strong>Paiement sécurisé</strong>
						<span>100% protégé</span>
					</div>
				</div>

				<div class="item">
					<i class="bi bi-star"></i>

					<div>
						<strong>Satisfaction garantie</strong>
						<span>Nous vous accompagnons</span>
					</div>
				</div>

				<div class="item">
					<i class="bi bi-headset"></i>

					<div>
						<strong>Support 7j/7</strong>
						<span>Une équipe disponible</span>
					</div>
				</div>

			</div>

		</div>

	</div>

{% endblock %}
