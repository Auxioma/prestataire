{% set currentRoute = app.request.attributes.get('_route')|default('') %}

<ul class="nav flex-column gap-2 tm-cp-nav-menu">
    <li class="nav-item">
        <a
            href="{{ path('app_quote_request_index') }}"
            class="nav-link {{ currentRoute starts with 'app_quote_request_' and currentRoute not in ['app_quote_request_history', 'app_quote_request_history_show'] ? 'active' : '' }}"
        >
            <span class="me-2">
                <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
            </span>
            Mes Demandes
        </a>
    </li>

    <li class="nav-item">
        <a
            href="{{ path('app_client_settings_favorites') }}"
            class="nav-link {{ currentRoute == 'app_client_settings_favorites' ? 'active' : '' }}"
        >
            <span class="me-2">
                <i class="fa-regular fa-heart" aria-hidden="true"></i>
            </span>
            Mes Artisans Favoris
        </a>
    </li>

    <li class="nav-item">
        <a
            href="{{ path('app_quote_request_history') }}"
            class="nav-link {{ currentRoute in ['app_quote_request_history', 'app_quote_request_history_show'] ? 'active' : '' }}"
        >
            <span class="me-2">
                <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
            </span>
            Mes Archives
        </a>
    </li>

    <li class="nav-item">
        <a
            href="{{ path('app_client_settings') }}"
            class="nav-link {{ currentRoute == 'app_client_settings' ? 'active' : '' }}"
        >
            <span class="me-2">
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
            </span>
            Paramètres
