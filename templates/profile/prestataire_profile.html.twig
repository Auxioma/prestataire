{% extends 'base.html.twig' %}

{% block title %}Paramètres - TrouveMoi
{% endblock %}

{% block body %}
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

	<div class="tm-settings-container">
		<div
			class="tm-main-layout">

			{# Sidebar #}
			<div class="tm-settings-sidebar">
				<div class="w-100">
					<div class="text-center mb-4 p-3 rounded-3 bg-light-subtle border">
						<div class="position-relative d-inline-block mb-2">
							<img src="{{ user.avatar ? asset('uploads/avatars/' ~ user.avatar) : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80' }}" class="rounded-circle border tm-sidebar-avatar" alt="Avatar">
						</div>
						<h6 class="mb-0 fw-semibold">{{ user.firstName }}
							{{ user.lastName }}</h6>
						<p class="mb-2 small text-muted">{{ user.prestataireProfile.metier|default('Plombier') }}</p>
						<span class="badge bg-success-subtle text-success px-2 py-1">✓ Vérifié</span>
					</div>

					<ul class="nav tm-settings-nav flex-column gap-1">
						<li class="nav-item">
							<a href="#" class="nav-link">
								<span>📋</span>
								Tableau de bord</a>
						</li>
						<li class="nav-item">
							<a href="#" class="nav-link">
								<span>📥</span>
								Mes demandes</a>
						</li>
						<li class="nav-item">
							<a href="#" class="nav-link">
								<span>💼</span>
								Mes prestations</a>
						</li>
						<li class="nav-item">
							<a href="#" class="nav-link">
								<span>⭐</span>
								Mes avis</a>
						</li>
						<li class="nav-item">
							<a href="#" class="nav-link active">
								<span>⚙️</span>
								Paramètres</a>
						</li>
					</ul>
				</div>

				<div class="tm-sidebar-parrainage-card w-100 text-center rounded-3 mt-auto">
					<p class="fw-medium mb-2 text-white">🎁 Parrainez un collègue
						<br><span class="fw-normal text-white-50">Gagnez 50€ de crédit</span>
					</p>
					<button class="btn btn-sm btn-light w-100 fw-semibold">Parrainer maintenant</button>
				</div>
			</div>

			{# Zone de contenu principal #}
			<div class="tm-settings-content">
				<div class="mb-4">
					<h1 class="fw-bold mb-1">Paramètres</h1>
					<p class="text-muted mb-0">Gérez votre profil, vos informations et vos préférences</p>
				</div>

				{% for label in ['success', 'warning'] %}
					{% for message in app.flashes(label) %}
						<div class="alert alert-{{ label == 'warning' ? 'warning' : 'success' }} alert-dismissible fade show mb-4" role="alert">
							{{ message }}
							<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
						</div>
					{% endfor %}
				{% endfor %}

				<div class="mb-4">
					<ul class="nav nav-tabs border-bottom gap-2 tm-settings-nav flex-nowrap overflow-x-auto pb-1" id="settingsTabs" role="tablist">
						<li class="nav-item">
							<button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile-panel" role="tab">👤 Mon profil</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#company-panel" role="tab">🏢 Mon entreprise</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#services-panel" role="tab">🛠️ Services</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#zones-panel" role="tab">📍 Zones</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#dispo-panel" role="tab">📅 Disponibilités</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#notif-panel" role="tab">🔔 Notifications</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#security-panel" role="tab">🛡️ Sécurité</button>
						</li>
					</ul>
				</div>

				{{ form_start(settingsForm, {'attr': {'novalidate': 'novalidate', 'class': 'tm-form-container', 'enctype': 'multipart/form-data'}}) }}
				<div class="tab-content" id="settingsTabsContent">
					<div class="tab-pane fade show active" id="profile-panel" role="tabpanel">{{ include('settings/_prestataire_profile_tab.html.twig') }}</div>
					<div class="tab-pane fade" id="company-panel" role="tabpanel">{{ include('settings/_prestataire_company_tab.html.twig') }}</div>
					<div class="tab-pane fade" id="services-panel" role="tabpanel">{{ include('settings/_prestataire_services_tab.html.twig') }}</div>
					<div class="tab-pane fade" id="zones-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4 class="tm-card-title mb-2">📍 Zones d'intervention</h4>
							<p class="text-muted mb-0">Gestion des rayons...</p>
						</div>
					</div>
					<div class="tab-pane fade" id="dispo-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4 class="tm-card-title mb-2">📅 Vos Disponibilités</h4>
							<p class="text-muted mb-0">Calendrier d'ouverture...</p>
						</div>
					</div>
					<div class="tab-pane fade" id="notif-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4 class="tm-card-title mb-2">🔔 Vos Notifications</h4>
							<p class="text-muted mb-0">Préférences d'alertes...</p>
						</div>
					</div>
					<div class="tab-pane fade" id="security-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4 class="tm-card-title mb-2">🛡️ Sécurité</h4>
							<p class="text-muted mb-0">Changement de mot de passe...</p>
						</div>
					</div>
				</div>
				{{ form_end(settingsForm) }}
			</div>
		</div>
	</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Vérifie si l'URL contient #services-panel
    if (window.location.hash === '#services-panel') {
        const triggerEl = document.querySelector('button[data-bs-target="#services-panel"]');
        if (triggerEl) {
            const tab = new bootstrap.Tab(triggerEl);
            tab.show();
        }
    }
});
</script>
{% endblock %}
