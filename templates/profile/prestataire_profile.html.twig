{% extends 'base.html.twig' %}

{% block title %}Paramètres - TrouveMoi{% endblock %}

{% block body %}
<div class="tm-settings-container">
    <div class="tm-main-layout">
        {# ================= SIDEBAR ================= #}
        <aside class="tm-settings-sidebar">
            <div class="tm-app-sidebar">
                <div class="tm-app-sidebar-top">
                    <div class="tm-sidebar-brand">
                        <div class="tm-sidebar-brand-logo">📍</div>
                        <div class="tm-sidebar-brand-text">
                            <span class="tm-sidebar-brand-title">TrouveMoi</span>
                            <span class="tm-sidebar-brand-subtitle">Prestataires</span>
                        </div>
                    </div>

                    <div class="tm-sidebar-profile-card">
                        <div class="tm-sidebar-profile-avatar-wrap">
                            <img
                                src="{{ user.avatar ? asset('uploads/avatars/' ~ user.avatar) : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80' }}"
                                alt="Avatar"
                                class="tm-sidebar-profile-avatar"
                            >
                        </div>

                        <div class="tm-sidebar-profile-content">
                            <div class="tm-sidebar-profile-name">
                                {{ user.firstName }} {{ user.lastName }}
                            </div>

                            <div class="tm-sidebar-profile-job">
                                {{ user.prestataireProfile.metier|default('Prestataire') }}
                            </div>

                            <div class="tm-sidebar-profile-rating">
                                <span class="tm-sidebar-profile-star">★</span>
                                4,8
                                <span class="tm-sidebar-profile-rating-count">(142 avis)</span>
                            </div>

                            <div class="tm-sidebar-profile-status">
                                <span class="tm-sidebar-profile-status-dot">●</span>
                                Compte vérifié
                            </div>
                        </div>
                    </div>
                </div>

                <nav class="tm-sidebar-nav" aria-label="Navigation principale">
                    <a href="#" class="tm-sidebar-link">
                        <span class="tm-sidebar-link-icon">⌂</span>
                        <span>Tableau de bord</span>
                    </a>

                    <a href="#" class="tm-sidebar-link">
                        <span class="tm-sidebar-link-icon">🛡</span>
                        <span>Mes demandes</span>
                    </a>

                    <a href="#" class="tm-sidebar-link">
                        <span class="tm-sidebar-link-icon">🧰</span>
                        <span>Mes prestations</span>
                    </a>

                    <a href="#" class="tm-sidebar-link">
                        <span class="tm-sidebar-link-icon">☆</span>
                        <span>Mes avis</span>
                    </a>

                    <a href="#" class="tm-sidebar-link">
                        <span class="tm-sidebar-link-icon">💳</span>
                        <span>Mes revenus</span>
                    </a>

                    <a href="#" class="tm-sidebar-link">
                        <span class="tm-sidebar-link-icon">🗓</span>
                        <span>Calendrier</span>
                    </a>

                    <a href="#" class="tm-sidebar-link">
                        <span class="tm-sidebar-link-icon">✉</span>
                        <span>Messages</span>
                    </a>

                    <a href="#" class="tm-sidebar-link active" aria-current="page">
                        <span class="tm-sidebar-link-icon">⚙</span>
                        <span>Paramètres</span>
                    </a>

                    <a href="#" class="tm-sidebar-link">
                        <span class="tm-sidebar-link-icon">?</span>
                        <span>Besoin d’aide</span>
                    </a>
                </nav>

                <div class="tm-sidebar-footer-card">
                    <div class="tm-sidebar-footer-gift">🎁</div>
                    <div class="tm-sidebar-footer-title">Parrainez un collègue</div>
                    <div class="tm-sidebar-footer-text">Gagnez 50 € de crédit</div>
                    <button type="button" class="tm-sidebar-footer-btn">
                        Parrainer maintenant
                    </button>
                </div>
            </div>
        </aside>

        <div class="tm-settings-sidebar-backdrop"></div>

        {# ================= CONTENU ================= #}
        <div class="tm-settings-content">
            <button type="button" class="tm-sidebar-toggle d-lg-none" aria-label="Ouvrir la navigation des paramètres">
                ☰
            </button>

            <h1 class="fw-bold mb-1">Paramètres</h1>
            <p class="text-muted mb-4">Gérez votre profil, vos services et vos préférences.</p>

            {# Flash messages #}
            {% for label in ['success', 'warning', 'danger', 'error'] %}
                {% for message in app.flashes(label) %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mb-4" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {# Tabs top nav #}
            <ul class="nav nav-tabs border-bottom gap-2 mb-4" id="settingsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link active"
                        id="profile-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#profile-panel"
                        type="button"
                        role="tab"
                        aria-controls="profile-panel"
                        aria-selected="true"
                    >
                        👤 Mon profil
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="company-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#company-panel"
                        type="button"
                        role="tab"
                        aria-controls="company-panel"
                        aria-selected="false"
                    >
                        🏢 Mon entreprise
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="services-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#services-panel"
                        type="button"
                        role="tab"
                        aria-controls="services-panel"
                        aria-selected="false"
                    >
                        🛠️ Services
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="zones-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#zones-panel"
                        type="button"
                        role="tab"
                        aria-controls="zones-panel"
                        aria-selected="false"
                    >
                        📍 Zones
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="dispo-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#dispo-panel"
                        type="button"
                        role="tab"
                        aria-controls="dispo-panel"
                        aria-selected="false"
                    >
                        📅 Disponibilités
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="notif-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#notif-panel"
                        type="button"
                        role="tab"
                        aria-controls="notif-panel"
                        aria-selected="false"
                    >
                        🔔 Notifications
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="security-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#security-panel"
                        type="button"
                        role="tab"
                        aria-controls="security-panel"
                        aria-selected="false"
                    >
                        🛡️ Sécurité
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="settingsTabsContent">
                {# ================= PROFILE PANEL ================= #}
                <div class="tab-pane fade show active" id="profile-panel" role="tabpanel" aria-labelledby="profile-tab">
                    <div class="row g-4 align-items-start">
                        {# ================= COLONNE GAUCHE ================= #}
                        <div class="col-lg-4 d-flex flex-column gap-4">
                            <div class="card tm-card p-4">
                                <h4 class="tm-card-title mb-4">Informations personnelles</h4>

                                {{ form_start(userForm, {
                                    attr: {
                                        novalidate: 'novalidate',
                                        class: 'tm-form-container',
                                        'data-turbo': 'false'
                                    }
                                }) }}

                                <div class="mb-4 text-center p-3 tm-profile-photo-box">
                                    <label class="form-label d-block text-start mb-3">Photo de profil</label>
                                    <img
                                        src="{{ user.avatar ? asset('uploads/avatars/' ~ user.avatar) : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80' }}"
                                        class="rounded-circle mb-3 shadow-sm"
                                        alt="Avatar"
                                    >
                                    <button type="button" class="btn btn-outline-primary btn-sm d-block mx-auto fw-medium px-3">
                                        Modifier la photo
                                    </button>
                                    <small class="text-muted d-block mt-2 fs-7">PNG, JPG ou GIF. Max 2 Mo.</small>
                                </div>

                                <div class="mb-3 tm-form-row">
                                    {{ form_row(userForm.firstName) }}
                                </div>

                                <div class="mb-3 tm-form-row">
                                    {{ form_row(userForm.lastName) }}
                                </div>

                                <div class="mb-3 tm-form-row">
                                    {{ form_row(userForm.phoneNumber) }}
                                </div>

                                <div class="row mt-4">
                                    <div class="col-12 d-flex justify-content-center">
                                        <button type="submit" class="btn tm-btn-service px-5 py-3 fw-bold col-12 col-md-auto">
                                            Enregistrer les informations personnelles
                                        </button>
                                    </div>
                                </div>

                                {{ form_end(userForm) }}
                            </div>

                            <div class="card tm-card p-4">
                                <h4 class="tm-card-title mb-3">Aperçu de votre profil public</h4>

                                <div class="p-3 border rounded-4 bg-white shadow-sm text-center position-relative overflow-hidden">
                                    {% if user.prestataireProfile and user.prestataireProfile.coverImage %}
                                        <div
                                            class="position-absolute start-0 top-0 w-100 tm-public-cover tm-public-cover--image"
                                            style="background-image: url('{{ asset('uploads/covers/' ~ user.prestataireProfile.coverImage) }}');"
                                        ></div>
                                    {% else %}
                                        <div class="position-absolute start-0 top-0 w-100 tm-public-cover tm-public-cover--fallback"></div>
                                    {% endif %}

                                    <div class="position-relative pt-4">
                                        {% if user.prestataireProfile and user.prestataireProfile.logo %}
                                            <img
                                                src="{{ asset('uploads/logos/' ~ user.prestataireProfile.logo) }}"
                                                class="rounded-circle border-3 border-white shadow-sm mb-2 tm-public-avatar"
                                                alt="Logo entreprise"
                                            >
                                        {% else %}
                                            <img
                                                src="{{ user.avatar ? asset('uploads/avatars/' ~ user.avatar) : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80' }}"
                                                class="rounded-circle border-3 border-white shadow-sm mb-2 tm-public-avatar"
                                                alt="Aperçu avatar"
                                            >
                                        {% endif %}

                                        <h5 class="mb-1 fw-bold text-dark">
                                            {{ user.prestataireProfile.companyName|default(user.firstName ~ ' ' ~ user.lastName) }}
                                            <span class="badge bg-primary ms-1 fs-7">Vérifié</span>
                                        </h5>

                                        <p class="text-muted mb-3 fs-6">
                                            <span class="fw-medium text-dark">
                                                {{ user.prestataireProfile.metier|default('Plombier') }}
                                            </span>
                                            <br>
                                            ⭐
                                            {{ user.prestataireProfile and user.prestataireProfile.averageRating ? user.prestataireProfile.averageRating|number_format(1, ',') : '0' }}
                                            ({{ user.prestataireProfile and user.prestataireProfile.reviewsCount ? user.prestataireProfile.reviewsCount : '0' }} avis)
                                            <br>
                                            <span class="tm-profile-preview-location">
                                                📍 {{ user.prestataireProfile.city|default('Libourne') }} et alentours
                                            </span>
                                        </p>

                                        <a href="#" class="btn btn-outline-secondary btn-sm rounded-3 fw-medium w-100 py-2">
                                            Voir le profil public ↗
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# ================= COLONNE DROITE ================= #}
                        <div class="col-lg-8 d-flex flex-column gap-4">
                            <div class="card tm-card p-4">
                                {{ form_start(publicProfileForm, {
                                    attr: {
                                        novalidate: 'novalidate',
                                        class: 'tm-form-container',
                                        'data-turbo': 'false'
                                    }
                                }) }}

                                <div class="row g-4">
                                    <div class="col-lg-7">
                                        <h4 class="tm-card-title mb-4">À propos de vous</h4>

                                        <div class="mb-3 tm-form-row">
                                            {{ form_row(publicProfileForm.metier) }}
                                        </div>

                                        <div class="mb-3 tm-form-row">
                                            {{ form_row(publicProfileForm.shortDescription) }}
                                        </div>

                                        <div class="mb-3 tm-form-row">
                                            {{ form_row(publicProfileForm.description) }}
                                        </div>

                                        <div class="mb-3 tm-form-row">
                                            {{ form_row(publicProfileForm.experience) }}
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label mb-2">Certifications</label>
                                            <div class="d-flex flex-wrap gap-2 pt-1">
                                                <button type="button" class="btn btn-light btn-md border border-dashed text-primary fw-medium px-3">
                                                    + Ajouter
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-5">
                                        <h4 class="tm-card-title mb-4">Réseaux sociaux & liens</h4>

                                        <div class="mb-3 tm-form-row">
                                            {{ form_row(publicProfileForm.website) }}
                                        </div>

                                        <div class="mb-3 tm-form-row">
                                            {{ form_row(publicProfileForm.facebookUrl) }}
                                        </div>

                                        <div class="mb-3 tm-form-row">
                                            {{ form_row(publicProfileForm.instagramUrl) }}
                                        </div>

                                        <div class="mb-3 tm-form-row">
                                            {{ form_row(publicProfileForm.linkedinUrl) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-12 d-flex justify-content-center">
                                        <button type="submit" class="btn tm-btn-service px-5 py-3 fw-bold col-12 col-md-auto">
                                            Enregistrer le profil public
                                        </button>
                                    </div>
                                </div>

                                {{ form_end(publicProfileForm) }}
                            </div>

                            <div class="row g-4">
                                <div class="col-lg-6">
                                    <div class="card tm-card p-4 h-100">
                                        <h5 class="fw-bold mb-3 fs-5 text-dark">Statut du compte</h5>
                                        <div class="p-3 mb-0 tm-status-box">
                                            <div class="fw-bold small tm-status-success">✓ Compte vérifié</div>
                                            <div class="fs-7 text-muted mt-1">Félicitations ! Votre compte est validé.</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="card tm-card p-4 h-100">
                                        <h5 class="fw-bold mb-2 fs-5 text-dark">Note moyenne</h5>

                                        <div class="d-flex align-items-baseline gap-2">
                                            <span class="display-5 fw-bold text-dark">
                                                {{ user.prestataireProfile and user.prestataireProfile.averageRating ? user.prestataireProfile.averageRating|number_format(1, ',') : '0' }}
                                            </span>
                                            <span class="text-muted fs-5">/ 5</span>
                                        </div>

                                        <div class="my-2 fs-4 tm-rating-stars">
                                            {% if user.prestataireProfile and user.prestataireProfile.averageRating %}
                                                {% for i in 1..5 %}
                                                    {{ i <= user.prestataireProfile.averageRating ? '★' : '☆' }}
                                                {% endfor %}
                                            {% else %}
                                                ☆☆☆☆☆
                                            {% endif %}
                                        </div>

                                        <small class="text-muted fw-medium">
                                            ({{ user.prestataireProfile and user.prestataireProfile.reviewsCount ? user.prestataireProfile.reviewsCount : '0' }} avis)
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ================= ENTREPRISE ================= #}
                <div class="tab-pane fade" id="company-panel" role="tabpanel" aria-labelledby="company-tab">
                    {{ include('settings/_prestataire_company_tab.html.twig', {
                        companyForm: companyForm,
                        user: user
                    }) }}
                </div>

                {# ================= SERVICES ================= #}
                <div class="tab-pane fade" id="services-panel" role="tabpanel" aria-labelledby="services-tab">
                    {{ include('settings/_prestataire_services_tab.html.twig') }}
                </div>

                {# ================= ZONES ================= #}
                <div class="tab-pane fade" id="zones-panel" role="tabpanel" aria-labelledby="zones-tab">
                    {{ include('settings/_prestataire_zone_tab.html.twig', {
                        zoneForm: zoneForm,
                        zones: zones,
                        user: user
                    }) }}
                </div>

                {# ================= AUTRES TABS ================= #}
                <div class="tab-pane fade" id="dispo-panel" role="tabpanel" aria-labelledby="dispo-tab">
                    <div class="card tm-card p-4">
                        <h4>📅 Disponibilités</h4>
                        <p class="text-muted mb-0">Contenu à venir.</p>
                    </div>
                </div>

                <div class="tab-pane fade" id="notif-panel" role="tabpanel" aria-labelledby="notif-tab">
                    <div class="card tm-card p-4">
                        <h4>🔔 Notifications</h4>
                        <p class="text-muted mb-0">Contenu à venir.</p>
                    </div>
                </div>

                <div class="tab-pane fade" id="security-panel" role="tabpanel" aria-labelledby="security-tab">
                    <div class="card tm-card p-4">
                        <h4>🛡️ Sécurité</h4>
                        <p class="text-muted mb-0">Contenu à venir.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    function activateTabFromHash() {
        const hash = window.location.hash;
        if (!hash) return;

        const trigger = document.querySelector(`#settingsTabs [data-bs-target="${hash}"]`);
        if (trigger) {
            bootstrap.Tab.getOrCreateInstance(trigger).show();
        }
    }

    function bindTabs() {
        const triggers = document.querySelectorAll('#settingsTabs [data-bs-toggle="tab"]');

        triggers.forEach(trigger => {
            if (trigger.dataset.tabBound === 'true') return;
            trigger.dataset.tabBound = 'true';

            trigger.addEventListener('shown.bs.tab', function (event) {
                const target = event.target.getAttribute('data-bs-target');
                if (target) {
                    history.replaceState(null, '', target);
                }
            });
        });
    }

    function bindSidebar() {
        const sidebar = document.querySelector('.tm-settings-sidebar');
        const backdrop = document.querySelector('.tm-settings-sidebar-backdrop');
        const toggle = document.querySelector('.tm-sidebar-toggle');

        if (toggle && !toggle.dataset.sidebarBound) {
            toggle.dataset.sidebarBound = 'true';

            toggle.addEventListener('click', function () {
                if (!sidebar) return;

                sidebar.classList.toggle('is-open');

                if (backdrop) {
                    backdrop.classList.toggle('is-visible');
                }
            });
        }

        if (backdrop && !backdrop.dataset.backdropBound) {
            backdrop.dataset.backdropBound = 'true';

            backdrop.addEventListener('click', function () {
                if (sidebar) {
                    sidebar.classList.remove('is-open');
                }
                backdrop.classList.remove('is-visible');
            });
        }
    }

    function initSettingsPage() {
        bindTabs();
        bindSidebar();
        activateTabFromHash();
    }

    document.addEventListener('DOMContentLoaded', initSettingsPage);
    document.addEventListener('turbo:load', initSettingsPage);
    window.addEventListener('hashchange', activateTabFromHash);
})();
</script>
{% endblock %}