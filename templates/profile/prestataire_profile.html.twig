{% extends 'base.html.twig' %}

{% block title %}Paramètres - TrouveMoi{% endblock %}

{% block body %}
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

	<div class="container-fluid min-vh-100 p-0" style="background-color: #f8fafc;">
		{# Le conteneur parent DOIT imposer le Flex Row sur desktop #}
		<div class="d-flex flex-column flex-md-row min-vh-100 align-items-stretch">

			{# 1. Navigation Mobile (Haute) - Reste inchangée #}
			<div class="w-100 p-3 d-flex justify-content-between align-items-center d-md-none" style="background-color: #1e1b4b; border-bottom: 1px solid rgba(255,255,255,0.1); z-index: 999;">
				<div class="d-flex align-items-center gap-2">
					<span class="fs-4 fw-bold" style="color: var(--tm-accent);">🔍 TrouveMoi</span>
				</div>
				<div class="d-flex gap-3 tm-mobile-nav">
					<a href="#" class="text-white text-decoration-none fs-5">📋</a>
					<a href="#" class="text-white text-decoration-none fs-5">📥</a>
					<a href="#" class="text-white text-decoration-none fs-5">⭐</a>
					<a href="#" class="text-white text-decoration-none fs-5 active-mobile">⚙️</a>
				</div>
			</div>

			{# 2. La VRAIE Sidebar Desktop (On blinde le style en ligne pour bypasser ton CSS cassé) #}
			<div class="d-none d-md-flex flex-column justify-content-between p-4" 
				 style="width: 280px !important; min-width: 280px !important; max-width: 280px !important; 
						background-color: #1e1b4b !important; height: 100vh !important; 
						position: sticky !important; top: 0 !important; flex-shrink: 0 !important; z-index: 100;">
				<div>
					<div class="mb-4 d-flex align-items-center gap-2">
						<span class="fs-4 fw-bold" style="color: #f4a911;">🔍 TrouveMoi</span>
						<span class="badge px-2 py-1" style="background-color: rgba(255,255,255,0.1); color: #f4a911; font-size: 10px;">Pro</span>
					</div>

					{# Bloc Profil interne réajusté pour ne plus baigner dans le blanc #}
					<div class="text-center mb-4 p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.05);">
						<div class="position-relative d-inline-block mb-2">
							<img src="{{ user.avatar ? asset('uploads/avatars/' ~ user.avatar) : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80' }}" class="rounded-circle border-2 shadow-sm" style="width: 65px; height: 65px; object-fit: cover; border-color: #f4a911 !important;" alt="Avatar">
						</div>
						<h6 class="mb-0 text-white fw-semibold fs-6">{{ user.firstName }} {{ user.lastName }}</h6>
						<p class="mb-2 small" style="color: #cbd5e1;">{{ user.prestataireProfile.metier|default('Plombier') }}</p>
						<span class="badge d-inline-flex align-items-center gap-1 px-2 py-1" style="background-color: rgba(22, 163, 74, 0.2); color: #4ade80; font-size: 11px;">
							✓ Vérifié
						</span>
					</div>

					{# Menu avec forçage de couleur des liens pour éviter le texte blanc invisible #}
					<ul class="nav flex-column gap-1">
						<li class="nav-item">
							<a href="#" class="nav-link py-2 text-white-50 text-decoration-none d-flex align-items-center rounded px-2" style="font-size: 14px;">
								<span class="me-2">📋</span> Tableau de bord
							</a>
						</li>
						<li class="nav-item">
							<a href="#" class="nav-link py-2 text-white-50 text-decoration-none d-flex align-items-center rounded px-2" style="font-size: 14px;">
								<span class="me-2">📥</span> Mes demandes
							</a>
						</li>
						<li class="nav-item">
							<a href="#" class="nav-link py-2 text-white-50 text-decoration-none d-flex align-items-center rounded px-2" style="font-size: 14px;">
								<span class="me-2">💼</span> Mes prestations
							</a>
						</li>
						<li class="nav-item">
							<a href="#" class="nav-link py-2 text-white-50 text-decoration-none d-flex align-items-center rounded px-2" style="font-size: 14px;">
								<span class="me-2">⭐</span> Mes avis
							</a>
						</li>
						<li class="nav-item">
							<a href="#" class="nav-link py-2 text-white text-decoration-none d-flex align-items-center rounded px-2 fw-medium" style="font-size: 14px; background-color: #f4a911; color: #1e1b4b !important;">
								<span class="me-2">⚙️</span> Paramètres
							</a>
						</li>
					</ul>
				</div>

				<div class="card border-0 p-3 rounded-3 text-center mt-3" style="background-color: rgba(244, 169, 17, 0.08); border: 1px solid rgba(244, 169, 17, 0.15) !important;">
					<p class="fw-medium text-white mb-2" style="font-size: 12px;">🎁 Parrainez et gagnez <span style="color: #f4a911; font-weight: 700;">50€</span></p>
					<button class="btn btn-sm w-100 fw-semibold" style="font-size: 11px; background-color: #f4a911; color: #1e1b4b;">Inviter</button>
				</div>
			</div>

			{# 3. Zone de contenu de Droite - Forcée à prendre TOUT le reste de la place #}
			<div class="grow p-3 p-md-5" style="min-width: 0; overflow-x: hidden;">

				<div class="mb-4 mb-md-5">
					<h1 class="fw-bold tm-main-title mb-1">Paramètres</h1>
					<p class="tm-subtitle mb-0">Gérez votre profil, vos informations et vos préférences</p>
				</div>

				{# Alertes Flash #}
				{% for message in app.flashes('success') %}
					<div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4 fw-medium" role="alert">
						✨ {{ message }}
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				{% endfor %}

				<div class="tm-tabs-wrapper mb-4 mb-md-5">
					<ul class="nav nav-tabs border-bottom gap-3 gap-md-4 tm-custom-tabs flex-nowrap" id="settingsTabs" role="tablist">
						<li class="nav-item">
							<button class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-panel" type="button" role="tab">👤&nbsp;Mon&nbsp;profil</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="company-tab" data-bs-toggle="tab" data-bs-target="#company-panel" type="button" role="tab">🏢&nbsp;Mon&nbsp;entreprise</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="services-tab" data-bs-toggle="tab" data-bs-target="#services-panel" type="button" role="tab">🛠&nbsp;Services</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="zones-tab" data-bs-toggle="tab" data-bs-target="#zones-panel" type="button" role="tab">📍&nbsp;Zones</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="dispo-tab" data-bs-toggle="tab" data-bs-target="#dispo-panel" type="button" role="tab">📅&nbsp;Disponibilités</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="notif-tab" data-bs-toggle="tab" data-bs-target="#notif-panel" type="button" role="tab">🔔&nbsp;Notifications</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security-panel" type="button" role="tab">🛡&nbsp;Sécurité</button>
						</li>
					</ul>
				</div>

				{{ form_start(settingsForm, {'attr': {'novalidate': 'novalidate'}}) }}

				<div class="tab-content" id="settingsTabsContent">
					<div class="tab-pane fade show active" id="profile-panel" role="tabpanel">
						{{ include('settings/_prestataire_profile_tab.html.twig') }}
					</div>

					<div class="tab-pane fade" id="company-panel" role="tabpanel">
						{{ include('settings/_prestataire_company_tab.html.twig') }}
					</div>

					<div class="tab-pane fade" id="services-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4>🛠️ Vos Services</h4>
							<p class="text-muted fs-5">Configuration des prestations...</p>
						</div>
					</div>
					<div class="tab-pane fade" id="zones-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4>📍 Zones d'intervention</h4>
							<p class="text-muted fs-5">Gestion des rayons...</p>
						</div>
					</div>
					<div class="tab-pane fade" id="dispo-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4>📅 Vos Disponibilités</h4>
							<p class="text-muted fs-5">Calendrier d'ouverture...</p>
						</div>
					</div>
					<div class="tab-pane fade" id="notif-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4>🔔 Vos Notifications</h4>
							<p class="text-muted fs-5">Préférences d'alertes...</p>
						</div>
					</div>
					<div class="tab-pane fade" id="security-panel" role="tabpanel">
						<div class="card tm-card p-4">
							<h4>🛡️ Sièges & Sécurité</h4>
							<p class="text-muted fs-5">Changement de mot de passe...</p>
						</div>
					</div>
				</div>
				{{ form_end(settingsForm) }}
			</div>
		</div>
	</div>
{% endblock %}