{% extends 'base.html.twig' %}

{% block title %}Paramètres Client - TrouveMoi
{% endblock %}

{% block body %}
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkR4j8tbtPom9A1z+0ItcQYfL0WLaRZ/7k8w==" crossorigin="anonymous" referrerpolicy="no-referrer"/>

	<div class="container-fluid p-0 tm-cp-page-wrapper" data-controller="client-profile">
		<div
			class="d-flex flex-column flex-md-row align-items-stretch">
			{{ include('profile/_client_sidebar.html.twig', { user: user }) }}

			{# Contenu Principal #}
			<div class="grow p-3 p-md-5 tm-cp-main-content-inner">

				<div class="mb-4 mb-md-5">
					<h1 class="fw-bold tm-cp-main-title mb-1">Mon Compte</h1>
					<p class="tm-cp-subtitle mb-0">Gérer vos coordonnées personnelles, vos adresses et la sécurité de votre compte</p>
				</div>

				{# Alertes Flash #}
				{% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
					{% set alertClass = {
						success: 'alert-success',
						danger: 'alert-danger',
						warning: 'alert-warning',
						info: 'alert-info'
					}[type]|default('alert-secondary') %}
					{% set iconClass = {
						success: 'fa-circle-check',
						danger: 'fa-circle-xmark',
						warning: 'fa-triangle-exclamation',
						info: 'fa-circle-info'
					}[type]|default('fa-circle-info') %}

					{% for message in messages %}
						<div class="alert {{ alertClass }} alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4 fw-medium" role="alert">
							<i class="fa-solid {{ iconClass }} me-2" aria-hidden="true"></i>
							{% if message is iterable and message.title is defined %}
								<div>{{ message.title }}</div>
								{% if message.items is defined and message.items is iterable and message.items is not empty %}
									<ul class="mb-0 mt-2 ps-4">
										{% for item in message.items %}
											<li>{{ item }}</li>
										{% endfor %}
									</ul>
								{% endif %}
							{% else %}
								{{ message }}
							{% endif %}
							<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
						</div>
					{% endfor %}
				{% endfor %}

				<div class="tm-cp-tabs-wrapper mb-4 mb-md-5">
					<ul class="nav nav-tabs border-bottom gap-3 gap-md-4 tm-cp-custom-tabs flex-nowrap" id="clientTabs" role="tablist">
						<li class="nav-item">
							<button class="nav-link {{ activeTab == 'personal' ? 'active' : '' }}" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal-panel" type="button" role="tab" aria-selected="{{ activeTab == 'personal' ? 'true' : 'false' }}">
								<i class="fa-regular fa-user me-2"></i>Informations
							</button>
						</li>
						<li class="nav-item">
							<button class="nav-link {{ activeTab == 'addresses' ? 'active' : '' }}" id="addresses-tab" data-bs-toggle="tab" data-bs-target="#addresses-panel" type="button" role="tab" aria-selected="{{ activeTab == 'addresses' ? 'true' : 'false' }}">
								<i class="fa-solid fa-location-dot me-2"></i>Mes Adresses
							</button>
						</li>
						<li class="nav-item">
							<button class="nav-link {{ activeTab == 'notif' ? 'active' : '' }}" id="notif-tab" data-bs-toggle="tab" data-bs-target="#notif-panel" type="button" role="tab" aria-selected="{{ activeTab == 'notif' ? 'true' : 'false' }}">
								<i class="fa-regular fa-bell me-2"></i>Notifications
							</button>
						</li>
						<li class="nav-item">
							<button class="nav-link {{ activeTab == 'security' ? 'active' : '' }}" id="security-tab" data-bs-toggle="tab" data-bs-target="#security-panel" type="button" role="tab" aria-selected="{{ activeTab == 'security' ? 'true' : 'false' }}">
								<i class="fa-solid fa-shield-halved me-2"></i>Sécurité
							</button>
						</li>
					</ul>
				</div>

				{{ form_start(settingsForm, {attr: {novalidate: 'novalidate'}}) }}

				<div
					class="tab-content" id="clientTabsContent">

					{# Panel Informations #}
					<div class="tab-pane fade {{ activeTab == 'personal' ? 'show active' : '' }}" id="personal-panel" role="tabpanel">
						<div class="row g-4">
							<div class="col-lg-8">
								<div class="card tm-cp-card p-4 h-100 d-flex flex-column justify-content-between">
									<div>
										<h4 class="tm-cp-card-title mb-4">Informations personnelles</h4>

										<div class="row g-3">
											<div class="col-md-6 tm-cp-form-row">
												{{ form_row(settingsForm.firstName) }}
											</div>
											<div class="col-md-6 tm-cp-form-row">
												{{ form_row(settingsForm.lastName) }}
											</div>
											<div class="col-md-6 tm-cp-form-row">
												{{ form_row(settingsForm.phoneNumber) }}
											</div>
											<div class="col-md-6 tm-cp-form-row tm-cp-enum-radio-group" id="client-type-field" data-client-profile-target="typeField" data-action="change->client-profile#toggleProFields">
												{{ form_row(settingsForm.clientProfile.type) }}
											</div>
										</div>

										<div id="pro-fields-wrapper" class="row g-3 mt-2 pt-3 border-top tm-cp-pro-fields-wrapper" data-client-profile-target="proFieldsWrapper">
											<h5 class="fw-semibold text-primary mb-2 fs-6">Détails de l'entreprise</h5>
											<div class="col-md-6 tm-cp-form-row">
												{{ form_row(settingsForm.clientProfile.companyName) }}
											</div>
											<div class="col-md-6 tm-cp-form-row">
												{{ form_row(settingsForm.clientProfile.siret) }}
											</div>
										</div>
									</div>

									<div class="mt-4 pt-3 d-flex justify-content-md-start justify-content-center">
										<button type="submit" class="btn tm-cp-btn-service px-4 py-2.5 fw-bold text-nowrap">
											Enregistrer les modifications
										</button>
									</div>
								</div>
							</div>

							<div class="col-lg-4">
								<div class="card tm-cp-card p-4 text-center h-100">
									<h4 class="tm-cp-card-title text-start mb-4">Photo de profil</h4>
									<div class="my-auto p-4 rounded-4 tm-cp-avatar-container">
										<img src="{{ user.avatar ? asset('uploads/avatars/' ~ user.avatar) : 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=100&q=80' }}" class="rounded-circle mb-3 border-2 border-white shadow-sm tm-cp-avatar-preview" alt="Avatar">
										<button type="button" class="btn btn-outline-primary btn-md d-block mx-auto fw-medium px-3">
											Modifier la photo
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>

					{# Panel Adresses #}
					<div class="tab-pane fade {{ activeTab == 'addresses' ? 'show active' : '' }}" id="addresses-panel" role="tabpanel">
						<div class="row g-4">
							<div class="col-12">
								<div class="card tm-cp-card p-4">
									<h4 class="tm-cp-card-title mb-4">
										<i class="fa-solid fa-location-dot me-2"></i>Adresse principale (Lieu des interventions)
									</h4>
									<div class="row g-3">
										<div class="col-md-6 col-lg-6 tm-cp-form-row">
											{{ form_row(settingsForm.clientProfile.defaultAddress) }}
										</div>
										<div class="col-md-3 col-lg-3 tm-cp-form-row">
											{{ form_row(settingsForm.clientProfile.defaultPostalCode) }}
										</div>
										<div class="col-md-3 col-lg-3 tm-cp-form-row">
											{{ form_row(settingsForm.clientProfile.defaultCity) }}
										</div>
									</div>
								</div>
							</div>

							<div class="col-12">
								<div class="card tm-cp-card p-4">
									<h4 class="tm-cp-card-title mb-4">
										<i class="fa-regular fa-file-lines me-2"></i>Adresse de facturation
									</h4>
									<div class="row g-3">
										<div class="col-md-5 col-lg-5 tm-cp-form-row">
											{{ form_row(settingsForm.clientProfile.billingAddress) }}
										</div>
										<div class="col-md-2 col-lg-2 tm-cp-form-row">
											{{ form_row(settingsForm.clientProfile.billingPostalCode) }}
										</div>
										<div class="col-md-3 col-lg-3 tm-cp-form-row">
											{{ form_row(settingsForm.clientProfile.billingCity) }}
										</div>
										<div class="col-md-2 col-lg-2 tm-cp-form-row">
											{{ form_row(settingsForm.clientProfile.billingCountry) }}
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="mt-4 d-flex justify-content-md-start justify-content-center">
							<button type="submit" class="btn tm-cp-btn-service px-4 py-2.5 fw-bold text-nowrap">
								Enregistrer les adresses
							</button>
						</div>
					</div>

					{{ form_end(settingsForm) }}

					<div class="tab-pane fade {{ activeTab == 'notif' ? 'show active' : '' }}" id="notif-panel" role="tabpanel">
						{{ include('settings/_client_notifications_tab.html.twig', {
							notificationForm: notificationForm
						}) }}
					</div>

					<div class="tab-pane fade {{ activeTab == 'security' ? 'show active' : '' }}" id="security-panel" role="tabpanel">
						<div class="row g-4">
							<div class="col-xl-7">
								<div class="card tm-cp-card p-4 h-100">
									<h4 class="tm-cp-card-title mb-4">Changer le mot de passe</h4>
									{{ form_start(passwordForm, {attr: {novalidate: 'novalidate'}}) }}
										<div class="row g-3">
											<div class="col-12 tm-cp-form-row">
												{{ form_row(passwordForm.currentPassword) }}
											</div>
											<div class="col-md-6 tm-cp-form-row">
												{{ form_row(passwordForm.plainPassword.first) }}
											</div>
											<div class="col-md-6 tm-cp-form-row">
												{{ form_row(passwordForm.plainPassword.second) }}
											</div>
										</div>
										<div class="mt-4 d-flex justify-content-md-start justify-content-center">
											<button type="submit" class="btn tm-cp-btn-service px-4 py-2.5 fw-bold text-nowrap">
												Mettre à jour le mot de passe
											</button>
										</div>
									{{ form_end(passwordForm) }}
								</div>
							</div>

							<div class="col-xl-5">
								<div class="card tm-cp-card p-4 border-danger-subtle">
									<h4 class="tm-cp-card-title mb-3 text-danger">Désinscription</h4>
									<p class="text-muted mb-4">Votre compte sera désactivé par soft delete et vous serez immédiatement déconnecté.</p>
									{{ form_start(deletionForm, {attr: {novalidate: 'novalidate'}}) }}
										<div class="row g-3">
											<div class="col-12 tm-cp-form-row">
												{{ form_row(deletionForm.currentPassword) }}
											</div>
											<div class="col-12 tm-cp-form-row">
												{{ form_row(deletionForm.confirmation) }}
											</div>
										</div>
										<div class="mt-4 d-flex justify-content-md-start justify-content-center">
											<button type="submit" class="btn btn-outline-danger px-4 py-2 rounded-3 fw-semibold text-nowrap">
												Se désinscrire
											</button>
										</div>
									{{ form_end(deletionForm) }}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
