{# NAVBAR #}
<nav class="navbar navbar-expand-xl navbar-dark sticky-top tm-navbar tm-navbar--v2"
     data-controller="navbar"
     data-navbar-autocomplete-url-value="{{ path('app_search_autocomplete') }}">

    <div class="container tm-navbar__container tm-navbar__container--v2">

        {# LIGNE 1 #}
        <div class="tm-navbar__topline">

            <div class="tm-navbar__topline-left">
                <a class="navbar-brand tm-navbar__brand" href="{{ path('app_home') }}">
                    <img src="{{ asset('images/logo_trouvemoipresta.png') }}"
                         alt="Logo TrouveMoi"
                         class="tm-navbar__brand-logo">
                </a>

                <div class="tm-navbar__search tm-navbar__search--desktop">
                    <div class="tm-navbar__search-wrap">
                        <input type="text"
                               class="form-control tm-navbarsearch-input"
                               placeholder="Rechercher un prestataire..."
                               data-navbar-target="input"
                               data-action="input->navbar#onInput focus->navbar#onInput" />
                        <div class="tm-navbarsearch-results d-none"
                             data-navbar-target="results desktopResults"></div>
                        <span class="tm-navbar__search-icon">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                    </div>
                </div>
            </div>

            <div class="tm-navbar__topline-right">
                {% if not app.user %}
                    <a class="nav-link tm-navbar__link tm-navbar__link--icon tm-navbar__top-action d-none d-xl-inline-flex"
                       href="{{ path('app_login') }}">
                        <i class="fa-regular fa-user"></i>
                        <span>Connexion</span>
                    </a>
                {% endif %}

                {% if app.user %}
                    <div class="nav-item dropdown d-none d-xl-block">
                        <a class="nav-link dropdown-toggle tm-navbar__link tm-navbar__link--account tm-navbar__top-action"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="fa-solid fa-circle-user"></i>
                            <span>Mon Compte</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end tm-navbar__dropdown">
                            <li>
                                <span class="dropdown-item-text tm-navbar__dropdown-text">
                                    {{ app.user.email }}
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>

                            {% if is_granted('ROLE_PRESTATAIRE') %}
                                <li>
                                    <a class="dropdown-item tm-navbar__dropdown-link tm-navbar__dropdown-link--primary"
                                       href="{{ path('app_prestataire_dashboard') }}">
                                        <i class="fa-solid fa-gauge me-2"></i>Espace Pro
                                    </a>
                                </li>
                            {% elseif is_granted('ROLE_CLIENT') %}
                                <li>
                                    <a class="dropdown-item tm-navbar__dropdown-link"
                                       href="{{ path('app_quote_request_index') }}">
                                        <i class="fa-solid fa-file-invoice me-2"></i>Mes Demandes
                                    </a>
                                </li>
                            {% endif %}

                            <li>
                                <a class="dropdown-item tm-navbar__dropdown-link"
                                   href="{{ is_granted('ROLE_PRESTATAIRE') ? path('app_prestataire_settings') : path('app_client_settings') }}">
                                    <i class="fa-solid fa-gear me-2"></i>Paramètres
                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item tm-navbar__dropdown-link tm-navbar__dropdown-link--danger"
                                   href="{{ path('app_logout') }}">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i>Déconnexion
                                </a>
                            </li>
                        </ul>
                    </div>
                {% endif %}

                {% if app.user and is_granted('ROLE_PRESTATAIRE') %}
                    <a class="btn tm-navbar__btn-cta d-none d-xl-inline-flex"
                       href="{{ path('app_prestataire_service_new') }}">
                        <i class="fa-solid fa-briefcase me-2"></i>Proposer une prestation
                    </a>
                {% endif %}

                {% if app.user %}
                    <div class="nav-item dropdown d-none d-xl-block"
                         data-controller="realtime-notifications"
                         data-realtime-notifications-url-value="http://localhost:3001"
                         data-realtime-notifications-user-id-value="{{ app.user.id }}"
                         data-realtime-notifications-event-name-value="notification_created"
                         data-realtime-notifications-join-event-name-value="join_user"
                         data-realtime-notifications-max-items-value="5"
                         data-realtime-notifications-mark-read-url-pattern-value="/notifications/__ID__/read">

                        <a class="nav-link tm-navbarlink tm-navbar__notif-trigger position-relative"
                           href="#"
                           id="tmNavbarNotificationsDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           data-bs-auto-close="outside"
                           aria-expanded="false">
                            <i class="bi bi-bell-fill"></i>

                            <span data-realtime-notifications-target="badge"
                                  data-count-value="{{ navbarUnreadNotificationCount }}"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger tm-navbar-notification-badge {{ navbarUnreadNotificationCount > 0 ? '' : 'd-none' }}">
                                {{ navbarUnreadNotificationCount > 99 ? '99+' : navbarUnreadNotificationCount }}
                                <span class="visually-hidden">notifications non lues</span>
                            </span>
                        </a>

                        <div class="dropdown-menu dropdown-menu-end tm-navbardropdown tm-navbar-notification-menu"
                             aria-labelledby="tmNavbarNotificationsDropdown">

                            <div class="tm-navbar-notification-menu__head">
                                <div>
                                    <div class="tm-navbar-notification-menu__title">Notifications</div>
                                    <div class="tm-navbar-notification-menu__count"
                                         data-realtime-notifications-target="countText"
                                         data-count-value="{{ navbarUnreadNotificationCount }}">
                                        {{ navbarUnreadNotificationCount }}
                                        non lue{{ navbarUnreadNotificationCount > 1 ? 's' : '' }}
                                    </div>
                                </div>
                            </div>

                            <div class="tm-navbar-notification-menu__list"
                                 data-realtime-notifications-target="list">
                                {% if navbarLatestNotifications is not empty %}
                                    {% for notification in navbarLatestNotifications %}
                                        <form method="post"
                                              action="{{ path('app_notification_mark_read', {id: notification.id}) }}"
                                              data-notification-item>
                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('mark-notification-read-' ~ notification.id) }}">

                                            <button type="submit"
                                                    class="dropdown-item tm-navbardropdown-link tm-navbar-notification-item {{ not notification.isRead ? 'tm-navbar-notification-item--unread' : '' }}">
                                                <div class="tm-navbar-notification-item__indicator"></div>

                                                <div class="tm-navbar-notification-item__body">
                                                    <div class="tm-navbar-notification-item__top">
                                                        <span class="tm-navbar-notification-title">
                                                            {{ notification.title }}
                                                        </span>
                                                        <span class="tm-navbar-notification-date">
                                                            {{ notification.createdAt|date('d/m/Y H:i') }}
                                                        </span>
                                                    </div>

                                                    <div class="tm-navbar-notification-content">
                                                        {{ notification.body|length > 100 ? notification.body|slice(0, 100) ~ '…' : notification.body }}
                                                    </div>

                                                    {% if not notification.isRead %}
                                                        <span class="tm-navbar-notification-item__badge">Non lue</span>
                                                    {% endif %}
                                                </div>
                                            </button>
                                        </form>
                                    {% endfor %}
                                {% endif %}
                            </div>

                            <div class="tm-navbar-notification-empty {{ navbarLatestNotifications is not empty ? 'd-none' : '' }}"
