                                <i class="bi bi-bell-slash"></i>
                                <span>Aucune notification pour le moment.</span>
                            </div>

                            <div class="tm-navbar-notification-menu__footer">
                                <a href="{{ path('app_notification_index') }}"
                                   class="tm-navbar-notification-action tm-navbar-notification-action--secondary">
                                    Voir toutes les notifications
                                </a>

                                <form method="post" action="{{ path('app_notification_mark_all_read') }}">
                                    <input type="hidden"
                                           name="_token"
                                           value="{{ csrf_token('mark-all-notifications-read') }}">
                                    <input type="hidden" name="redirect" value="{{ app.request.uri }}">
                                    <button type="submit"
                                            class="tm-navbar-notification-action tm-navbar-notification-action--primary">
                                        Tout marquer comme lu
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
