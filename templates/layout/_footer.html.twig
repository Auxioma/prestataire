<footer class="tmv2-footer" data-controller="footer">
    <div class="container-fluid px-md-5">
        <div class="tmv2-footer__top row justify-content-xl-between pt-4 gy-5">

            {# Colonne 1 : Logo #}
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="tmv2-footer__brand">
                    <a class="tmv2-footer__logo-link" href="{{ path('app_home') }}" aria-label="TrouveMoi.com">
                        <img src="{{ asset('images/logo_trouvemoipresta.png') }}"
                             alt="Logo TrouveMoi"
                             class="tmv2-footer__logo-image">
                    </a>
                </div>

                <p class="tmv2-footer__baseline">
                    La plateforme qui connecte les clients avec les meilleurs professionnels.
                </p>

                <div class="tmv2-footer__socials">
                    {% for icon in ['facebook-f', 'instagram', 'linkedin-in'] %}
                        <a href="#"
                           class="tmv2-footer__social-btn"
                           aria-label="{{ icon }}">
                            <i class="fa-brands fa-{{ icon }}"></i>
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Colonnes Listes #}
            {% set footer_links = {
                'Pour les particuliers': [
                    {label: 'Comment ça marche ?', slug: 'comment-ca-marche'},
                    {label: 'Demander un devis', slug: 'demander-un-devis'},
                    {label: 'Aide & FAQ', slug: 'aide-faq'},
                ],
                'Pour les prestataires': [
                    {label: 'Inscription prestataire', slug: 'inscription-prestataire'},
                    {label: 'Espace prestataire', slug: 'espace-prestataire'},
                    {label: 'Avantages', slug: 'avantages'},
                    {label: 'Ressources', slug: 'ressources'},
                ],
                'Informations': [
                    {label: 'À propos de nous', slug: 'about'},
                    {label: 'CGU', slug: 'cgu'},
                    {label: 'Politique de confidentialité', slug: 'privacy'},
                    {label: 'Mentions légales', slug: 'legal'},
                    {label: "Besoin d'aide ?", slug: 'help', class: 'tmv2-footer__link--highlight'},
                ],
            } %}

            {% for title, links in footer_links %}
                <div class="col-xl-auto col-lg-2 col-md-6 col-12">
                    <div class="tmv2-footer__col">
                        <h3 class="tmv2-footer__title">{{ title }}</h3>
                        <ul class="tmv2-footer__links">
                            {% for link in links %}
                                <li>
                                    <a href="{{ path('app_static_page', {slug: link.slug}) }}"
                                       class="tmv2-footer__link {{ link.class|default('') }}">
                                        {{ link.label }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endfor %}

            {# Contact #}
            <div class="col-xl-2 col-lg-3 col-md-6 col-12">
                <div class="tmv2-footer__contact-wrap">
                    <h3 class="tmv2-footer__title">Besoin d'aide ?</h3>
                    <ul class="tmv2-footer__contact">
                        <li>
                            <i class="fa-solid fa-phone"></i>
                            <span>01 84 80 52 98</span>
                        </li>
                        <li>
                            <i class="fa-regular fa-envelope"></i>
                            <span>contact@trouvemoi.com</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="tmv2-footer__bottom">
            <p class="tmv2-footer__copyright">
                &copy; {{ 'now'|date('Y') }} TrouveMoi.com - Tous droits réservés
            </p>

            <div class="tmv2-footer__madein">
                <span>
                    Fait avec <i class="fa-solid fa-heart tmv2-footer__heart"></i> en France
                </span>
                <span class="tmv2-footer__flag" aria-hidden="true"></span>
            </div>
        </div>
    </div>
</footer>