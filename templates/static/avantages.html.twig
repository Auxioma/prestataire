{% extends 'base.html.twig' %}

{% block title %}Les avantages de TrouveMoi.com{% endblock %}

{% block json_ld %}{% endblock %}

{% block body %}
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Accueil</a></li>
                <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Avantages</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <!-- Hero Header -->
    <div class="text-center mb-5 tm-static-max-w-800 mx-auto">
        <h1 class="display-5 fw-bold tm-static-brand-title mb-3">Les avantages de <span class="text-primary">TrouveMoi.com</span></h1>
        <p class="text-muted fs-5">
            Une plateforme simple, sécurisée et efficace pour développer votre activité<br>
            et trouver les meilleures prestations près de chez vous.
        </p>
    </div>

    <!-- Grille des Avantages (2 colonnes sur tablette/desktop) -->
    <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
        
        {# Avantage 1 #}
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-row gap-4 align-items-start">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="fa-solid fa-eye fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Visibilité maximale</h2>
                    <hr class="my-2 bg-primary border-0 opacity-100" style="width: 30px; height: 2px;">
                    <p class="text-muted small mb-0">Gagnez en visibilité auprès de milliers de clients chaque jour partout en France.</p>
                </div>
            </div>
        </div>

        {# Avantage 2 #}
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-row gap-4 align-items-start">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="fa-solid fa-bullseye fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Des demandes ciblées</h2>
                    <hr class="my-2 bg-primary border-0 opacity-100" style="width: 30px; height: 2px;">
                    <p class="text-muted small mb-0">Recevez des demandes de devis correspondant à vos services et à votre zone d'intervention.</p>
                </div>
            </div>
        </div>

        {# Avantage 3 #}
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-row gap-4 align-items-start">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="fa-solid fa-lock-keyhole fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Paiements sécurisés</h2>
                    <hr class="my-2 bg-primary border-0 opacity-100" style="width: 30px; height: 2px;">
                    <p class="text-muted small mb-0">Soyez payé en toute sécurité grâce à notre système de paiement fiable et protégé.</p>
                </div>
            </div>
        </div>

        {# Avantage 4 #}
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-row gap-4 align-items-start">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="fa-solid fa-chart-line fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Développez votre activité</h2>
                    <hr class="my-2 bg-primary border-0 opacity-100" style="width: 30px; height: 2px;">
                    <p class="text-muted small mb-0">Plus de clients, plus de missions, plus de chiffre d'affaires. Nous vous aidons à grandir.</p>
                </div>
            </div>
        </div>

        {# Avantage 5 #}
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-row gap-4 align-items-start">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="fa-regular fa-clock fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Gain de temps</h2>
                    <hr class="my-2 bg-primary border-0 opacity-100" style="width: 30px; height: 2px;">
                    <p class="text-muted small mb-0">Gerez vos demandes, devis et interventions depuis un seul espace, très facilement.</p>
                </div>
            </div>
        </div>

        {# Avantage 6 #}
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-row gap-4 align-items-start">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="fa-regular fa-star fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Avis et recommandations</h2>
                    <hr class="my-2 bg-primary border-0 opacity-100" style="width: 30px; height: 2px;">
                    <p class="text-muted small mb-0">Bénéficiez des avis clients pour renforcer votre crédibilité et attirer encore plus de clients.</p>
                </div>
            </div>
        </div>

        {# Avantage 7 #}
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-row gap-4 align-items-start">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="fa-solid fa-headset fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Support réactif</h2>
                    <hr class="my-2 bg-primary border-0 opacity-100" style="width: 30px; height: 2px;">
                    <p class="text-muted small mb-0">Notre équipe est disponible pour vous accompagner et répondre à toutes vos questions.</p>
                </div>
            </div>
        </div>

        {# Avantage 8 #}
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border h-100 d-flex flex-row gap-4 align-items-start">
                <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="fa-solid fa-euro-sign fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Sans engagement</h2>
                    <hr class="my-2 bg-primary border-0 opacity-100" style="width: 30px; height: 2px;">
                    <p class="text-muted small mb-0">Inscription gratuite, sans engagement. Payez uniquement lorsque vous recevez un client.</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Bannière d'appel à l'action bas de page -->
    <div class="bg-light rounded-4 p-4 border d-flex flex-column flex-md-row align-items-center justify-content-between gap-4 mt-5">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-white text-primary border rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-trophy fs-5 text-primary"></i>
            </div>
            <div>
                <h3 class="h6 fw-bold text-dark mb-1">Rejoignez des milliers de professionnels satisfaits</h3>
                <p class="text-muted tm-static-text-xs mb-0">Trouvez plus de clients, gérez votre activité simplement et faites la différence.</p>
            </div>
        </div>
        <div class="d-flex gap-2 text-nowrap">
            <button class="btn btn-white bg-white border text-dark tm-static-text-md-alt fw-medium px-3 shadow-sm" disabled>En savoir plus</button>
            <button class="btn btn-primary tm-static-text-md-alt fw-medium px-4" style="background-color: #2b59ff; border: none;" disabled>S'inscrire gratuitement</button>
        </div>
    </div>
</div>
{% endblock %}