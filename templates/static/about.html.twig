{% extends 'base.html.twig' %}

{% block title %}À propos de nous - TrouveMoi.com{% endblock %}

{% block body %}
<div class="container py-5">
    {# Fil d'ariane #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">À propos de nous</li>
        </ol>
    </nav>

    {# Header & Chiffres #}
    <div class="row align-items-center mb-5 gy-4">
        <div class="col-lg-5">
            <h1 class="display-5 fw-bold tm-static-brand-title mb-3">
                À propos de <span class="text-primary">TrouveMoi.com</span>
            </h1>
            <p class="text-muted fs-5 lh-base mb-4">
                Notre mission : connecter les particuliers avec les meilleurs professionnels près de chez eux, en toute confiance.
            </p>
            <div class="d-flex align-items-center gap-3 tm-bg-title text-white p-3 rounded-3 shadow-sm">
                <i class="bi bi-people-fill fs-3"></i>
                <span class="fw-semibold">Une équipe engagée à vos côtés pour simplifier votre quotidien.</span>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="bg-light p-4 rounded-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="card h-100 border-0 shadow-sm p-3 tm-static-hover-card">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle text-primary p-3 rounded-3"><i class="bi bi-person-badge fs-4"></i></div>
                                <div><div class="fs-4 fw-bold text-dark">+150 000</div><div class="small text-muted">Prestataires inscrits</div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="card h-100 border-0 shadow-sm p-3 tm-static-hover-card">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-success-subtle text-success p-3 rounded-3"><i class="bi bi-check-circle-fill fs-4"></i></div>
                                <div><div class="fs-4 fw-bold text-dark">+1,5 million</div><div class="small text-muted">Demandes satisfaites</div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="card h-100 border-0 shadow-sm p-3 tm-static-hover-card">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-warning-subtle text-warning p-3 rounded-3"><i class="bi bi-star-fill fs-4"></i></div>
                                <div><div class="fs-4 fw-bold text-dark">4,8/5</div><div class="small text-muted">Note moyenne des avis</div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="card h-100 border-0 shadow-sm p-3 tm-static-hover-card">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-info-subtle text-info p-3 rounded-3"><i class="bi bi-geo-alt-fill fs-4"></i></div>
                                <div><div class="fs-4 fw-bold text-dark">Partout en France</div><div class="small text-muted">Présent dans toutes les régions</div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Valeurs #}
    <div class="mb-5 text-center">
        <h2 class="fw-bold text-dark mb-4">Nos valeurs</h2>
        <div class="row g-4">
            {% set valeurs = [
                {icon: 'bi-shield-check', t: 'Confiance', d: 'Nous vérifions l\'identité des professionnels et sécurisons les échanges pour garantir des prestations en toute sérénité.'},
                {icon: 'bi-lightning-charge', t: 'Simplicité', d: 'Une plateforme intuitive et des outils pratiques pour gagner du temps à chaque étape de votre projet.'},
                {icon: 'bi-award', t: 'Qualité', d: 'Nous mettons en avant des professionnels qualifiés et les avis clients pour vous aider à faire le bon choix.'},
                {icon: 'bi-heart', t: 'Proximité', d: 'Un service client réactif et à l\'écoute, basé en France, pour vous accompagner au quotidien.'},
            ] %}
            {% for v in valeurs %}
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm p-4 tm-static-hover-card">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 tm-static-icon-circle-md">
                            <i class="{{ v.icon }} fs-4"></i>
                        </div>
                        <h3 class="fw-bold fs-5 text-dark mb-2">{{ v.t }}</h3>
                        <p class="text-muted small mb-0">{{ v.d }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Histoire & Engagement #}
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm p-4 tm-static-hover-card">
                <h2 class="fw-bold fs-4 text-dark mb-3">Notre histoire</h2>
                <p class="text-muted small mb-3">
                    Lancée en 2015, TrouveMoi.com est née d'un constat simple : trouver un professionnel fiable et disponible près de chez soi peut être long et compliqué.
                </p>
                <p class="text-muted small mb-0">
                    Nous avons créé une plateforme qui centralise les demandes et les offres de prestations, avec pour objectif de faciliter la mise en relation et de valoriser le savoir-faire des professionnels. Aujourd'hui, nous sommes fiers d'accompagner chaque jour des milliers de particuliers et de professionnels dans la réussite de leurs projets.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm p-4 tm-static-hover-card">
                <h2 class="fw-bold fs-4 text-dark mb-3">Notre engagement</h2>
                <ul class="list-unstyled d-flex flex-column gap-3 text-muted small">
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check2-circle text-success fs-5"></i>
                        <span>Protéger vos données et garantir leur confidentialité.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check2-circle text-success fs-5"></i>
                        <span>Innover en continu pour vous offrir la meilleure expérience.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check2-circle text-success fs-5"></i>
                        <span>Soutenir les professionnels locaux et l'économie française.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
