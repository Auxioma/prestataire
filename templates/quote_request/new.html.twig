{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Nouvelle demande de devis{% endblock %}

{% block body %}
<div class="tm-client-quotes-page">
    <div class="container py-4 py-lg-5">
        <section class="tm-client-quotes-hero">
            <div class="tm-client-quotes-hero__content">
                <a href="{{ path('app_quote_request_index') }}" class="tm-client-quotes-backlink">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Retour à mes demandes</span>
                </a>

                <span class="tm-client-quotes-eyebrow">Nouvelle demande</span>
                <h1 class="tm-client-quotes-title tm-client-quotes-title--wide">Décrivez votre besoin avec précision</h1>
                <p class="tm-client-quotes-subtitle">
                    Une demande claire facilite la comparaison, améliore la pertinence des réponses et permet au prestataire de mieux comprendre votre projet.
                </p>
            </div>
        </section>

        {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} alert-dismissible fade show mb-4" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4">
            <div class="col-xl-8">
                <section class="tm-client-quotes-panel">
                    <div class="tm-client-quotes-panel__body">
                        {{ form_start(form, {
                            attr: {
                                novalidate: 'novalidate',
                                'data-turbo': 'false',
                                class: 'tm-client-quotes-form'
                            }
                        }) }}

                            <div class="tm-client-quotes-highlight mb-4">
                                <div class="tm-client-quotes-highlight__title">Conseil</div>
                                <p class="tm-client-quotes-highlight__text mb-0">
                                    Plus votre besoin est concret, plus les retours seront utiles, comparables et rapides à exploiter.
                                </p>
                            </div>

                            {% if prestataire is defined and prestataire %}
                                <div class="tm-client-quotes-locked mb-4">
                                    <div class="tm-client-quotes-locked__label">Prestataire sélectionné</div>
                                    <div class="tm-client-quotes-locked__value">
                                        {{ prestataire.companyName ?? 'Prestataire' }}
                                    </div>
                                </div>
                            {% endif %}

                            <div class="row g-4 tm-client-quotes-form-fields">
                                {% if prestation is defined and prestation %}
                                    <div class="col-12">
                                        <div class="tm-client-quotes-locked">
                                            <div class="tm-client-quotes-locked__label">Service concerné</div>
                                            <div class="tm-client-quotes-locked__value">
                                                {{ prestation.service.name ?? 'Service sélectionné' }}
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="col-12">
                                        {{ form_row(form.prestation) }}
                                    </div>
                                {% endif %}

                                <div class="col-12">
                                    {{ form_row(form.title) }}
                                </div>

                                <div class="col-12">
                                    {{ form_row(form.description) }}
                                </div>

                                <div class="col-md-6">
                                    {{ form_row(form.desiredDate) }}
                                </div>

                                <div class="col-md-6">
                                    {{ form_row(form.budgetAmount) }}
                                </div>
                            </div>

                            <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                                <button type="submit" class="btn tm-client-quotes-btn tm-client-quotes-btn--primary">
                                    Envoyer la demande
                                </button>

                                <a href="{{ path('app_quote_request_index') }}" class="btn tm-client-quotes-btn tm-client-quotes-btn--ghost">
                                    Annuler
                                </a>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </section>
            </div>

            <div class="col-xl-4">
                <aside class="tm-client-quotes-sidecard mb-4">
                    <div class="card-body">
                        <h2 class="tm-client-quotes-sidecard__title">Bonnes pratiques</h2>
                        <ul class="tm-client-quotes-tips">
                            {% if prestation is not defined or not prestation %}
                                <li>Choisissez le service le plus proche de votre besoin.</li>
                            {% endif %}
                            <li>Formulez un titre lisible et direct.</li>
                            <li>Décrivez le contexte, la contrainte et le résultat attendu.</li>
                            <li>Ajoutez une échéance si le timing compte.</li>
                            <li>Indiquez un budget pour mieux cadrer les réponses.</li>
                        </ul>
                    </div>
                </aside>

                <aside class="tm-client-quotes-sidecard">
                    <div class="card-body">
                        <h2 class="tm-client-quotes-sidecard__title">Exemple de demande</h2>
                        <div class="tm-client-quotes-example">
                            <div class="tm-client-quotes-example__item">
                                <span class="tm-client-quotes-example__label">Titre</span>
                                <strong>Rénovation de salle de bain</strong>
                            </div>
                            <div class="tm-client-quotes-example__item">
                                <span class="tm-client-quotes-example__label">Description</span>
                                <p class="mb-0">
                                    Remplacement du meuble vasque, reprise de faïence et installation d’une douche, avec contrainte de délai avant fin de mois.
                                </p>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>
{% endblock %}