{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Nouvelle demande de devis
{% endblock %}

{% block body %}
	<div class="tm-quote-create-page">
		<div class="container py-4 py-lg-5">
			<section class="tm-quote-create-hero">
				<div class="tm-quote-create-hero__content">
					<a href="{{ path('app_quote_request_index') }}" class="tm-quote-create-backlink">
						<i class="fa-solid fa-arrow-left"></i>
						<span>Retour à mes demandes</span>
					</a>

					<span class="tm-quote-create-hero__eyebrow">Nouvelle demande</span>
					<h1 class="tm-quote-create-hero__title">Décrivez votre besoin avec précision</h1>
					<p class="tm-quote-create-hero__subtitle">
						Une demande claire facilite la comparaison, améliore la pertinence des réponses et permet au prestataire de mieux comprendre votre projet.
					</p>
				</div>
			</section>

			{% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
				{% for message in messages %}
					<div class="alert alert-{{ type }} alert-dismissible fade show tm-quote-create-alert" role="alert">
						{{ message }}
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
					</div>
				{% endfor %}
			{% endfor %}

			<div class="row g-4">
				<div class="col-xl-8">
					<section class="tm-quote-create-panel">
						<div class="tm-quote-create-panel__body">
							{{ form_start(form, {
                            attr: {
                                novalidate: 'novalidate',
                                'data-turbo': 'false',
                                class: 'tm-quote-create-form'
                            }
                        }) }}

							<div class="tm-quote-create-highlight">
								<div class="tm-quote-create-highlight__title">Conseil</div>
								<p class="tm-quote-create-highlight__text mb-0">
									Plus votre besoin est concret, plus les retours seront utiles, comparables et rapides à exploiter.
								</p>
							</div>

							{% if prestataire is defined and prestataire %}
								<div class="tm-quote-create-locked">
									<div class="tm-quote-create-locked__label">Prestataire sélectionné</div>
									<div class="tm-quote-create-locked__value">
										{{ prestataire.companyName ?? 'Prestataire' }}
									</div>
								</div>
							{% endif %}

							<div class="row g-4 tm-quote-create-form__fields">
								{% if prestation is defined and prestation %}
									<div class="col-12">
										<div class="tm-quote-create-locked">
											<div class="tm-quote-create-locked__label">Service concerné</div>
											<div class="tm-quote-create-locked__value">
												{{ prestation.service.name ?? 'Service sélectionné' }}
											</div>
										</div>
									</div>
								{% else %}
									<div class="col-12">
										<div class="tm-select-wrap">
											{{ form_row(form.prestation) }}
											<span class="tm-select-wrap__chevron" aria-hidden="true">
												<i class="fa-solid fa-chevron-down"></i>
											</span>
										</div>
									</div>
								{% endif %}

								<div class="col-12">
									{{ form_row(form.title) }}
								</div>

								<div class="col-12">
									{{ form_row(form.description) }}
								</div>

								<div class="col-md-6">
									{{ form_row(form.desiredDate) }}
								</div>

								<div class="col-md-6">
									{{ form_row(form.budgetAmount) }}
								</div>
							</div>

							<div class="tm-quote-create-actions">
								<button type="submit" class="btn tm-quote-create-btn tm-quote-create-btn--primary">
									Envoyer la demande
								</button>

								<a href="{{ path('app_quote_request_index') }}" class="btn tm-quote-create-btn tm-quote-create-btn--ghost">
									Annuler
								</a>
							</div>

							{{ form_end(form) }}
						</div>
					</section>
				</div>

				<div class="col-xl-4">
					<aside class="tm-quote-create-sidecard mb-4">
						<div class="card-body">
							<h2 class="tm-quote-create-sidecard__title">Bonnes pratiques</h2>
							<ul class="tm-quote-create-tips">
								{% if prestation is not defined or not prestation %}
									<li>Choisissez le service le plus proche de votre besoin.</li>
								{% endif %}
								<li>Formulez un titre lisible et direct.</li>
								<li>Décrivez le contexte, la contrainte et le résultat attendu.</li>
								<li>Ajoutez une échéance si le timing compte.</li>
								<li>Indiquez un budget pour mieux cadrer les réponses.</li>
							</ul>
						</div>
					</aside>

					<aside class="tm-quote-create-sidecard">
						<div class="card-body">
							<h2 class="tm-quote-create-sidecard__title">Exemple de demande</h2>
							<div class="tm-quote-create-example">
								<div class="tm-quote-create-example__item">
									<span class="tm-quote-create-example__label">Titre</span>
									<strong>Rénovation de salle de bain</strong>
								</div>
								<div class="tm-quote-create-example__item">
									<span class="tm-quote-create-example__label">Description</span>
									<p class="mb-0">
										Remplacement du meuble vasque, reprise de faïence et installation d’une douche, avec contrainte de délai avant fin de mois.
									</p>
								</div>
							</div>
						</div>
					</aside>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
