{% extends 'base.html.twig' %}

{% block title %}Abonnements prestataire - TrouveMoi{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
                    <div>
                        <span class="text-uppercase text-primary fw-bold small d-block mb-2">Facturation Stripe</span>
                        <h1 class="h2 fw-bold mb-2">Mes abonnements</h1>
                        <p class="text-muted mb-0">
                            Répondez aux demandes de devis et utilisez la messagerie instantanée avec un abonnement actif.
                        </p>
                    </div>

                    {% if currentSubscription %}
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="small text-muted">Crédits restants</div>
                                <div class="display-6 fw-bold mb-1">{{ currentSubscription.remainingCredits }}</div>
                                <div class="small text-muted">
                                    {{ currentSubscription.plan ? currentSubscription.plan.name : 'Plan actif' }}
                                    ·
                                    {{ currentSubscription.billingPeriod.label }}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>

                {% if not stripeConfigured %}
                    <div class="alert alert-warning" role="alert">
                        Stripe n’est pas configuré sur cet environnement. Les abonnements ne peuvent pas être souscrits tant que les clés ne sont pas renseignées.
                    </div>
                {% endif %}

                {% if currentSubscription %}
                    <div class="alert alert-info d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" role="alert">
                        <div>
                            Votre abonnement actuel est
                            <strong>{{ currentSubscription.plan ? currentSubscription.plan.name : 'actif' }}</strong>
                            jusqu’au
                            <strong>{{ currentSubscription.currentPeriodEnd ? currentSubscription.currentPeriodEnd|date('d/m/Y') : 'renouvellement en cours' }}</strong>.
                        </div>
                        <a href="{{ path('app_subscription_portal') }}" class="btn btn-outline-primary">
                            Gérer mon abonnement Stripe
                        </a>
                    </div>
                {% endif %}

                <div class="row g-4">
                    {% for plan in plans %}
                        <div class="col-12 col-md-6 col-xl-4">
                            <article class="card border-0 shadow-sm h-100">
                                <div class="card-body d-flex flex-column">
                                    <h2 class="h4 fw-bold mb-2">{{ plan.name }}</h2>
                                    <p class="text-muted small mb-3">{{ plan.description ?: 'Abonnement Stripe à reconduction tacite pour prestataires.' }}</p>

                                    <div class="mb-3">
                                        <div class="fw-semibold">Mensuel</div>
                                        <div class="fs-4 fw-bold">{{ plan.monthlyAmount ?: '—' }} €</div>
                                        <div class="small text-muted">{{ plan.monthlyCredits }} crédit{{ plan.monthlyCredits > 1 ? 's' : '' }}</div>
                                    </div>

                                    <div class="mb-4">
                                        <div class="fw-semibold">Annuel</div>
                                        <div class="fs-4 fw-bold">{{ plan.annualAmount ?: '—' }} €</div>
                                        <div class="small text-muted">{{ plan.annualCredits }} crédit{{ plan.annualCredits > 1 ? 's' : '' }}</div>
                                    </div>

                                    <ul class="list-unstyled small text-muted mb-4">
                                        <li class="mb-2">
                                            {{ plan.quoteResponsesEnabled ? 'Réponse aux devis incluse' : 'Réponse aux devis désactivée' }}
                                        </li>
                                        <li>
                                            {{ plan.instantMessagingEnabled ? 'Messagerie instantanée incluse' : 'Messagerie instantanée désactivée' }}
                                        </li>
                                    </ul>

                                    <div class="mt-auto d-grid gap-2">
                                        <form
                                            method="post"
                                            action="{{ path('app_subscription_checkout', { code: plan.code, period: 'monthly' }) }}"
                                            data-turbo="false"
                                            data-controller="confirm-dialog"
                                            data-action="submit->confirm-dialog#confirm"
                                            data-confirm-dialog-title-value="Confirmer la souscription mensuelle ?"
                                            data-confirm-dialog-text-value="En validant, vous autorisez un paiement récurrent de {{ (plan.monthlyAmount ?: '0.00')|e('html_attr') }} € pour le forfait {{ plan.name|e('html_attr') }}. La reconduction est tacite. Vous pourrez annuler vous-même depuis « Gérer mon abonnement Stripe »."
                                            data-confirm-dialog-confirm-button-text-value="Payer {{ (plan.monthlyAmount ?: '0.00')|e('html_attr') }} € / mois"
                                            data-confirm-dialog-cancel-button-text-value="Annuler"
                                        >
                                            <input type="hidden" name="_token" value="{{ csrf_token('subscription-checkout-' ~ plan.code ~ '-monthly') }}">
                                            <button type="submit" class="btn btn-primary w-100" {{ not stripeConfigured or not plan.monthlyStripePriceId ? 'disabled' : '' }}>
                                                Souscrire en mensuel
                                            </button>
                                        </form>

                                        <form
                                            method="post"
                                            action="{{ path('app_subscription_checkout', { code: plan.code, period: 'annual' }) }}"
                                            data-turbo="false"
                                            data-controller="confirm-dialog"
                                            data-action="submit->confirm-dialog#confirm"
                                            data-confirm-dialog-title-value="Confirmer la souscription annuelle ?"
                                            data-confirm-dialog-text-value="En validant, vous autorisez un paiement récurrent de {{ (plan.annualAmount ?: '0.00')|e('html_attr') }} € par an pour le forfait {{ plan.name|e('html_attr') }}. La reconduction est tacite. Vous pourrez annuler vous-même depuis « Gérer mon abonnement Stripe »."
                                            data-confirm-dialog-confirm-button-text-value="Payer {{ (plan.annualAmount ?: '0.00')|e('html_attr') }} € / an"
                                            data-confirm-dialog-cancel-button-text-value="Annuler"
                                        >
                                            <input type="hidden" name="_token" value="{{ csrf_token('subscription-checkout-' ~ plan.code ~ '-annual') }}">
                                            <button type="submit" class="btn btn-outline-primary w-100" {{ not stripeConfigured or not plan.annualStripePriceId ? 'disabled' : '' }}>
                                                Souscrire en annuel
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="alert alert-secondary mb-0" role="alert">
                                Aucun plan d’abonnement actif n’est configuré dans l’administration.
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
