<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block email_title %}Information concernant votre forfait TrouveMoi{% endblock %}</title>
        {{ include('subscription/emails/_styles.html.twig') }}
    </head>
    <body>
        <table role="presentation" class="tm-email-page" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td align="center">
                    <table role="presentation" class="tm-email-shell" width="640" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                            <td class="tm-email-header">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td class="tm-email-brand">TrouveMoi</td>
                                    </tr>
                                    <tr>
                                        <td class="tm-email-title">{% block email_headline %}{% endblock %}</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        {% block email_content %}{% endblock %}
                        <tr>
                            <td class="tm-email-footer">
                                Cet e-mail transactionnel vous est envoyé à la suite d’une opération concernant votre forfait TrouveMoi.<br>
                                Merci de le conserver avec vos documents de facturation.
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
