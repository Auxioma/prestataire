<table role="presentation" class="tm-email-summary" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="tm-email-summary-label">Forfait</td>
        <td class="tm-email-summary-value">{{ planName }}</td>
    </tr>
    <tr>
        <td class="tm-email-summary-label">Périodicité</td>
        <td class="tm-email-summary-value">{{ periodLabel }}</td>
    </tr>
    {% if amountPaid is not null %}
        <tr>
            <td class="tm-email-summary-label">Montant payé</td>
            <td class="tm-email-summary-value">{{ amountPaid|number_format(2, ',', ' ') }} {{ currency }}</td>
        </tr>
    {% endif %}
    {% if invoiceNumber %}
        <tr>
            <td class="tm-email-summary-label">Facture</td>
            <td class="tm-email-summary-value">{{ invoiceNumber }}</td>
        </tr>
    {% endif %}
    {% if periodStart %}
        <tr>
            <td class="tm-email-summary-label">Début de période</td>
            <td class="tm-email-summary-value">{{ periodStart|date('d/m/Y') }}</td>
        </tr>
    {% endif %}
    {% if periodEnd %}
        <tr>
            <td class="tm-email-summary-label">Fin de période</td>
            <td class="tm-email-summary-value">{{ periodEnd|date('d/m/Y') }}</td>
        </tr>
    {% endif %}
</table>
