{% extends 'base.html.twig' %}

{% block title %}TrouveMoi Prestataires - Accueil
{% endblock %}

{% block body %}
	<div
		class="homepage-wrapper">

		{# 1. SECTION HERO AVEC IMAGE D'ARRIÈRE-PLAN #}
		<div class="hero-section position-relative text-white">
			<div class="container py-4">
				<div class="row">
					<div class="col-lg-7 text-start">
						<h1 class="display-5 fw-extrabold mb-3 hero-title">
							Trouvez le prestataire idéal
							<br>
							<span class="text-tm-accent">pour tous vos projets</span>
						</h1>

						<p class="fs-5 mb-4 opacity-90 max-w-540 hero-lead">
							Des professionnels de confiance pour vous accompagner dans tous vos besoins, partout en France.
						</p>

						<div class="d-flex flex-wrap gap-2 hero-badges-group">
							<span class="badge hero-badge" data-controller="counter-up">
								<i class="fa-solid fa-circle-plus text-tm-accent me-1"></i>
								+
								<span data-counter-up-target="number" data-counter-up-target-value="120000">0</span>
								prestataires
							</span>
							<span class="badge hero-badge">
								<i class="fa-solid fa-star text-tm-accent me-1"></i>
								Avis clients vérifiés
							</span>
							<span class="badge hero-badge">
								<i class="fa-solid fa-file-invoice text-tm-accent me-1"></i>
								Devis gratuits
							</span>
							<span class="badge hero-badge">
								<i class="fa-solid fa-shield-halved text-tm-accent me-1"></i>
								Paiement sécurisé
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		{# 2. BARRE DE RECHERCHE EN JONCTION EXACTE #}
		<div class="container search-overlap-wrapper">
			<div class="card border-0 shadow-lg p-3 search-overlap-card bg-white">
				<form action="#" method="GET" class="row g-2 align-items-center w-100 m-0">
					<div class="col-md-6 col-lg-3 position-relative">
						<div class="d-flex align-items-start gap-2 px-2 py-1">
							<i class="fa-solid fa-magnifying-glass text-tm-service fs-5 mt-2"></i>
							<div class="w-100">
								<label class="form-label small fw-bold mb-0 text-dark">Que recherchez-vous ?</label>
								<input type="text" class="form-control search-input" placeholder="Ex : Plomberie, Peinture...">
							</div>
						</div>
						<div class="search-divider d-none d-lg-block"></div>
					</div>

					<div class="col-md-6 col-lg-3 position-relative">
						<div class="d-flex align-items-start gap-2 px-2 py-1">
							<i class="fa-solid fa-briefcase text-tm-service fs-5 mt-2"></i>
							<div class="w-100 position-relative select-wrapper">
								<label class="form-label small fw-bold mb-0 text-dark">Type de prestation</label>
								<select class="form-select search-select">
									<option selected>Service, Réparation, Installation...</option>
									<option value="1">Dépannage d'urgence</option>
									<option value="2">Entretien régulier</option>
								</select>
							</div>
						</div>
						<div class="search-divider d-none d-lg-block"></div>
					</div>

					<div class="col-md-6 col-lg-2 position-relative">
						<div class="d-flex align-items-start gap-2 px-2 py-1">
							<i class="fa-solid fa-location-dot text-tm-service fs-5 mt-2"></i>
							<div class="w-100">
								<label class="form-label small fw-bold mb-0 text-dark">Où ?</label>
								<input type="text" class="form-control search-input" placeholder="Ville, CP...">
							</div>
						</div>
						<div class="search-divider d-none d-lg-block"></div>
					</div>

					<div class="col-md-6 col-lg-2 position-relative">
						<div class="d-flex align-items-start gap-2 px-2 py-1">
							<i class="fa-solid fa-calendar-days text-tm-service fs-5 mt-2"></i>
							<div class="w-100">
								<label class="form-label small fw-bold mb-0 text-dark">Quand ?</label>
								<input type="date" class="form-control search-input custom-date-input">
							</div>
						</div>
						<div class="search-divider d-none d-lg-block"></div>
					</div>

					<div class="col-12 col-lg-2 text-center text-lg-end">
						<button type="submit" class="btn search-submit-btn rounded-3 w-100 d-flex align-items-center justify-content-center gap-2">
							<i class="fa-solid fa-magnifying-glass"></i>
							<span>Rechercher</span>
						</button>
					</div>
				</form>
			</div>
		</div>

		{# 3. SECTION CATÉGORIES POPULAIRES #}
		<div class="container main-content-section">
			<div class="mb-4 text-start">
				<h2 class="fw-extrabold h4 mb-1 text-dark tracking-tight">Catégories populaires</h2>
			</div>

			{% set raw_categories = (categories ?? [])|slice(0, 20) %}
			{% set fallback_cats = [
        {'name': 'Bâtiment & Travaux', 'icon': 'fa-hammer'},
        {'name': 'Déménagement', 'icon': 'fa-truck-ramp-box'},
        {'name': 'Nettoyage', 'icon': 'fa-sparkles'},
        {'name': 'Jardin & Extérieur', 'icon': 'fa-tree'},
        {'name': 'High-Tech', 'icon': 'fa-laptop'},
        {'name': 'Événementiel', 'icon': 'fa-cake-candles'},
        {'name': 'Bien-être', 'icon': 'fa-heart-pulse'},
        {'name': 'Cours & Formations', 'icon': 'fa-book-open'},
        {'name': 'Mécanique', 'icon': 'fa-wrench'},
        {'name': 'Animaux', 'icon': 'fa-dog'}
    ] %}

			{% set display_categories = raw_categories is not empty ? raw_categories : fallback_cats %}

			{# Agencement global : le carrousel prend tout l'espace disponible, la carte fixe reste à droite #}
			<div
				class="d-flex align-items-stretch gap-3">

				{# LE CARROUSEL AUTOMATIQUE (Sans boutons de navigation) #}
				<div class="tm-categories-slider flex-grow-1 position-relative" data-controller="categories-carousel" data-categories-carousel-step-value="1">

					<div class="tm-categories-viewport" data-categories-carousel-target="viewport">
						<div class="tm-categories-track" data-categories-carousel-target="track">
							{% for category in display_categories %}
								<div class="tm-category-item" data-categories-carousel-target="item">
									<a href="{{ category.slug is defined ? path('app_category_show', {'slug': category.slug}) : '#' }}" class="card h-100 border-0 shadow-sm p-3 text-decoration-none tm-category-card rounded-3 bg-white d-flex flex-column align-items-center justify-content-center">
										<div class="d-flex align-items-center justify-content-center rounded-circle mb-2 category-icon-wrapper">
											{% if category.icon %}
												<i class="fa-solid {{ category.icon }} fs-5"></i>
											{% else %}
												<span class="fw-bold fs-5">{{ category.name|first|upper }}</span>
											{% endif %}
										</div>
										<span class="text-dark fw-bold w-100 category-title">{{ category.name }}</span>
									</a>
								</div>
							{% endfor %}
						</div>
					</div>

				</div>

				{# LA CARD FIXE (Alignée à droite) #}
				<div style="width: 160px; min-width: 160px;">
					<a href="{{ path('app_category_index') }}" class="card h-100 border p-2 text-decoration-none rounded-3 bg-white d-flex flex-column align-items-center justify-content-center gap-2 shadow-sm all-categories-card text-center text-tm-service border-tm-service-light">
						<div class="rounded-circle bg-tm-service-light d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: rgba(6, 27, 86, 0.05);">
							<i class="fa-solid fa-grid-2 text-tm-service"></i>
						</div>
						<span class="text-dark fw-extrabold small lh-sm">Voir toutes<br>les catégories</span>
						<i class="fa-solid Bella fa-chevron-right arrow-indicator small text-muted"></i>
					</a>
				</div>

			</div>
		</div>

		{# 4. SECTION PRESTATAIRES À LA UNE & ASIDE #}
		<div class="container my-5 pb-5">
			<div class="row gy-4 gx-lg-5">
				<div class="col-xl-9 col-lg-8">
					<div class="d-flex justify-content-between align-items-center mb-4">
						<h2 class="fw-extrabold h4 mb-0 text-dark tracking-tight">
							Prestataires à la une
							<span class="text-tm-accent">
								<i class="fa-solid fa-star"></i>
							</span>
						</h2>
						<a href="#" class="text-tm-service fw-bold text-decoration-none small d-flex align-items-center gap-1 view-all-link">
							Voir tous les prestataires
							<i class="fa-solid fa-chevron-right fs-7"></i>
						</a>
					</div>

					<div class="row g-3" data-controller="scroll-reveal">
						{% for provider in providers|slice(0, 4) %}
							<div class="col-md-6 col-xl-3" data-scroll-reveal-target="element">
								<div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden bg-white position-relative provider-card">
									<button class="btn btn-light favorite-btn border-0 shadow-sm">
										<i class="fa-regular fa-heart text-muted"></i>
									</button>

									<div class="position-relative">
										<img src="{{ provider.logo ? asset('uploads/providers/' ~ provider.logo) : 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=400&q=80' }}" class="card-img-top provider-img" alt="{{ provider.companyName }}">

										{% if provider.averageRating >= 4.8 %}
											<span class="badge bg-tm-accent text-dark position-absolute start-0 top-0 m-2 fw-semibold border-0 px-2 py-1 fs-11">Excellent ({{ provider.averageRating }})</span>
										{% else %}
											<span class="badge bg-tm-service position-absolute start-0 top-0 m-2 text-white fw-medium border-0 px-2 py-1 fs-11">Top Prestataire</span>
										{% endif %}
									</div>

									<div class="card-body p-3 text-start d-flex flex-column justify-content-between">
										<div>
											<h3 class="fw-extrabold h6 text-dark mb-1 text-truncate">
												{{ provider.companyName }}
											</h3>
											<p class="text-muted small mb-2 fs-12">
												{{ provider.metier ? provider.metier : 'Prestataire' }}
											</p>
											<div class="d-flex align-items-center gap-1 text-muted small mb-2 fs-12 fw-semibold">
												<i class="fa-solid fa-star text-tm-accent"></i>
												<span class="text-dark fw-bold">{{ provider.averageRating|number_format(1, '.', '') }}</span>
												({{ provider.reviewsCount ?? 0 }}
												avis)
											</div>
											<p class="text-muted small mb-3 fs-12">
												<i class="fa-solid fa-location-dot me-1"></i>
												{{ provider.city }}
											</p>
										</div>
										<div class="border-top pt-2 text-tm-success small fw-semibold fs-12 mt-auto">
											<i class="fa-solid fa-file-circle-check me-1"></i>
											Devis gratuit
										</div>
									</div>
								</div>
							</div>
						{% else %}
							<div class="col-12">
								<div class="alert alert-info text-center border-0 shadow-sm">
									Aucun prestataire disponible pour le moment.
								</div>
							</div>
						{% endfor %}
					</div>
				</div>

				{# SIDEBAR REASSURANCE #}
				<div class="col-xl-3 col-lg-4 text-start">
					<div class="card border-0 shadow-sm p-4 rounded-4 h-100 reassurance-aside d-flex flex-column">
						<h3 class="fw-extrabold text-dark mb-4 reassurance-main-title">Pourquoi choisir<br>TrouveMoi ?</h3>

						<div class="d-flex flex-column gap-3 mb-4">
							<div class="d-flex align-items-start gap-2">
								<i class="fa-solid fa-circle-check text-tm-service fs-5 mt-1"></i>
								<div>
									<h4 class="fw-extrabold text-dark mb-0 fs-12">Des pros vérifiés</h4>
									<p class="text-muted mb-0 reassurance-desc">Prestataires sélectionnés et contrôlés.</p>
								</div>
							</div>

							<div class="d-flex align-items-start gap-2">
								<i class="fa-solid fa-comments text-tm-service fs-5 mt-1"></i>
								<div>
									<h4 class="fw-extrabold text-dark mb-0 fs-12">Avis authentiques</h4>
									<p class="text-muted mb-0 reassurance-desc">Des retours fiables pour bien choisir.</p>
								</div>
							</div>

							<div class="d-flex align-items-start gap-2">
								<i class="fa-solid fa-file-signature text-tm-service fs-5 mt-1"></i>
								<div>
									<h4 class="fw-extrabold text-dark mb-0 fs-12">Devis gratuits</h4>
									<p class="text-muted mb-0 reassurance-desc">Comparez et choisissez sans engagement.</p>
								</div>
							</div>

							<div class="d-flex align-items-start gap-2">
								<i class="fa-solid fa-shield-halved text-tm-service fs-5 mt-1"></i>
								<div>
									<h4 class="fw-extrabold text-dark mb-0 fs-12">Paiement sécurisé</h4>
									<p class="text-muted mb-0 reassurance-desc">Transactions 100% sécurisées.</p>
								</div>
							</div>
						</div>

						<a href="#" class="btn btn-white w-100 py-2 rounded-3 fw-bold bg-white text-tm-service border shadow-xs d-flex align-items-center justify-content-between px-3 mt-auto reassurance-more-btn">
							En savoir plus
							<i class="fa-solid fa-chevron-right arrow-indicator"></i>
						</a>
					</div>
				</div>
			</div>
		</div>

		{# 5. BANDEAU DES CARACTÉRISTIQUES DU BAS #}
		<div class="bg-white border-top py-4">
			<div class="container">
				<div class="row g-4 justify-content-center text-center text-md-start">
					<div class="col-sm-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2 feature-bottom-item">
						<div class="d-flex align-items-center justify-content-center rounded-3 shadow-xs feature-bottom-icon">
							<i class="fa-solid fa-calendar-check fs-5"></i>
						</div>
						<div>
							<span class="d-block fw-extrabold text-dark small lh-1 fs-13">Demande de devis gratuite</span>
							<small class="text-muted fw-medium fs-11">Réponse rapide sous 48h</small>
						</div>
					</div>
					<div class="col-sm-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2 feature-bottom-item">
						<div class="d-flex align-items-center justify-content-center rounded-3 shadow-xs feature-bottom-icon">
							<i class="fa-solid fa-thumbs-up fs-5"></i>
						</div>
						<div>
							<span class="d-block fw-extrabold text-dark small lh-1 fs-13">Aucun engagement</span>
							<small class="text-muted fw-medium fs-11">Comparez et choisissez librement</small>
						</div>
					</div>
					<div class="col-sm-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2 feature-bottom-item">
						<div class="d-flex align-items-center justify-content-center rounded-3 shadow-xs feature-bottom-icon">
							<i class="fa-solid fa-lock fs-5"></i>
						</div>
						<div>
							<span class="d-block fw-extrabold text-dark small lh-1 fs-13">Paiement sécurisé</span>
							<small class="text-muted fw-medium fs-11">Transactions cryptées</small>
						</div>
					</div>
					<div class="col-sm-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2 feature-bottom-item">
						<div class="d-flex align-items-center justify-content-center rounded-3 shadow-xs feature-bottom-icon">
							<i class="fa-solid fa-headset fs-5"></i>
						</div>
						<div>
							<span class="d-block fw-extrabold text-dark small lh-1 fs-13">Support 7j/7</span>
							<small class="text-muted fw-medium fs-11">Une équipe à votre écoute</small>
						</div>
					</div>
				</div>
			</div>
		</div>

	</div>

{% endblock %}
