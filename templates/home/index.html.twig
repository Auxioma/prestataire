                        <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden bg-white position-relative">
                            <button class="btn btn-light rounded-circle p-1.5 position-absolute end-0 top-0 m-2 border-0 shadow-sm" style="z-index: 10; width: 32px; height: 32px;"><i class="bi bi-heart text-muted"></i></button>
                            <div class="position-relative">
