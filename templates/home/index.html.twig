                                <div class="d-flex align-items-center gap-1 text-muted small mb-2" style="font-size: 12px; font-weight: 500;">
                                    <i class="bi bi-star-fill text-warning"></i> <span class="text-dark fw-bold">4.9</span> (178 avis)
                                </div>
                                <p class="text-muted small mb-3" style="font-size: 12px;"><i class="bi bi-geo-alt"></i> Toulouse (31)</p>
                                <div class="border-top pt-2 text-success small fw-semibold" style="font-size: 12px;"><i class="bi bi-file-earmark-text me-1"></i> Devis gratuit</div>
                            </div>
                        </div>
                    </div>

