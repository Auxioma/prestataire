{% extends 'base.html.twig' %}

{% block title %}TrouveMoi Prestataires - Accueil{% endblock %}

{% block body %}
<div class="homepage-wrapper">

    {# 1. SECTION HERO #}
    <div class="hero-section text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <h1 class="hero-title mb-3">
                        Trouvez le prestataire idéal <br>
                        <span class="hero-title-highlight">pour tous vos projets</span>
                    </h1>
                    
                    <p class="hero-lead mb-4">
                        Des professionnels de confiance pour vous accompagner dans tous vos besoins, partout en France.
                    </p>
                    
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <span class="badge tm-badge-hero px-3 py-2 border">
                            <i class="fa-solid fa-circle-plus text-warning me-2"></i> 120 000 prestataires
                        </span>
                        <span class="badge tm-badge-hero px-3 py-2 border">
                            <i class="fa-solid fa-star text-warning me-2"></i> Avis clients vérifiés
                        </span>
                        <span class="badge tm-badge-hero px-3 py-2 border">
                            <i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i> Devis gratuits
                        </span>
                        <span class="badge tm-badge-hero px-3 py-2 border">
                            <i class="fa-solid fa-shield-halved text-warning me-2"></i> Paiement sécurisé
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 2. SECTION CATEGORIES #}
    <div class="container my-5">
        <div class="mb-4">
            <h2 class="category-section-title h3 mb-1">Explorez nos catégories de services</h2>
            <p class="category-section-subtitle small">Sélectionnez un secteur d'activité pour découvrir les profils disponibles.</p>
        </div>

        <div class="row g-4">
            {% for category in categories %}
                <div class="col-md-6 col-lg-4">
                    <a href="#" class="card h-100 text-decoration-none tm-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="tm-icon-box fw-bold">
                                {{ category.name|slice(0, 1)|upper }}
                            </div>
                            <div class="tm-card-content">
                                <h3 class="tm-card-title mb-1 fw-bold">{{ category.name }}</h3>
                                <p class="tm-card-description small mb-0">Toutes nos prestations autour de la thématique {{ category.name }}...</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Aucune catégorie disponible.</p>
                </div>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}