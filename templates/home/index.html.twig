{% extends 'base.html.twig' %}

{% block title %}TrouveMoi Prestataires - Accueil
{% endblock %}

{% block body %}
	<div
		class="homepage-wrapper">

		{# 1. SECTION HERO AVEC IMAGE D'ARRIÈRE-PLAN #}
		<div class="hero-section position-relative text-white">
			<div class="container hero-container">
				<div class="row">
					<div class="col-lg-7 text-start">
						<h1 class="display-5 fw-extrabold mb-3 hero-title">
							Trouvez le prestataire idéal
							<br>
							<span class="text-tm-accent">pour tous vos projets</span>
						</h1>

						<p class="fs-5 mb-4 opacity-90 max-w-540 hero-lead">
							Des professionnels de confiance pour vous accompagner dans tous vos besoins, partout en France.
						</p>

						<div class="d-flex flex-wrap gap-2 hero-badges-group">
							<span class="badge hero-badge">
								<i class="bi bi-plus-circle-fill text-tm-accent"></i>
								+ 120 000 prestataires
							</span>
							<span class="badge hero-badge">
								<i class="bi bi-star-fill text-tm-accent"></i>
								Avis clients vérifiés
							</span>
							<span class="badge hero-badge">
								<i class="bi bi-file-earmark-text-fill text-tm-accent"></i>
								Devis gratuits
							</span>
							<span class="badge hero-badge">
								<i class="bi bi-shield-lock-fill text-tm-accent"></i>
								Paiement sécurisé
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		{# 2. BARRE DE RECHERCHE EN JONCTION EXACTE (OVERLAP CENTRÉ) #}
		<div class="container search-overlap-wrapper">
			<div class="card border-0 shadow-lg p-3 rounded-4 bg-white search-overlap-card">
				<form action="#" method="GET" class="row g-0 align-items-center w-100">
					<div class="col-md-6 col-lg-3 position-relative">
						<div class="d-flex align-items-start gap-2 px-3 py-2">
							<i class="bi bi-search text-tm-service fs-5 mt-1"></i>
							<div class="w-100">
								<label class="form-label small fw-bold mb-0 text-dark">Que recherchez-vous ?</label>
								<input type="text" class="form-control search-input" placeholder="Ex : Plomberie, Peinture...">
							</div>
						</div>
						<div class="search-divider d-none d-lg-block"></div>
					</div>

					<div class="col-md-6 col-lg-3 position-relative">
						<div class="d-flex align-items-start gap-2 px-3 py-2">
							<i class="bi bi-person text-tm-service fs-5 mt-1"></i>
							<div class="w-100 position-relative select-wrapper">
								<label class="form-label small fw-bold mb-0 text-dark">Type de prestation</label>
								<select class="form-select search-select">
									<option selected>Service, Réparation, Installation...</option>
									<option value="1">Dépannage d'urgence</option>
									<option value="2">Entretien régulier</option>
								</select>
								<i class="bi bi-chevron-down select-arrow-icon"></i>
							</div>
						</div>
						<div class="search-divider d-none d-lg-block"></div>
					</div>

					<div class="col-md-6 col-lg-2 position-relative">
						<div class="d-flex align-items-start gap-2 px-3 py-2">
							<i class="bi bi-geo-alt text-tm-service fs-5 mt-1"></i>
							<div class="w-100">
								<label class="form-label small fw-bold mb-0 text-dark">Où ?</label>
								<input type="text" class="form-control search-input" placeholder="Ville, CP...">
							</div>
						</div>
						<div class="search-divider d-none d-lg-block"></div>
					</div>

					<div class="col-md-6 col-lg-2 position-relative">
						<div class="d-flex align-items-start gap-2 px-3 py-2">
							<i class="bi bi-calendar3 text-tm-service fs-5 mt-1"></i>
							<div class="w-100">
								<label class="form-label small fw-bold mb-0 text-dark">Quand ?</label>
								<input type="date" class="form-control search-input custom-date-input">
							</div>
						</div>
						<div class="search-divider d-none d-lg-block"></div>
					</div>

					<div class="col-12 col-lg-2 px-2 text-center text-lg-end">
						<button type="submit" class="btn btn-tm-service search-submit-btn rounded-3 w-100 py-2 d-flex align-items-center justify-content-center gap-2">
							<i class="bi bi-search"></i>
							<span>Rechercher</span>
						</button>
					</div>
				</form>
			</div>
		</div>

		{# 3. SECTION CATÉGORIES POPULAIRES #}
		<div class="container main-content-section">
			<div class="mb-4 text-start">
				<h2 class="fw-extrabold h4 mb-1 text-dark tracking-tight">Catégories populaires</h2>
			</div>

			<div class="d-flex flex-wrap gap-2 justify-content-between align-items-stretch">
				{% for category in categories|slice(0, 10) %}
					<div class="flex-grow-1 text-center category-col">
						<a href="#" class="card h-100 border-0 shadow-sm p-3 text-decoration-none tm-category-card rounded-3 bg-white d-flex flex-column align-items-center justify-content-center">
							<div class="d-flex align-items-center justify-content-center rounded-circle mb-2 category-icon-wrapper">
								<span class="fw-bold fs-5">{{ category.name|slice(0, 1)|upper }}</span>
							</div>
							<span class="text-dark fw-bold text-truncate w-100 category-title">{{ category.name }}</span>
						</a>
					</div>
				{% else %}
					{% set fallback_cats = [
                    {'name': 'Maison & Travaux', 'icon': 'bi-house-door'},
                    {'name': 'Déménagement', 'icon': 'bi-truck'},
                    {'name': 'Nettoyage', 'icon': 'bi-stars'},
                    {'name': 'Jardinage', 'icon': 'bi-tree'},
                    {'name': 'Informatique', 'icon': 'bi-laptop'},
                    {'name': 'Événementiel', 'icon': 'bi-balloon-heart'},
                    {'name': 'Bien-être', 'icon': 'bi-heart-pulse'},
                    {'name': 'Cours & Soutien', 'icon': 'bi-book'},
                    {'name': 'Réparation auto', 'icon': 'bi-nut'},
                    {'name': 'Petits travaux', 'icon': 'bi-tools'}
                ] %}
					{% for cat in fallback_cats %}
						<div class="flex-grow-1 text-center category-col">
							<a href="#" class="card h-100 border-0 shadow-sm p-3 text-decoration-none tm-category-card rounded-3 bg-white d-flex flex-column align-items-center justify-content-center">
								<div class="d-flex align-items-center justify-content-center rounded-circle mb-2 category-icon-wrapper">
									<i class="bi {{ cat.icon }} fs-5"></i>
								</div>
								<span class="text-dark fw-bold text-wrap line-clamp-2 category-title">{{ cat.name }}</span>
							</a>
						</div>
					{% endfor %}
				{% endfor %}

				<div class="flex-grow-1 text-center all-categories-col">
					<a href="#" class="card h-100 border p-2 text-decoration-none rounded-3 bg-white d-flex flex-row align-items-center justify-content-center gap-2 shadow-xs all-categories-card">
						<span class="text-dark fw-extrabold text-start all-categories-text">Voir toutes<br>les catégories</span>
						<i class="bi bi-chevron-right arrow-indicator"></i>
					</a>
				</div>
			</div>
		</div>

		{# 4. SECTION PRESTATAIRES À LA UNE (DYNAMIQUE) & ASIDE #}
		<div class="container my-5 pb-5">
			<div class="row g-4">

				<div class="col-xl-9 col-lg-8">
					<div class="d-flex justify-content-between align-items-center mb-4">
						<h2 class="fw-extrabold h4 mb-0 text-dark tracking-tight">
							Prestataires à la une
							<span class="text-tm-accent">★</span>
						</h2>
						<a href="#" class="text-tm-service fw-bold text-decoration-none small d-flex align-items-center gap-1 view-all-link">
							Voir tous les prestataires
							<i class="bi bi-chevron-right fs-7"></i>
						</a>
					</div>

					<div
						class="row g-3">
						{# Boucle Twig sur les prestataires injectés par le contrôleur #}
						{% for provider in providers|slice(0, 4) %}
							<div class="col-md-6 col-xl-3">
								<div class="card h-50 border-0 shadow-sm rounded-3 overflow-hidden bg-white position-relative provider-card">
									<button class="btn btn-light rounded-circle favorite-btn border-0 shadow-sm">
										<i class="bi bi-heart text-muted"></i>
									</button>

									<div
										class="position-relative">
										{# Gestion du logo ou d'une image par défaut si le prestataire n'en a pas #}
										<img src="{{ provider.logo ? asset('uploads/providers/' ~ provider.logo) : 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=400&q=80' }}" class="card-img-top provider-img" alt="{{ provider.companyName }}">
									</div>
                                    
									{# Badge dynamique basé sur la note #}
									{% if provider.averageRating >= 4.8 %}
										<span class="badge bg-tm-accent text-dark position-absolute start-0 top-0 m-2 fw-semibold border-0 px-2 py-1 fs-11">Excellent ({{ provider.averageRating }})</span>
									{% else %}
										<span class="badge bg-tm-service position-absolute start-0 top-0 m-2 text-white fw-medium border-0 px-2 py-1 fs-11">Top Prestataire</span>
									{% endif %}
								</div>

								<div
									class="card-body p-3 text-start position-relative pt-4">

									<h3 class="fw-extrabold h6 text-dark mt-2 mb-0 text-truncate">
										{{ provider.companyName }}
									</h3>

									<p class="text-muted small mb-2 fs-12">
										{{ provider.metier ? provider.metier : 'Prestataire' }}
									</p>

									<div class="d-flex align-items-center gap-1 text-muted small mb-2 fs-12 fw-semibold">
										<i class="bi bi-star-fill text-tm-accent"></i>
										<span class="text-dark fw-bold">{{ provider.averageRating|number_format(1, '.', '') }}</span>
										({{ provider.reviewsCount ?? 0 }}
										avis)
									</div>

									<p class="text-muted small mb-3 fs-12">
										<i class="bi bi-geo-alt me-1"></i>
										{{ provider.city }}
										({{ provider.postalCode|slice(0, 2) }})
									</p>

									<div class="border-top pt-2 text-tm-success small fw-semibold fs-12">
										<i class="bi bi-file-earmark-text me-1"></i>
										Devis gratuit
									</div>
								</div>
							</div>
						</div>
					{% else %}
						{# Message de fallback si aucun prestataire n'est trouvé en BDD #}
						<div class="col-12">
							<div class="alert alert-info text-center border-0 shadow-sm">
								Aucun prestataire disponible pour le moment.
							</div>
						</div>
					{% endfor %}
				</div>
			</div>

			<div class="col-xl-3 col-lg-4 text-start pt-4">
				<div class="card border-0 shadow-sm p-4 rounded-4 h-100 reassurance-aside">
					<h3 class="fw-extrabold text-dark mb-3 reassurance-main-title">Pourquoi choisir<br>TrouveMoi Prestataires ?</h3>

					<div class="d-flex flex-column gap-3 mb-4">
						<div class="d-flex align-items-start gap-2">
							<i class="bi bi-patch-check text-tm-service fs-5 mt-n1"></i>
							<div>
								<h4 class="fw-extrabold text-dark mb-0 fs-12">Des pros vérifiés</h4>
								<p class="text-muted mb-0 reassurance-desc">Des prestataires sélectionnés et contrôlés.</p>
							</div>
						</div>

						<div class="d-flex align-items-start gap-2">
							<i class="bi bi-star text-tm-service fs-5 mt-n1"></i>
							<div>
								<h4 class="fw-extrabold text-dark mb-0 fs-12">Avis clients authentiques</h4>
								<p class="text-muted mb-0 reassurance-desc">Des retours d'expérience fiables pour bien choisir.</p>
							</div>
						</div>

						<div class="d-flex align-items-start gap-2">
							<i class="bi bi-file-earmark-check text-tm-service fs-5 mt-n1"></i>
							<div>
								<h4 class="fw-extrabold text-dark mb-0 fs-12">Devis gratuits</h4>
								<p class="text-muted mb-0 reassurance-desc">Comparez et choisissez sans engagement.</p>
							</div>
						</div>

						<div class="d-flex align-items-start gap-2">
							<i class="bi bi-shield-check text-tm-service fs-5 mt-n1"></i>
							<div>
								<h4 class="fw-extrabold text-dark mb-0 fs-12">Paiement sécurisé</h4>
								<p class="text-muted mb-0 reassurance-desc">Transactions 100% sécurisées.</p>
							</div>
						</div>
					</div>

					<a href="#" class="btn btn-white w-100 py-2 rounded-3 fw-bold bg-white text-tm-service border shadow-xs d-flex align-items-center justify-content-between px-3 mt-auto reassurance-more-btn">
						En savoir plus
						<i class="bi bi-chevron-right arrow-indicator"></i>
					</a>
				</div>
			</div>

		</div>
	</div>

	{# 5. BANDEAU DES CARACTÉRISTIQUES DU BAS #}
	<div class="bg-white border-top py-4">
		<div class="container">
			<div class="row g-4 justify-content-center text-center text-md-start">
				<div class="col-sm-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2 feature-bottom-item">
					<div class="d-flex align-items-center justify-content-center rounded-3 shadow-xs feature-bottom-icon">
						<i class="bi bi-calendar-check fs-5"></i>
					</div>
					<div>
						<span class="d-block fw-extrabold text-dark small lh-1 fs-13">Demande de devis gratuite</span>
						<small class="text-muted fw-medium fs-11">Réponse rapide des prestataires</small>
					</div>
				</div>
				<div class="col-sm-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2 feature-bottom-item">
					<div class="d-flex align-items-center justify-content-center rounded-3 shadow-xs feature-bottom-icon">
						<i class="bi bi-hand-thumbs-up fs-5"></i>
					</div>
					<div>
						<span class="d-block fw-extrabold text-dark small lh-1 fs-13">Aucun engagement</span>
						<small class="text-muted fw-medium fs-11">Comparez et choisissez librement</small>
					</div>
				</div>
				<div class="col-sm-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2 feature-bottom-item">
					<div class="d-flex align-items-center justify-content-center rounded-3 shadow-xs feature-bottom-icon">
						<i class="bi bi-lock fs-5"></i>
					</div>
					<div>
						<span class="d-block fw-extrabold text-dark small lh-1 fs-13">Paiement sécurisé</span>
						<small class="text-muted fw-medium fs-11">Par carte ou virement sécurisé</small>
					</div>
				</div>
				<div class="col-sm-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start gap-2 feature-bottom-item">
					<div class="d-flex align-items-center justify-content-center rounded-3 shadow-xs feature-bottom-icon">
						<i class="bi bi-headset fs-5"></i>
					</div>
					<div>
						<span class="d-block fw-extrabold text-dark small lh-1 fs-13">Support 7j/7</span>
						<small class="text-muted fw-medium fs-11">Une équipe à votre écoute</small>
					</div>
				</div>
			</div>
		</div>
	</div>

</div>

<style>
/* VARIABLES DE DESIGN */:root
{
	--tm-primary: #061B56;
	--tm-service: #2046D8;
	--tm-service-hover: #1B3CC0;
	--tm-accent: #F4A911;
	--tm-success: #16A34A;
	--tm-bg-light: #F8F9FA;
	--tm-border-color: #DDE2EA;
	--tm-icon-bg: #F1F5FF;
}

/* STRUCTURES ET TYPOGRAPHIES BASE */
.homepage-wrapper {
	font-family: 'Poppins', sans-serif;
	color: var(--tm-primary);
	background-color: var(--tm-bg-light);
	overflow-x: hidden;
}
.fw-extrabold {
	font-weight: 800 !important;
}
.tracking-tight {
	letter-spacing: -0.5px;
}
.max-w-540 {
	max-width: 540px;
}

/* COULEURS ET BADGES UTILS */
.text-tm-accent {
	color: var(--tm-accent) !important;
}
.text-tm-service {
	color: var(--tm-service) !important;
}
.bg-tm-success {
	background-color: var(--tm-success) !important;
}
.bg-tm-accent {
	background-color: var(--tm-accent) !important;
}
.bg-tm-service {
	background-color: var(--tm-service) !important;
}
.fs-11 {
	font-size: 11px !important;
}
.fs-12 {
	font-size: 12px !important;
}
.fs-13 {
	font-size: 13px !important;
}
.shadow-xs {
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
}

/* 1. HERO SECTION */
.hero-section {
	background: linear-gradient(to right, rgba(6, 27, 86, 0.98) 35%, rgba(6, 27, 86, 0.5) 100%), url('/images/bg-hero-worker.jpg') no-repeat center center / cover;
	padding-top: 50px;
	padding-bottom: 90px;
}
.hero-title {
	letter-spacing: -1px;
	line-height: 1.2;
}
.hero-lead {
	font-weight: 400;
	line-height: 1.6;
}
.hero-badge {
	background: rgba(255, 255, 255, 0.08);
	font-size: 13px;
	font-weight: 500;
	padding: 8px 14px;
	border: 1px solid rgba(255, 255, 255, 0.15);
	border-radius: 6px !important;
}

/* 2. OVERLAP DE LA BARRE DE RECHERCHE */
.search-overlap-wrapper {
	position: relative;
	z-index: 10;
	height: 0;
}
.search-overlap-card {
	transform: translateY(-50%);
}

/* CHAMPS DE RECHERCHE ET SEPARATEURS */
.search-input,
.search-select {
	border: 0 !important;
	padding: 0 !important;
	background-color: transparent !important;
	font-size: 13px;
	color: #495057;
	box-shadow: none !important;
	width: 100%;
}
.search-input::placeholder {
	color: #9ba4b0;
	opacity: 1;
}

/* AJUSTEMENT SPÉCIFIQUE DU CHAMP DATE NATIF */
.custom-date-input {
	cursor: pointer;
	text-transform: uppercase;
	font-size: 12px;
}

.select-wrapper {
	position: relative;
}
.search-select {
	appearance: none;
	-webkit-appearance: none;
	cursor: pointer;
	padding-right: 20px !important;
}
.select-arrow-icon {
	position: absolute;
	right: 0;
	bottom: 2px;
	font-size: 11px;
	color: #9ba4b0;
	pointer-events: none;
}
.search-divider {
	position: absolute;
	right: 0;
	top: 15%;
	height: 70%;
	width: 1px;
	background-color: var(--tm-border-color);
}

/* BOUTON DE RECHERCHE REVISITÉ */
.search-submit-btn {
	background-color: var(--tm-service);
	border: 0;
	color: #fff;
	height: 48px;
	font-size: 14px;
	font-weight: 600;
	transition: background-color 0.2s ease, transform 0.1s ease;
}
.search-submit-btn:hover {
	background-color: var(--tm-service-hover);
	color: #fff;
}
.search-submit-btn:active {
	transform: scale(0.98);
}
@media(max-width: 991.98px) {
	.search-overlap-card {
		transform: translateY(-20px);
	}
	.search-overlap-wrapper {
		height: auto;
	}
	.search-submit-btn {
		width: 100%;
		margin-top: 10px;
	}
}

/* 3. SECTION CATÉGORIES POPULAIRES */
.main-content-section {
	margin-top: 80px;
}
.category-col {
	min-width: 105px;
	max-width: 115px;
}
.tm-category-card {
	transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.tm-category-card:hover {
	transform: translateY(-3px);
	box-shadow: 0 6px 16px rgba(6, 27, 86, 0.08) !important;
}
.category-icon-wrapper {
	width: 48px;
	height: 48px;
	background-color: var(--tm-icon-bg);
	color: var(--tm-service) !important;
}
.category-title {
	font-size: 12px;
	font-weight: 700 !important;
	line-height: 1.2;
}
.all-categories-col {
	min-width: 125px;
	max-width: 135px;
}
.all-categories-card {
	border-color: var(--tm-border-color) !important;
	border-style: dashed !important;
	transition: background-color 0.2s ease, border-color 0.2s ease;
}
.all-categories-card:hover {
	background-color: var(--tm-icon-bg) !important;
	border-color: var(--tm-service) !important;
}
.all-categories-text {
	font-size: 12px;
	line-height: 1.3;
}
.arrow-indicator {
	font-size: 11px;
	color: #9ba4b0;
	transition: transform 0.2s ease;
}
.all-categories-card:hover .arrow-indicator,
.view-all-link:hover i,
.reassurance-more-btn:hover .arrow-indicator {
	transform: translateX(2px);
	color: var(--tm-service);
}

/* 4. PRESTATAIRES À LA UNE */
.view-all-link {
	font-size: 13px;
	transition: color 0.2s ease;
}
.provider-card {
	transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.provider-card:hover {
	transform: translateY(-3px);
	box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08) !important;
}
.favorite-btn {
	position: absolute;
	right: 0;
	top: 0;
	margin: 8px;
	z-index: 10;
	width: 34px;
	height: 34px;
	display: flex;
	align-items: center;
	justify-content: center;
	transition: background-color 0.2s ease;
}
.favorite-btn:hover {
	background-color: #fff !important;
}
.favorite-btn:hover i {
	color: #dc3545 !important;
}
.provider-img {
	height: 145px;
	object-fit: cover;
}
.provider-avatar-icon {
	width: 38px;
	height: 38px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #fff;
	position: absolute;
	top: -19px;
	left: 15px;
	border: 3px solid #fff;
