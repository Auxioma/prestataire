{% extends 'base.html.twig' %}

{% block title %}TrouveMoi Prestataires - Accueil
{% endblock %}

{% block body %}
	<div
		class="tm-homepage-v2">

		{# HERO #}
		<section class="tmv2-hero">
			<div class="container tmv2-hero__inner mb-4">
				<div class="tmv2-hero__content">
					<span class="tmv2-eyebrow">TrouveMoi</span>

					<h1 class="tmv2-hero__title">
						Le bon prestataire, trouvé en
						<span>
							une phrase</span>
					</h1>

					<p class="tmv2-hero__lead">
						Des professionnels de confiance pour vous accompagner dans tous vos besoins, partout en France.
					</p>

					<div class="tmv2-hero__badges">
						<span class="tmv2-pill">
							<i class="fa-solid fa-circle-plus"></i>
							+ 1200
														prestataires
						</span>

						<span class="tmv2-pill">
							<i class="fa-solid fa-file-invoice"></i>
							Devis gratuits
						</span>

						<span class="tmv2-pill">
							<i class="fa-solid fa-shield-halved"></i>
							Paiement sécurisé
						</span>
					</div>
				</div>

				<div class="tmv2-hero__visual d-none d-lg-flex" aria-hidden="true">
					<div class="tmv2-pro-card">
						<div class="tmv2-pro-card__avatar">TM</div>
						<h3>Prestataires vérifiés</h3>
						<p>Comparez les profils, les avis et les disponibilités en quelques clics.</p>
						<ul class="tmv2-pro-card__tags" role="list">
							<li>Rapide</li>
							<li>Fiable</li>
							<li>Sécurisé</li>
						</ul>
					</div>

					<div class="tmv2-floating tmv2-floating--top">
						<span class="tmv2-floating__icon">
							<i class="fa-solid fa-check"></i>
						</span>
						<div>
							<strong>Devis acceptés</strong>
							<small>en temps réel</small>
						</div>
					</div>

					<div class="tmv2-floating tmv2-floating--bottom">
						<span class="tmv2-floating__icon tmv2-floating__icon--blue">
							<i class="fa-solid fa-bolt"></i>
						</span>
						<div>
							<strong>Demandes traitées</strong>
							<small>partout en France</small>
						</div>
					</div>
				</div>
			</div>
			{# RECHERCHE #}
			<div class="container tmv2-search-wrap mt-auto">
				{% include 'search/_homepage_search_toolbar.html.twig' with {
                formView: homepageSearchForm,
                toolbarClass: 'tm-homepage-search-toolbar--home'
            } only %}
			</div>
		</section>


		{# CHIFFRES CLÉS #}
		<section class="tmv2-chiffres-strip">
			{% set quickStats = [
        {
            value: '120 000+',
            label: 'prestataires actifs',
            icon: 'users'
        },
        {
            value: '890 000',
            label: 'avis clients vérifiés',
            icon: 'star'
        },
        {
            value: '< 2 h',
            label: 'de délai moyen de réponse',
            icon: 'bolt'
        },
        {
            value: '100 %',
            label: 'des paiements sécurisés',
            icon: 'shield'
        }
    ] %}

			<div class="container">
				<div class="tmv2-chiffres-strip__inner">
					{% for stat in quickStats %}
						<article class="tmv2-chiffre-item">
							<span class="tmv2-chiffre-item__icon" aria-hidden="true">
								{% if stat.icon == 'users' %}
									<svg width="22" height="22" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
										<circle cx="9" cy="8" r="3.5"/>
										<path d="M2 20c0-3.5 3-5.5 7-5.5s7 2 7 5.5"/>
										<path d="M16 4a3.5 3.5 0 0 1 0 7"/>
										<path d="M18 14.7c2.4.7 4 2.3 4 5.3"/>
									</svg>
								{% elseif stat.icon == 'star' %}
									<svg width="22" height="22" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/>
									</svg>
								{% elseif stat.icon == 'bolt' %}
									<svg width="22" height="22" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M13 2 4 14h6l-1 8 9-12h-6z"/>
									</svg>
								{% elseif stat.icon == 'shield' %}
									<svg width="22" height="22" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/>
										<path d="m9 12 2 2 4-4"/>
									</svg>
								{% endif %}
							</span>

							<div class="tmv2-chiffre-item__content">
								<div class="tmv2-chiffre-item__value">{{ stat.value }}</div>
								<div class="tmv2-chiffre-item__label">{{ stat.label }}</div>
							</div>
						</article>
					{% endfor %}
				</div>
			</div>
		</section>

		{# CATÉGORIES #}
		<section class="container tmv2-section tmv2-categories-section">
			<div class="tmv2-section-head tmv2-section-head--split">
				<div>
					<span class="tmv2-eyebrow tmv2-eyebrow--blue">Catégories populaires</span>
					<h2 class="tmv2-section-title">Un pro pour chaque besoin</h2>
				</div>

				<a href="{{ path('app_category_index') }}" class="tmv2-arrow-link">
					Voir toutes les catégories
					<i class="fa-solid fa-arrow-right"></i>
				</a>
			</div>

			{% set raw_categories = (categories ?? [])|slice(0, 10) %}
			{% set fallback_cats = [
        {name: 'Bâtiment & Travaux', icon: 'fa-hammer'},
        {name: 'Déménagement', icon: 'fa-truck-ramp-box'},
        {name: 'Nettoyage', icon: 'fa-sparkles'},
        {name: 'Jardin & Extérieur', icon: 'fa-tree'},
        {name: 'High-Tech', icon: 'fa-laptop'},
        {name: 'Événementiel', icon: 'fa-cake-candles'},
        {name: 'Bien-être', icon: 'fa-heart-pulse'},
        {name: 'Cours & Formations', icon: 'fa-book-open'},
        {name: 'Mécanique', icon: 'fa-wrench'},
        {name: 'Animaux', icon: 'fa-dog'}
    ] %}

			{% set display_categories = raw_categories is not empty ? raw_categories : fallback_cats %}

			<div class="tmv2-categories-grid">
				{% for category in display_categories %}
					<a href="{{ category.slug is defined ? path('app_category_show', {slug: category.slug}) : '#' }}" class="tmv2-category-card text-decoration-none">
						<span class="tmv2-category-card__icon">
							{% if category.icon %}
								<i class="fa-solid {{ category.icon }}"></i>
							{% else %}
								<span>{{ category.name|first|upper }}</span>
							{% endif %}
						</span>

						<h3 class="tmv2-category-card__title">{{ category.name }}</h3>

						<p class="tmv2-category-card__meta">
							Découvrir la catégorie
						</p>
					</a>
				{% endfor %}
			</div>
		</section>

{# PRESTATAIRES à la une #}
<section class="container tmv2-section mb-4">
    <div class="tmv2-section-head tmv2-section-head--split">
        <div>
            <span class="tmv2-eyebrow tmv2-eyebrow--blue">Prestataires à la une</span>
            <h2 class="tmv2-section-title">Les mieux notés du moment</h2>
        </div>
        <a href="{{ path('app_prestataire_browse') }}" class="tmv2-arrow-link">
            Voir tous les prestataires
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    <div class="row g-3" data-controller="scroll-reveal">
        {% for provider in providers|slice(0, 4) %}
            <div class="col-md-6 col-xl-3" data-scroll-reveal-target="element">
                <article class="tmv2-provider-card h-100 position-relative">
                    <a href="{{ path('app_prestataire_show', {slug: provider.slug}) }}" class="stretched-link"></a>

                    {% set isFavorite = provider.id in (favoriteProviderIds|default([])) %}
                    <button
                        type="button"
                        class="btn btn-light favorite-btn border-0 shadow-sm"
                        data-controller="favorite-toggle"
                        data-action="click->favorite-toggle#toggle"
                        data-favorite-toggle-url-value="{{ path('app_favorite_toggle') }}"
                        data-favorite-toggle-type-value="prestataire"
                        data-favorite-toggle-target-id-value="{{ provider.id }}"
                        data-favorite-toggle-csrf-token-value="{{ csrf_token('favorite_toggle') }}"
                        data-favorite-toggle-is-favorite-value="{{ isFavorite ? 'true' : 'false' }}"
                        data-favorite-toggle-login-url-value="{{ path('app_login') }}"
                        aria-pressed="{{ isFavorite ? 'true' : 'false' }}"
                        aria-label="{{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                    >
                        <i data-favorite-toggle-target="icon" class="{{ isFavorite ? 'fa-solid text-danger' : 'fa-regular text-muted' }} fa-heart"></i>
                    </button>

                    <div class="tmv2-provider-card__cover">
                        <img
                            src="{{ provider.logo ? asset('uploads/providers/' ~ provider.logo) : asset('images/img_par_defaut.png') }}"
                            alt="{{ provider.companyName }}"
                            class="tmv2-provider-card__cover-image"
                        >

                        <div class="tmv2-provider-card__cover-overlay"></div>

                        {% if provider.averageRating >= 4.8 %}
                            <span class="tmv2-provider-card__badge">Excellent ({{ provider.averageRating }})</span>
                        {% else %}
                            <span class="tmv2-provider-card__badge tmv2-provider-card__badge--muted">Top Prestataire</span>
                        {% endif %}

                        <span class="tmv2-provider-card__avatar">
                            {{ provider.companyName|slice(0, 2)|upper }}
                        </span>
                    </div>

                    <div class="tmv2-provider-card__body">
                        <h3 class="tmv2-provider-card__title">{{ provider.companyName }}</h3>
                        <p class="tmv2-provider-card__job">
                            {{ provider.metier ? provider.metier : 'Prestataire' }}
                        </p>

                        <div class="tmv2-provider-card__rating">
                            <i class="fa-solid fa-star"></i>
                            <span>{{ provider.averageRating|number_format(1, '.', '') }}</span>
                            <small>({{ provider.reviewsCount ?? 0 }} avis)</small>
                        </div>

                        <p class="tmv2-provider-card__city">
                            <i class="fa-solid fa-location-dot"></i>
                            {{ provider.city }}
                        </p>

                        <div class="tmv2-provider-card__footer">
                            <span>
                                <i class="fa-solid fa-file-circle-check"></i>
                                Devis gratuit
                            </span>
                        </div>
                    </div>
                </article>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center border-0 shadow-sm">
                    Aucun prestataire disponible pour le moment.
                </div>
            </div>
        {% endfor %}
    </div>
</section>

			{# POURQUOI TROUVEMOI #}
			<section class="tmv2-trust-section mt-4 mb-4">
				<div class="container tmv2-trust-inner">
					<div class="tmv2-trust-content">
						<span class="tmv2-eyebrow tmv2-eyebrow--warm">Pourquoi TrouveMoi</span>

						<h2 class="tmv2-trust-title">La confiance, notre métier</h2>

						<p class="tmv2-trust-intro">
							Chaque prestataire est contrôlé avant d'apparaître sur la plateforme.
							                Chaque avis provient d'une prestation réellement effectuée.
						</p>

						<div class="tmv2-trust-list">
							<div class="tmv2-trust-item">
								<span class="tmv2-trust-item__icon" aria-hidden="true">
									<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/>
										<path d="m9 12 2 2 4-4"/>
									</svg>
								</span>

								<div class="tmv2-trust-item__body">
									<h3>Des pros vérifiés</h3>
									<p>Identité, assurances et qualifications contrôlées avant la mise en ligne.</p>
								</div>
							</div>

							<div class="tmv2-trust-item">
								<span class="tmv2-trust-item__icon" aria-hidden="true">
									<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/>
									</svg>
								</span>

								<div class="tmv2-trust-item__body">
									<h3>Avis 100 % authentiques</h3>
									<p>Seuls les clients ayant réservé peuvent laisser un avis. Aucun avis acheté.</p>
								</div>
							</div>

							<div class="tmv2-trust-item">
								<span class="tmv2-trust-item__icon" aria-hidden="true">
									<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
										<rect x="3" y="10" width="18" height="11" rx="2"/>
										<path d="M7 10V7a5 5 0 0 1 10 0v3"/>
									</svg>
								</span>

								<div class="tmv2-trust-item__body">
									<h3>Paiement protégé</h3>
									<p>L'argent est bloqué jusqu'à validation de la prestation. Litige ? On vous accompagne.</p>
								</div>
							</div>
						</div>
					</div>

					<aside class="tmv2-trust-panel" aria-label="Indicateurs de confiance">
						<div class="tmv2-trust-score">
							4,8<span>/5</span>
						</div>

						<div class="tmv2-trust-stars" aria-label="4,8 étoiles sur 5">
							<svg width="22" height="22" viewbox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/></svg>
							<svg width="22" height="22" viewbox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/></svg>
							<svg width="22" height="22" viewbox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/></svg>
							<svg width="22" height="22" viewbox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/></svg>
							<svg width="22" height="22" viewbox="0 0 24 24" fill="currentColor" opacity=".35"><path d="M12 2l3 6.6 7 .8-5.2 4.8L18.3 21 12 17.4 5.7 21l1.5-6.8L2 9.4l7-.8z"/></svg>
						</div>

						<p class="tmv2-trust-panel__text">
							Note moyenne calculée sur 890 000 avis vérifiés, mise à jour chaque jour.
						</p>

						<hr class="tmv2-trust-panel__divider">

						<div class="tmv2-trust-mini-stats">
							<div class="tmv2-trust-mini-stat">
								<div class="tmv2-trust-mini-stat__value">96 %</div>
								<div class="tmv2-trust-mini-stat__label">de clients satisfaits</div>
							</div>

							<div class="tmv2-trust-mini-stat">
								<div class="tmv2-trust-mini-stat__value">72 %</div>
								<div class="tmv2-trust-mini-stat__label">refont appel au même pro</div>
							</div>
						</div>
					</aside>
				</div>
			</section>

			{# AVIS #}
			<section class="container tmv2-section mb-4" data-controller="scroll-reveal">
				<div class="tmv2-section-head tmv2-section-head--center" data-scroll-reveal-target="element">
					<span class="tmv2-eyebrow tmv2-eyebrow--blue">Ils nous font confiance</span>
					<h2 class="tmv2-section-title">Ce que nos utilisateurs pensent de nous</h2>
					<p class="tmv2-section-subtitle">Plus de 10 000 avis certifiés pour vous aider à choisir en toute sérénité.</p>
				</div>

				<div class="row g-4">
					{% for i in 1..3 %}
						<div class="col-md-4" data-scroll-reveal-target="element">
							<article class="tmv2-review-card h-100">
								<span class="tmv2-review-card__quote">“</span>
								<p class="tmv2-review-card__text">Une expérience exceptionnelle ! J'ai trouvé un plombier en moins de 30 minutes. Service rapide, efficace et très professionnel.</p>
								<div class="tmv2-review-card__footer">
									<img src="https://ui-avatars.com/api/?name=User+{{ i }}&background=random" class="tmv2-review-card__avatar" alt="Utilisateur">
									<div>
										<h5>Jean D.</h5>
										<small>Prestation : Plomberie</small>
									</div>
									<div class="tmv2-review-card__stars">
										<i class="fa-solid fa-star"></i>
										<i class="fa-solid fa-star"></i>
										<i class="fa-solid fa-star"></i>
										<i class="fa-solid fa-star"></i>
										<i class="fa-solid fa-star"></i>
									</div>
								</div>
							</article>
						</div>
					{% endfor %}
				</div>
			</section>


			{# STEPS #}
			<section class="container tmv2-steps-band-section mb-4" data-controller="scroll-reveal">
				<div class="tmv2-steps-band">
					<div class="tmv2-steps-band__head" data-scroll-reveal-target="element">
						<div class="tmv2-steps-band__intro">
							<span class="tmv2-eyebrow tmv2-eyebrow--light">Comment ça marche</span>
							<h2 class="tmv2-steps-band__title">Votre projet commence ici</h2>
							<p class="tmv2-steps-band__subtitle">
								6 étapes simples pour une collaboration réussie
							</p>
						</div>

						<div class="tmv2-steps-band__actions">
							<a href="/register" class="tmv2-steps-band__btn tmv2-steps-band__btn--primary">
								Créer mon compte maintenant
							</a>
						</div>
					</div>

					{% set steps = [
            {icon: 'fa-magnifying-glass', label: '1. Recherchez', desc: 'Trouvez le pro idéal parmi nos experts.', bg: '#f0f4ff', color: '#061b56'},
            {icon: 'fa-user-plus', label: '2. Inscrivez-vous', desc: 'Créez votre compte en quelques secondes.', bg: '#eef2ff', color: '#4338ca'},
            {icon: 'fa-address-card', label: '3. Complétez', desc: 'Remplissez vos besoins sur mesure.', bg: '#fdf2f8', color: '#db2777'},
            {icon: 'fa-sliders', label: '4. Comparez', desc: 'Analysez les avis en toute confiance.', bg: '#fff1f2', color: '#e11d48'},
            {icon: 'fa-comments', label: '5. Échangez', desc: 'Discutez avec le prestataire choisi.', bg: '#f0fdf4', color: '#16a34a'},
            {icon: 'fa-circle-check', label: '6. Réalisez', desc: 'Validez votre projet sereinement.', bg: '#fffbeb', color: '#d97706'}
        ] %}

					<div class="row g-3 g-lg-4 tmv2-steps-band__grid">
						{% for step in steps %}
							<div class="col-md-6 col-lg-4" data-scroll-reveal-target="element">
								<article class="tmv2-steps-band-card h-100">
									<div class="tmv2-steps-band-card__top">
										<div class="tmv2-steps-band-card__icon" style="background: {{ step.bg }}; color: {{ step.color }};">
											<i class="fa-solid {{ step.icon }}"></i>
										</div>

										<span class="tmv2-steps-band-card__number">
											{{ "%02d"|format(loop.index) }}
										</span>
									</div>

									<h3 class="tmv2-steps-band-card__label">{{ step.label }}</h3>
									<p class="tmv2-steps-band-card__desc">{{ step.desc }}</p>
								</article>
							</div>
						{% endfor %}
					</div>

					<div class="tmv2-steps-band__footer" data-scroll-reveal-target="element">
						<div class="tmv2-steps-band__points">
							<span>
								<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
									<path d="M20 6 9 17l-5-5"/>
								</svg>
								Devis gratuits
							</span>

							<span>
								<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
									<path d="M20 6 9 17l-5-5"/>
								</svg>
								Prestataires vérifiés
							</span>

							<span>
								<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
									<path d="M20 6 9 17l-5-5"/>
								</svg>
								Paiement sécurisé
							</span>
						</div>

						<a href="/register" class="tmv2-steps-band__btn tmv2-steps-band__btn--ghost">
							Commencer maintenant
						</a>
					</div>
				</div>
			</section>

			{# FAQ #}
			<section class="tmv2-faq-section" style="padding-top:0">
				<div class="container">
					<div class="tmv2-faq-head" data-scroll-reveal-target="element">
						<div class="tmv2-faq-head__inner">
							<span class="tmv2-eyebrow tmv2-eyebrow--center">Questions fréquentes</span>
							<h2 class="tmv2-faq-title">On répond à tout</h2>
						</div>
					</div>

					<div class="tmv2-faq-list">
						<details class="tmv2-faq-item" open>
							<summary>
								Les devis sont-ils vraiment gratuits ?
								<span class="tmv2-faq-item__plus" aria-hidden="true">
									<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
										<path d="M12 5v14M5 12h14"/>
									</svg>
								</span>
							</summary>
							<p class="tmv2-faq-item__answer">
								Oui, à 100 %. Vous décrivez votre besoin, les prestataires vous envoient leurs devis, et vous comparez librement.
								                    Vous ne payez que si vous décidez de réserver une prestation.
							</p>
						</details>

						<details class="tmv2-faq-item">
							<summary>
								Comment les prestataires sont-ils vérifiés ?
								<span class="tmv2-faq-item__plus" aria-hidden="true">
									<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
										<path d="M12 5v14M5 12h14"/>
									</svg>
								</span>
							</summary>
							<p class="tmv2-faq-item__answer">
								Avant d'apparaître sur la plateforme, chaque professionnel doit fournir une pièce d'identité, un justificatif
								                    d'immatriculation (SIRET) et ses attestations d'assurance. Nous vérifions ces documents un par un.
							</p>
						</details>

						<details class="tmv2-faq-item">
							<summary>
								Comment fonctionne le paiement sécurisé ?
								<span class="tmv2-faq-item__plus" aria-hidden="true">
									<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
										<path d="M12 5v14M5 12h14"/>
									</svg>
								</span>
							</summary>
							<p class="tmv2-faq-item__answer">
								Lors de la réservation, votre paiement est conservé sur un compte sécurisé. Le prestataire est payé uniquement
								                    lorsque vous confirmez que la prestation est terminée et conforme.
							</p>
						</details>

						<details class="tmv2-faq-item">
							<summary>
								Que se passe-t-il en cas de litige ?
								<span class="tmv2-faq-item__plus" aria-hidden="true">
									<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
										<path d="M12 5v14M5 12h14"/>
									</svg>
								</span>
							</summary>
							<p class="tmv2-faq-item__answer">
								Notre équipe support intervient sous 24 h. Tant que le litige n'est pas résolu, les fonds restent bloqués.
								                    Vous pouvez ouvrir un dossier directement depuis votre espace client.
							</p>
						</details>

						<details class="tmv2-faq-item">
							<summary>
								Puis-je annuler une réservation ?
								<span class="tmv2-faq-item__plus" aria-hidden="true">
									<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
										<path d="M12 5v14M5 12h14"/>
									</svg>
								</span>
							</summary>
							<p class="tmv2-faq-item__answer">
								Oui, gratuitement jusqu'à 48 h avant la prestation. Passé ce délai, les conditions d'annulation du prestataire
								                    s'appliquent — elles sont toujours affichées avant votre réservation.
							</p>
						</details>
