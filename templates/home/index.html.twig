                                <span class="badge bg-primary position-absolute start-0 top-0 m-2 text-white fw-medium border-0 px-2 py-1" style="font-size: 11px; background-color: #2046D8 !important;">Réponse rapide</span>
                            </div>
                            <div class="card-body p-3 text-start position-relative">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white position-absolute shadow-sm" style="width: 36px; height: 36px; top: -18px; left: 15px; background-color: #2046D8; border: 3px solid #fff;">
                                    <i class="bi bi-lightning-charge-fill small"></i>
                                </div>
