{% extends 'base.html.twig' %}

{% block title %}TrouveMoi Prestataires - Accueil{% endblock %}

{% block body %}
<div class="homepage-wrapper bg-light" style="font-family: 'Poppins', sans-serif; color: #061B56;">

    {# 1. SECTION HERO AVEC IMAGE D'ARRIÈRE-PLAN #}
    <div class="hero-section position-relative text-white py-5" style="background: linear-gradient(to right, rgba(6, 27, 86, 0.95) 40%, rgba(6, 27, 86, 0.4) 100%), url('{{ asset('images/bg-hero-worker.jpg') }}') no-repeat center center / cover; min-height: 400px; padding-bottom: 90px !important;">
        <div class="container pt-4">
            <div class="row">
                <div class="col-lg-7 text-start">
                    <h1 class="display-5 fw-bold mb-3" style="font-weight: 800 !important; letter-spacing: -1px; line-height: 1.2;">
                        Trouvez le prestataire idéal <br>
                        <span style="color: #F4A911;">pour tous vos projets</span>
                    </h1>
                    
                    <p class="fs-5 mb-4 opacity-90" style="max-width: 540px; font-weight: 400; line-height: 1.5;">
                        Des professionnels de confiance pour vous accompagner dans tous vos besoins, partout en France.
                    </p>
                    
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <span class="badge d-flex align-items-center gap-2 px-3 py-2 border border-white border-opacity-20 rounded-2" style="background: rgba(255, 255, 255, 0.1); font-size: 13px; font-weight: 500;">
                            <i class="bi bi-plus-circle-fill text-warning"></i> + 120 000 prestataires
                        </span>
                        <span class="badge d-flex align-items-center gap-2 px-3 py-2 border border-white border-opacity-20 rounded-2" style="background: rgba(255, 255, 255, 0.1); font-size: 13px; font-weight: 500;">
                            <i class="bi bi-star-fill text-warning"></i> Avis clients vérifiés
                        </span>
                        <span class="badge d-flex align-items-center gap-2 px-3 py-2 border border-white border-opacity-20 rounded-2" style="background: rgba(255, 255, 255, 0.1); font-size: 13px; font-weight: 500;">
                            <i class="bi bi-file-earmark-text-fill text-warning"></i> Devis gratuits
                        </span>
                        <span class="badge d-flex align-items-center gap-2 px-3 py-2 border border-white border-opacity-20 rounded-2" style="background: rgba(255, 255, 255, 0.1); font-size: 13px; font-weight: 500;">
                            <i class="bi bi-shield-lock-fill text-warning"></i> Paiement sécurisé
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 2. BARRE DE RECHERCHE EN CHEVAUCHEMENT (OVERLAP) #}
    <div class="container position-relative z-3" style="margin-top: -50px;">
        <div class="card border-0 shadow-lg p-3 rounded-4 bg-white">
            <form action="#" method="GET" class="row g-3 align-items-center">
                <!-- Quoi -->
                <div class="col-md-6 col-lg-3 border-end-lg">
                    <div class="d-flex align-items-start gap-2 px-2">
                        <i class="bi bi-geo-alt text-primary fs-5 mt-1" style="color: #2046D8 !important;"></i>
                        <div class="w-100">
                            <label class="form-label small fw-bold mb-0 text-dark">Que recherchez-vous ?</label>
                            <input type="text" class="form-control form-control-sm border-0 p-0 text-muted fs-7 bg-transparent" placeholder="Ex : Plomberie, Peinture, Nettoyage...">
                        </div>
                    </div>
                </div>
                <!-- Type -->
                <div class="col-md-6 col-lg-3 border-end-lg">
                    <div class="d-flex align-items-start gap-2 px-2">
                        <i class="bi bi-person text-primary fs-5 mt-1" style="color: #2046D8 !important;"></i>
                        <div class="w-100">
                            <label class="form-label small fw-bold mb-0 text-dark">Type de prestation</label>
                            <select class="form-select form-select-sm border-0 p-0 text-muted fs-7 bg-transparent shadow-none" style="cursor: pointer;">
                                <option>Service, Réparation, Installation...</option>
                            </select>
                        </div>
                    </div>
                </div>
                <!-- Où -->
                <div class="col-md-6 col-lg-3 border-end-lg">
                    <div class="d-flex align-items-start gap-2 px-2">
                        <i class="bi bi-geo text-primary fs-5 mt-1" style="color: #2046D8 !important;"></i>
                        <div class="w-100">
                            <label class="form-label small fw-bold mb-0 text-dark">Où ?</label>
                            <input type="text" class="form-control form-control-sm border-0 p-0 text-muted fs-7 bg-transparent" placeholder="Ville, département, code postal...">
                        </div>
                    </div>
                </div>
                <!-- Quand -->
                <div class="col-md-6 col-lg-2">
                    <div class="d-flex align-items-start gap-2 px-2">
                        <i class="bi bi-calendar3 text-primary fs-5 mt-1" style="color: #2046D8 !important;"></i>
                        <div class="w-100">
                            <label class="form-label small fw-bold mb-0 text-dark">Quand ?</label>
                            <input type="text" class="form-control form-control-sm border-0 p-0 text-muted fs-7 bg-transparent" placeholder="Date souhaitée">
                        </div>
                    </div>
                </div>
                <!-- Bouton -->
                <div class="col-12 col-lg-1">
                    <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold" style="background-color: #2046D8; border: 0;">
                        Rechercher
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# 3. SECTION CATÉGORIES POPULAIRES #}
    <div class="container my-5 pt-3">
        <div class="mb-4 text-start">
            <h2 class="fw-bold h4 mb-1 text-dark" style="font-weight: 800 !important; letter-spacing: -0.5px;">Catégories populaires</h2>
        </div>

        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-stretch">
            {# Boucle dynamique sur vos catégories injectées #}
            {% for category in categories|slice(0, 10) %}
                <div class="flex-grow-1 text-center" style="min-width: 100px; max-width: 115px;">
                    <a href="#" class="card h-100 border-0 shadow-sm p-3 text-decoration-none tm-category-card rounded-3 bg-white d-flex flex-column align-items-center justify-content-center">
                        <div class="d-flex align-items-center justify-content-center rounded-circle mb-2 bg-light-subtle text-primary" style="width: 46px; height: 46px; background-color: #F1F5FF; color: #2046D8 !important;">
                            <span class="fw-bold fs-5">{{ category.name|slice(0, 1)|upper }}</span>
                        </div>
                        <span class="text-dark fw-bold text-truncate w-100" style="font-size: 12px; font-weight: 700 !important;">{{ category.name }}</span>
                    </a>
                </div>
            {% else %}
                {# Fallback statique conforme au visuel de l'image si la BDD est vide temporairement #}
                {% set fallback_cats = ['Maison & Travaux', 'Déménagement', 'Nettoyage', 'Jardinage', 'Informatique', 'Événementiel', 'Bien-être', 'Cours & Soutien', 'Réparation auto', 'Petits travaux'] %}
                {% for cat in fallback_cats %}
                    <div class="flex-grow-1 text-center" style="min-width: 100px; max-width: 115px;">
                        <a href="#" class="card h-100 border-0 shadow-sm p-3 text-decoration-none tm-category-card rounded-3 bg-white d-flex flex-column align-items-center justify-content-center">
                            <div class="d-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 46px; height: 46px; background-color: #F1F5FF; color: #2046D8;">
                                <i class="bi bi-house-door fs-5"></i>
                            </div>
                            <span class="text-dark fw-bold text-wrap line-clamp-2" style="font-size: 12px; font-weight: 700 !important; line-height: 1.2;">{{ cat }}</span>
                        </a>
                    </div>
                {% endfor %}
            {% endfor %}

            <!-- Bouton "Voir toutes les catégories" -->
            <div class="flex-grow-1 text-center" style="min-width: 120px; max-width: 130px;">
                <a href="#" class="card h-100 border border-dashed p-2 text-decoration-none rounded-3 bg-white d-flex flex-row align-items-center justify-content-center gap-2 shadow-xs" style="border-color: #DDE2EA !important;">
                    <span class="text-dark fw-bold text-start" style="font-size: 12px; font-weight: 800 !important; line-height: 1.3;">Voir toutes<br>les catégories</span>
                    <i class="bi bi-chevron-right text-muted" style="font-size: 12px;"></i>
                </a>
            </div>
        </div>
    </div>

