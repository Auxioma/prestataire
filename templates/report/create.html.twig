{% extends 'base.html.twig' %}

{% block title %}Signaler un contenu{% endblock %}

{% block body %}
    <section class="container py-4 py-lg-5">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <a href="{{ backUrl }}" class="tm-client-quotes-backlink mb-4 d-inline-flex">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    <span>Retour</span>
                </a>

                {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <section class="card shadow-sm border-0">
                    <div class="card-body p-4 p-lg-5">
                        <span class="text-uppercase small text-muted">Modération</span>
                        <h1 class="h3 mt-2 mb-2">{{ contextTitle }}</h1>
                        <p class="text-muted mb-4">{{ contextDescription }}</p>

                        {{ form_start(form) }}
                            <div class="mb-3">
                                {{ form_label(form.reason) }}
                                {{ form_widget(form.reason, { attr: { class: 'form-select' ~ (form.reason.vars.errors|length > 0 ? ' is-invalid' : '') } }) }}
                                {% if form.reason.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.reason) }}</div>
                                {% endif %}
                            </div>

                            <div class="mb-4">
                                {{ form_label(form.message) }}
                                {{ form_widget(form.message, { attr: { class: 'form-control' ~ (form.message.vars.errors|length > 0 ? ' is-invalid' : '') } }) }}
                                {% if form.message.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.message) }}</div>
                                {% endif %}
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-danger">Envoyer le signalement</button>
                                <a href="{{ backUrl }}" class="btn btn-outline-secondary">Annuler</a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </section>
            </div>
        </div>
    </section>
{% endblock %}
