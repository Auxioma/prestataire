{% extends 'base.html.twig' %}

{% block title %}Connexion - TrouveMoi Prestataires
{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/login/login.css') }}">{% endblock %}

{% block body %}
    <div class="tm-login-page">
        <div class="tm-login-layout">

            <section class="tm-login-hero" aria-labelledby="login-hero-title">
                <a class="tm-login-brand" href="{{ path('app_home') }}" aria-label="TrouveMoi - Accueil">
                    <img src="{{ asset('images/logo_trouvemoipresta_black.png') }}" alt="" class="tm-login-brand__logo" width="677" height="369" loading="lazy">
                    <div class="tm-login-brand__text">
                        <span class="tm-login-brand__title">TrouveMoi</span>
                        <span class="tm-login-brand__subtitle">PRESTATAIRES</span>
                    </div>
                </a>

                <h1 class="tm-login-hero__title" id="login-hero-title">
                    Trouvez le bon prestataire,<br>
                    au bon moment.
                </h1>

                <p class="tm-login-hero__subtitle">
                    Des professionnels qualifiés près de chez vous pour tous vos projets et services du quotidien.
                </p>

                <div class="tm-login-feature-list">
                    <div class="tm-login-feature">
                        <div class="tm-login-feature__icon tm-login-feature__icon--blue">
                            <img src="{{ asset('images/categories/icons/shield-halved-solid.png') }}" alt="" width="640" height="640" loading="lazy" aria-hidden="true">
                        </div>
                        <div class="tm-login-feature__content">
                            <strong>Prestataires vérifiés</strong>
                            <span>Des professionnels évalués et de confiance.</span>
                        </div>
                    </div>

                    <div class="tm-login-feature">
                        <div class="tm-login-feature__icon tm-login-feature__icon--yellow">
                            <img src="{{ asset('images/categories/icons/star-regular.png') }}" alt="" width="640" height="640" loading="lazy" aria-hidden="true">
                        </div>
                        <div class="tm-login-feature__content">
                            <strong>Avis clients authentiques</strong>
                            <span>Faites le bon choix grâce aux retours d'expérience.</span>
                        </div>
                    </div>

                    <div class="tm-login-feature">
                        <div class="tm-login-feature__icon tm-login-feature__icon--green">
                            <img src="{{ asset('images/categories/icons/lock-solid.png') }}" alt="" width="640" height="640" loading="lazy" aria-hidden="true">
                        </div>
                        <div class="tm-login-feature__content">
                            <strong>Paiement sécurisé</strong>
                            <span>Vos transactions sont protégées à chaque étape.</span>
                        </div>
                    </div>
                </div>

                <div class="tm-login-hero__image-wrap">
                    <img src="{{ asset('images/categories/img/worker2.webp') }}" alt="Prestataire" class="tm-login-hero__image" width="546" height="390" loading="lazy" fetchpriority="high">
                </div>
            </section>

            <section class="tm-login-panel" aria-labelledby="login-form-title">
                <div class="tm-login-card">
                    <div class="tm-login-switch">
                        <span class="tm-login-switch__link tm-login-switch__link--active" aria-current="page">Se connecter</span>
                        <a href="{{ path('app_register_choice') }}" class="tm-login-switch__link">S'inscrire</a>
                    </div>

                    <h2 class="tm-login-card__title" id="login-form-title">Bon retour !</h2>

                    <p class="tm-login-card__subtitle">
                        Connectez-vous pour accéder à votre compte.
                    </p>

                    {% for message in app.flashes('success') %}
                        <div class="tm-login-alert tm-login-alert--success" role="alert">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('registration_email_confirmation_notice') %}
                        <div class="tm-login-alert tm-login-alert--success" role="alert">
                            <i class="bi bi-envelope-check-fill"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('registration_email_delivery_warning') %}
                        <div class="tm-login-alert tm-login-alert--error" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('reset_password_error') %}
                        <div class="tm-login-alert tm-login-alert--error" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('verify_email_error') %}
                        <div class="tm-login-alert tm-login-alert--error" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('warning') %}
                        <div class="tm-login-alert tm-login-alert--error" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}

                    {% if error %}
                        {% set translatedError = error.messageKey|trans(error.messageData, 'security') %}
                        <div class="alert alert-danger" id="login-error" role="alert">
                            <div>{{ translatedError }}</div>
                            {% if translatedError == 'Veuillez vérifier votre adresse email avant de vous connecter.' and last_username %}
                                <form method="post" action="{{ path('app_resend_verification_email') }}" class="mt-3">
                                    <input type="hidden" name="email" value="{{ last_username }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('resend_verification_email') }}">
                                    <button type="submit" class="btn btn-link p-0 align-baseline">
                                        Renvoyer l’email de vérification
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    {% endif %}

                    <form method="post" class="tm-login-form">
                        <div class="tm-login-field">
                            <i class="bi bi-envelope tm-login-field__icon" aria-hidden="true"></i>
                            <label class="visually-hidden" for="login-email">Adresse e-mail</label>
                            <input type="email" id="login-email" name="_username" value="{{ last_username }}" placeholder="Adresse e-mail" autocomplete="email" required class="tm-login-field__input" {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
                        </div>

                        <div class="tm-login-field" data-controller="password">
                            <i class="bi bi-lock tm-login-field__icon" aria-hidden="true"></i>

                            <label class="visually-hidden" for="password">Mot de passe</label>
                            <input type="password" id="password" name="_password" placeholder="Mot de passe" autocomplete="current-password" required class="tm-login-field__input" data-password-target="input" {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>

                            <button type="button" class="tm-login-field__toggle" data-password-target="toggle" data-action="click->password#toggleVisibility" aria-label="Afficher ou masquer le mot de passe" aria-controls="password" aria-pressed="false"></button>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="tm-login-form__forgot">
                            <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
                        </div>

                        <button type="submit" class="tm-login-form__submit">
                            Se connecter
                        </button>

                        <div class="tm-login-form__separator">
                            <span>ou</span>
                        </div>

                        <a href="{{ path('connect_google_start') }}" class="tm-login-social-btn" data-turbo="false" data-turbo-prefetch="false">
                            <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="" width="24" height="24" loading="lazy" aria-hidden="true">
                            Continuer avec Google
                        </a>

                        <button type="button" class="tm-login-social-btn">
                            <img src="{{ asset('images/categories/icons/apple.png') }}" alt="" width="640" height="640" loading="lazy" aria-hidden="true">
                            Continuer avec Apple
                        </button>

                        <p class="tm-login-form__register">
                            Vous n'avez pas de compte ?
                            <a href="{{ path('app_register_choice') }}">S'inscrire</a>
                        </p>
                    </form>
                </div>

                <div class="tm-login-benefits">
                    <div class="tm-login-benefit-card">
                        <div class="tm-login-benefit-card__head">
                            <div class="tm-login-benefit-card__icon tm-login-benefit-card__icon--blue">
                                <img src="{{ asset('images/categories/icons/shield-halved-solid.png') }}" alt="" width="640" height="640" loading="lazy" aria-hidden="true">
                            </div>
                            <strong>Données sécurisées</strong>
                        </div>
                        <span>Vos informations sont protégées</span>
                    </div>

                    <div class="tm-login-benefit-card">
                        <div class="tm-login-benefit-card__head">
                            <div class="tm-login-benefit-card__icon tm-login-benefit-card__icon--green">
                                <img src="{{ asset('images/categories/icons/circle-check-regular-full.svg') }}" alt="" width="32" height="32" loading="lazy" aria-hidden="true">
                            </div>
                            <strong>Gratuit</strong>
                        </div>
                        <span>L'inscription et la demande de devis sont gratuites</span>
                    </div>

                    <div class="tm-login-benefit-card">
                        <div class="tm-login-benefit-card__head">
                            <div class="tm-login-benefit-card__icon tm-login-benefit-card__icon--yellow">
                                <img src="{{ asset('images/categories/icons/headset-solid-full.svg') }}" alt="" width="32" height="32" loading="lazy" aria-hidden="true">
                            </div>
                            <strong>Support 7j/7</strong>
                        </div>
                        <span>Notre équipe vous accompagne à chaque étape</span>
                    </div>

                    <div class="tm-login-benefit-card">
                        <div class="tm-login-benefit-card__head">
                            <div class="tm-login-benefit-card__icon tm-login-benefit-card__icon--purple">
                                <img src="{{ asset('images/categories/icons/star-regular.png') }}" alt="" width="640" height="640" loading="lazy" aria-hidden="true">
                            </div>
                            <strong>Satisfaction garantie</strong>
                        </div>
                        <span>Votre satisfaction est notre priorité</span>
                    </div>
                </div>
            </section>

        </div>
    </div>
{% endblock %}
