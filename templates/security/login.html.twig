{% extends 'base.html.twig' %}

{% block title %}Connexion - TrouveMoi
{% endblock %}

{% block body %}
	<div class="container my-5">
		<div class="row justify-content-center">
			<div class="col-lg-4 col-md-6">
				<div class="card border-0 shadow-lg rounded-4 overflow-hidden">

					<div class="card-header bg-gradient bg-primary text-white text-center py-4 border-0">
						<h2 class="h3 fw-bold mb-1">Ravi de vous revoir</h2>
						<p class="mb-0 text-white-50 small">Connectez-vous à votre espace TrouveMoi</p>
					</div>

					<div class="card-body p-4 p-sm-5">
						<form method="post">
							{% if error %}
								<div class="alert alert-danger rounded-3 p-3 mb-4 small" role="alert">
									{{ error.messageKey|trans(error.messageData, 'security') }}
								</div>
							{% endif %}

							{% if app.user %}
								<div class="alert alert-info small mb-3">
									Vous êtes connecté en tant que
									{{ app.user.userIdentifier }},
									<a href="{{ path('app_logout') }}" class="fw-bold text-decoration-none">Déconnexion</a>
								</div>
							{% endif %}

							<div class="mb-3">
								<label for="username" class="form-label fw-semibold text-muted small">Adresse e-mail</label>
								<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control form-control-lg rounded-3 shadow-sm" autocomplete="email" required autofocus placeholder="nom@exemple.com">
							</div>

							<div class="mb-4">
								<label for="password" class="form-label fw-semibold text-muted small">Mot de passe</label>
								<input type="password" name="_password" id="password" class="form-control form-control-lg rounded-3 shadow-sm" autocomplete="current-password" required placeholder="••••••••">
							</div>

							{# Jeton CSRF pour sécuriser le formulaire contre les failles de sécurité #}
							<input
							type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

							{# Optionnel : Case "Se souvenir de moi" (à activer plus tard si besoin)
							                        <div class="form-check mb-4">
							                            <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
							                            <label class="form-check-label small text-muted" for="_remember_me">Se souvenir de moi</label>
							                        </div>
							                        #}

							<button type="submit" class="btn btn-primary btn-lg w-100 py-3 rounded-3 fw-bold shadow bg-gradient transition-all hover-lift">
								Se connecter
							</button>

							<div class="d-flex align-items-center my-4">
								<hr class="flex-grow-1 text-muted">
								<span class="mx-3 text-muted small fw-semibold text-uppercase">ou</span>
								<hr class="flex-grow-1 text-muted">
							</div>

							<a href="{{ path('connect_google_start') }}" class="btn btn-outline-dark w-100 py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center shadow-sm">
								<svg class="me-2" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewbox="0 0 48 48">
									<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
									<path fill="#4285F4" d="M46.5 24c0-1.61-.15-3.16-.42-4.69H24v8.89h12.62c-.54 2.85-2.16 5.27-4.57 6.88l7.1 5.5C43.34 36.16 46.5 30.65 46.5 24z"/>
									<path fill="#FBBC05" d="M10.54 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.98-6.19z"/>
									<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.1-5.5c-1.97 1.32-4.49 2.11-8.79 2.11-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
								</svg>
								Se connecter avec Google
							</a>
						</form>
					</div>

					<div class="card-footer bg-light text-center py-3 border-0">
						<span class="text-muted small">Pas encore de compte ?
							<a href="{{ path('app_register') }}" class="text-decoration-none fw-semibold">Inscription</a>
						</span>
					</div>

				</div>
			</div>
		</div>
	</div>

	<style>
		.hover-lift {
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}
		.hover-lift:hover {
			transform: translateY(-2px);
			box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
		}
	</style>
{% endblock %}
