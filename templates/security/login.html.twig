{% extends 'base.html.twig' %}

{% block title %}Connexion - TrouveMoi Prestataires
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/login/login.css') }}">
{% endblock %}

{% block body %}
	<div class="tm-login-page">

		<div
			class="tm-login-wrapper">

			{# ================= LEFT ================= #}
			<div class="tm-left">

				<a class="tm-logo d-flex align-items-center gap-2 text-decoration-none py-0" href="{{ path('app_home') }}">
					<img src="{{ asset('images/logo_trouvemoipresta_black.png') }}" alt="Logo TrouveMoi" class="brand-logo">
					<div class="d-flex flex-column lh-1">
						<span class="brand-title mb-0">TrouveMoi</span>
						<span class="brand-subtitle">PRESTATAIRES</span>
					</div>
				</a>

				<h1>
					Trouvez le bon prestataire,<br>
					au bon moment.
				</h1>

				<p class="tm-subtitle">
					Des professionnels qualifiés près de chez vous pour tous vos projets et services du quotidien.
				</p>

				<div class="tm-features">

					<div class="tm-feature">
						<div class="icon blue">
							<img src="{{ asset('images/categories/icons/shield-halved-solid.png') }}" alt="shield-icon">
						</div>
						<div>
							<strong>Prestataires vérifiés</strong>
							<span>Des professionnels évalués et de confiance.</span>
						</div>
					</div>

					<div class="tm-feature">
						<div class="icon yellow">
							<img src="{{ asset('images/categories/icons/star-regular.png') }}" alt="star-icon">
						</div>
						<div>
							<strong>Avis clients authentiques</strong>
							<span>Faites le bon choix grâce aux retours d'expérience.</span>
						</div>
					</div>

					<div class="tm-feature">
						<div class="icon green">
							<img src="{{ asset('images/categories/icons/lock-solid.png') }}" alt="lock-icon">
						</div>
						<div>
							<strong>Paiement sécurisé</strong>
							<span>Vos transactions sont protégées à chaque étape.</span>
						</div>
					</div>

				</div>

				<div class="tm-worker">

					<img src="{{ asset('images/categories/img/worker2.png') }}" alt="Prestataire">

				</div>

			</div>

			{# ================= RIGHT ================= #}
			<div class="tm-right">

				<div class="tm-form-card">

					<div class="tm-tabs">
						<a class="active">Se connecter</a>

						<a href="{{ path('app_register_choice') }}">
							S'inscrire
						</a>
					</div>

					<h2>Bon retour !</h2>

					<p class="welcome">
						Connectez-vous pour accéder à votre compte.
					</p>

					{% if error %}
						<div class="alert alert-danger">
							{{ error.messageKey|trans(error.messageData, 'security') }}
						</div>
					{% endif %}

					<form method="post">

						<div class="tm-input">
							<i class="bi bi-envelope"></i>

							<input type="email" name="_username" value="{{ last_username }}" placeholder="Adresse e-mail" required>
						</div>

						<div class="tm-input">
							<i class="bi bi-lock"></i>

							<input type="password" id="password" name="_password" placeholder="Mot de passe" required>

							<button type="button" id="passwordToggle">
								<i class="bi bi-eye"></i>
							</button>
						</div>

						<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

						<div class="forgot">
							<a href="#">Mot de passe oublié ?</a>
						</div>

						<button class="tm-submit">
							Se connecter
						</button>

						<div class="separator">
							<span>ou</span>
						</div>

						<a href="{{ path('connect_google_start') }}" class="social-btn">

							<img src="https://www.svgrepo.com/show/475656/google-color.svg">
							Continuer avec Google
						</a>

						<button type="button" class="social-btn">

							<img src="{{ asset('images/categories/icons/apple.png') }}" alt="apple-icon">
							Continuer avec Apple

						</button>

						<p class="register">
							Vous n'avez pas de compte ?

							<a href="{{ path('app_register_choice') }}">
								S'inscrire
							</a>
						</p>

					</form>

				</div>

				<div class="tm-bottom-features">

					<div class="tm-bottom-feature-item">
						<div class="feature-header">
							<div class="mini-icon mini-blue">
								<img src="{{ asset('images/categories/icons/shield-halved-solid.png') }}" alt="shield-icon">
							</div>
							<strong>Données sécurisées</strong>
						</div>
						<span>Vos informations sont protégées</span>
					</div>

					<div class="tm-bottom-feature-item">
						<div class="feature-header">
							<div class="mini-icon mini-green">
								<img src="{{ asset('images/categories/icons/circle-check-regular-full.svg') }}" alt="check-icon">
							</div>
							<strong>Gratuit</strong>
						</div>
						<span>L'inscription et la demande de devis sont gratuites</span>
					</div>

					<div class="tm-bottom-feature-item">
						<div class="feature-header">
							<div class="mini-icon mini-yellow">
								<img src="{{ asset('images/categories/icons/headset-solid-full.svg') }}" alt="headset-icon">
							</div>
							<strong>Support 7j/7</strong>
						</div>
						<span>Notre équipe vous accompagne à chaque étape</span>
					</div>

					<div class="tm-bottom-feature-item">
						<div class="feature-header">
							<div class="mini-icon mini-purple">
								<img src="{{ asset('images/categories/icons/star-regular.png') }}" alt="star-icon">
							</div>
							<strong>Satisfaction garantie</strong>
						</div>
						<span>Votre satisfaction est notre priorité</span>
					</div>

				</div>

			</div>

		</div>

	</div>
{% endblock %}
