{% extends 'base.html.twig' %}

{% block title %}Notifications - TrouveMoi{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/notifications-premium.css') }}">
{% endblock %}

{% block body %}
    <section class="c-notifications-page">
        <div class="c-notifications-page__container">
            <header class="c-notifications-hero">
                <div class="c-notifications-hero__glow" aria-hidden="true"></div>

                <div class="c-notifications-hero__content">
                    <span class="c-notifications-hero__eyebrow">Centre de notifications</span>
                    <h1 class="c-notifications-hero__title">Notifications</h1>
                    <p class="c-notifications-hero__subtitle">
                        {{ unreadCount }}
                        non lue{{ unreadCount > 1 ? 's' : '' }}
                    </p>
                </div>

                <div class="c-notifications-hero__actions">
                    {% if unreadCount > 0 %}
                        <form method="post" action="{{ path('app_notification_mark_all_read') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('mark-all-notifications-read') }}">
                            <button type="submit" class="c-notifications-btn c-notifications-btn--accent">
                                Tout marquer comme lu
                            </button>
                        </form>
                    {% endif %}

                    {% if notifications is not empty %}
                        <form
                            method="post"
                            action="{{ path('app_notification_delete_all') }}"
                            data-controller="confirm-dialog"
                            data-action="submit->confirm-dialog#confirm"
                            data-confirm-dialog-title-value="Tout supprimer ?"
                            data-confirm-dialog-text-value="Toutes vos notifications seront supprimées."
                            data-confirm-dialog-confirm-button-text-value="Tout supprimer"
                            data-confirm-dialog-cancel-button-text-value="Annuler"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-all-notifications') }}">
                            <button type="submit" class="c-notifications-btn c-notifications-btn--ghost-light">
                                Tout supprimer
                            </button>
                        </form>
                    {% endif %}
                </div>
            </header>

            <div class="c-notifications-panel">
                {% for notification in notifications %}
                    <article class="c-notification-card {{ not notification.isRead ? 'is-unread' : 'is-read' }}">
                        <div class="c-notification-card__accent" aria-hidden="true"></div>

                        <div class="c-notification-card__main">
                            <div class="c-notification-card__meta">
                                <span class="c-notification-card__dot" aria-hidden="true"></span>

                                <div class="c-notification-card__head">
                                    <div class="c-notification-card__title-row">
                                        <h2 class="c-notification-card__title">{{ notification.title }}</h2>

                                        {% if not notification.isRead %}
                                            <span class="c-notification-card__badge">Nouveau</span>
                                        {% endif %}
                                    </div>

                                    <time class="c-notification-card__date">
                                        {{ notification.createdAt|date('d/m/Y H:i') }}
                                    </time>
                                </div>
                            </div>

                            <p class="c-notification-card__body">
                                {{ notification.body }}
                            </p>
                        </div>

                        <div class="c-notification-card__actions">
                            {% if notification.targetUrl %}
                                <a href="{{ notification.targetUrl }}" class="c-notifications-btn c-notifications-btn--secondary">
                                    Ouvrir
                                </a>
                            {% endif %}

                            {% if not notification.isRead %}
                                <form method="post" action="{{ path('app_notification_mark_read', {id: notification.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('mark-notification-read-' ~ notification.id) }}">
                                    <button type="submit" class="c-notifications-btn c-notifications-btn--primary">
                                        Marquer comme lu
                                    </button>
                                </form>
                            {% endif %}

                            <form
                                method="post"
                                action="{{ path('app_notification_delete', {id: notification.id}) }}"
                                data-controller="confirm-dialog"
                                data-action="submit->confirm-dialog#confirm"
                                data-confirm-dialog-title-value="Supprimer cette notification ?"
                                data-confirm-dialog-text-value="Elle sera retirée de votre liste."
                                data-confirm-dialog-confirm-button-text-value="Supprimer"
                                data-confirm-dialog-cancel-button-text-value="Annuler"
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-notification-' ~ notification.id) }}">
                                <button type="submit" class="c-notifications-btn c-notifications-btn--danger-ghost">
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </article>
                {% else %}
                    <div class="c-notifications-empty">
                        <div class="c-notifications-empty__inner">
                            <span class="c-notifications-empty__eyebrow">Boîte propre</span>
                            <h2 class="c-notifications-empty__title">Aucune notification pour le moment</h2>
                            <p class="c-notifications-empty__text">
                                Les nouvelles activités, messages et mises à jour importantes apparaîtront ici.
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% if notifications|length > 0 %}
                <div class="c-notifications-pagination">
                    {{ knp_pagination_render(notifications) }}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
